{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/trust-infrastructure-glossary/schemas/governance-term.schema.json",
  "title": "Trust Infrastructure Glossary Concept Artifact",
  "description": "Schema for v2 governance-executable concept artifacts with language-tagged designations, provenance, semantic relations and assurance metadata.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "concept_id",
    "designations",
    "term",
    "definition",
    "editorial",
    "provenance",
    "governance",
    "assurance",
    "control_plane"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0",
      "description": "Artifact schema major version."
    },
    "concept_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for the concept, independent of any particular designation."
    },
    "designations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Language-tagged labels that designate this concept.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "language",
          "status"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "preferred",
              "alternative",
              "deprecated",
              "discouraged"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "draft",
            "review-needed",
            "stable",
            "deprecated"
          ]
        },
        "reviewed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {
              "type": "boolean"
            },
            "plain_language": {
              "type": "boolean"
            },
            "governance": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "adopted",
            "adapted",
            "locally_defined",
            "mapped"
          ]
        },
        "source_corpus": {
          "type": "string",
          "minLength": 1
        },
        "lineage_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "broader": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "narrower": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "concept_mappings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "close": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "broad": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "narrow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "see_also": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "publisher": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "normative": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "uniqueItems": true
    },
    "simple_definition": {
      "type": "string",
      "minLength": 1
    },
    "reader_note": {
      "type": "string"
    },
    "implementation_relevance": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "governance_profile": {
      "enum": [
        "core-operational",
        "governance-supporting",
        "descriptive"
      ]
    },
    "governance": {
      "type": "object",
      "required": [
        "authority_scope",
        "delegation_mode",
        "revocation_supported",
        "lifecycle_states",
        "execution_role",
        "control_plane_role",
        "enforcement_points"
      ],
      "properties": {
        "authority_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "access_decisioning",
              "assurance_and_audit",
              "credential_issuance",
              "delegation_and_scope",
              "governance_recognition",
              "policy_definition",
              "registry_management",
              "terminology_definition",
              "verification_and_reliance"
            ]
          },
          "uniqueItems": true
        },
        "delegation_mode": {
          "enum": [
            "direct",
            "direct_or_constrained"
          ]
        },
        "revocation_supported": {
          "type": "boolean"
        },
        "lifecycle_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "active",
              "deprecated",
              "documented",
              "proposed",
              "retired",
              "revoked",
              "suspended"
            ]
          },
          "uniqueItems": true
        },
        "execution_role": {
          "enum": [
            "design",
            "hybrid",
            "runtime"
          ]
        },
        "control_plane_role": {
          "enum": [
            "decision_plane_component",
            "reference_term"
          ]
        },
        "enforcement_points": {
          "type": "array",
          "items": {
            "enum": [
              "access_decision",
              "definition_approval",
              "delegation_grant",
              "issuance_decision",
              "policy_approval",
              "registration_decision",
              "reliance_decision",
              "revocation_decision"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "assurance": {
      "type": "object",
      "required": [
        "evidence_artifacts",
        "assurance_level_hint",
        "auditability"
      ],
      "properties": {
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "enum": [
              "access_decision_log",
              "attestation",
              "audit_log",
              "definition_change_record",
              "delegation_record",
              "issuance_log",
              "policy_document",
              "registry_entry",
              "status_record",
              "verification_log"
            ]
          },
          "uniqueItems": true
        },
        "assurance_level_hint": {
          "enum": [
            "informative",
            "AL1+",
            "AL2+"
          ]
        },
        "auditability": {
          "enum": [
            "basic",
            "moderate",
            "high"
          ]
        }
      }
    },
    "control_plane": {
      "type": "object",
      "required": [
        "decision_points",
        "accountable_entity",
        "evidence_produced"
      ],
      "properties": {
        "decision_points": {
          "type": "array",
          "items": {
            "enum": [
              "access_decision",
              "definition_approval",
              "delegation_grant",
              "issuance_decision",
              "policy_approval",
              "registration_decision",
              "reliance_decision",
              "revocation_decision"
            ]
          },
          "uniqueItems": true
        },
        "accountable_entity": {
          "type": "string",
          "minLength": 1
        },
        "evidence_produced": {
          "type": "array",
          "items": {
            "enum": [
              "access_decision_log",
              "attestation",
              "audit_log",
              "definition_change_record",
              "delegation_record",
              "issuance_log",
              "policy_document",
              "registry_entry",
              "status_record",
              "verification_log"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
