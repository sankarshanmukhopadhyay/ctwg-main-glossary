        }
      ],
      "altLabel": [
        {
          "@value": "custodians",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A third party that has been assigned rights and duties in a custodianship arrangement for the purpose of hosting and safeguarding a principal's private keys, digital wallet and digital assets on the principal\u2019s behalf. Depending on the custodianship arrangement, the custodian may act as an exchange and provide additional services, such as staking, lending, account recovery, or security features.",
        "@language": "en"
      },
