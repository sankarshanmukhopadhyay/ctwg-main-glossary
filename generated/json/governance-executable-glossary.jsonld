    {
      "@id": "urn:tig:concept:attribute-based-access-control",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "attribute-based-access-control",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "attribute-based access control",
          "@language": "en"
        },
        {
          "@value": "attribute-based access controls",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "An access control approach in which access is mediated based on attributes associated with subjects (requesters) and the objects to be accessed. Each object and subject has a set of associated attributes, such as location, time of creation, access rights, etc. Access to an object is authorized or denied depending upon whether the required (e.g., policy-defined) correlation can be made between the attributes of that object and of the requesting subject.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:policy",
        "urn:tig:concept:governance-framework",
        "urn:tig:concept:requirement",
        "urn:tig:concept:authorization",
        "urn:tig:concept:permission",
        "urn:tig:concept:role-based-access-control"
      ],
      "exactMatch": [],
      "closeMatch": [],
      "broadMatch": [],
      "narrowMatch": [],
      "relatedMatch": [],
