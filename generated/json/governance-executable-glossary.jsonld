    {
      "@id": "urn:tig:concept:trusted-role",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "trusted-role",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "trusted role",
          "@language": "en"
        },
        {
          "@value": "trusted roles",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A role that performs restricted activities for an organization after meeting competence, security and background verification requirements for that role.",
