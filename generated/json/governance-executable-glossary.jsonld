        },
        {
          "@value": "federated identities",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A digital identity architecture in which a digital identity established on one computer system, network, or trust domain is linked to other computer systems, networks, or trust domains for the purpose of identifying the same entity across those domains.",
