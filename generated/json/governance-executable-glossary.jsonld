    {
      "@id": "urn:tig:concept:federation-assurance-level",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "federation-assurance-level",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "federation assurance level",
          "@language": "en"
        },
        {
          "@value": "federation assurance levels",
          "@language": "en"
        },
        {
          "@value": "FAL",
          "@language": "en"
        },
        {
          "@value": "FALs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A category that describes the federation protocol used to communicate an assertion containing authentication) and attribute information (if applicable) to a relying party, as defined in NIST SP 800-63-3 in terms of three levels: FAL 1 (Some confidence), FAL 2 (High confidence), FAL 3 (Very high confidence).",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:authenticator-assurance-level",
        "urn:tig:concept:identity-assurance-level"
      ],
