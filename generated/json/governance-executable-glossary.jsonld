    {
      "@id": "urn:tig:concept:legitimacy-gap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "legitimacy gap",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "legitimacy-gap",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A mismatch between an action or decision that a system can technically execute and the authority, recognition, consent, or governance basis required for that action to be legitimate.",
        "@language": "en"
      },
