          "@language": "en"
        },
        {
          "@value": "ZKPs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A specific kind of cryptographic proof that proves facts about data to a verifier without revealing the underlying data itself. A common example is proving that a person is over or under a specific age without revealing the person\u2019s exact birthdate.",
        "@language": "en"
      },
