    {
      "@id": "urn:tig:concept:keys-at-the-edge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "keys-at-the-edge",
          "@language": "en"
        }
      ],
      "altLabel": [],
      "definition": {
        "@value": "A key management architecture in which keys are stored on a user\u2019s local edge devices, such as a smartphone, tablet, or laptop, and then used in conjunction with a secure protocol to unlock a key management system (KMS) and/or a digital vault in the cloud. This approach can enable the storage and sharing of large data structures that are not feasible on edge devices. This architecture can also be used in conjunction with confidential computing to enable cloud-based digital agents to safely carry out \u201cuser not present\u201d operations.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:delegation",
        "urn:tig:concept:delegator",
