    {
      "@id": "urn:tig:concept:pseudonym",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "pseudonym",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "pseudonyms",
          "@language": "en"
        },
        {
          "@value": "pseudonymous",
          "@language": "en"
        },
        {
          "@value": "pseudonymity",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A pseudonym is a fictitious name that a person assumes for a particular purpose, which differs from their original or true name (orthonym). This also differs from a new name that entirely or legally replaces an individual's own. Many pseudonym holders use pseudonyms because they wish to remain anonymous, but anonymity is difficult to achieve and often fraught with legal issues.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
