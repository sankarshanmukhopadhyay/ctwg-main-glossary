    {
      "@id": "urn:tig:concept:broadcast-address",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "broadcast-address",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "broadcast address",
          "@language": "en"
        },
        {
          "@value": "broadcast addresses",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A broadcast address is a network address used to transmit to all devices connected to a multiple-access communications network. A message sent to a broadcast address may be received by all network-attached hosts. In contrast, a multicast address is used to address a specific group of devices, and a unicast address is used to address a single device. For network layer communications, a broadcast address may be a specific IP address.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:glossary",
        "urn:tig:concept:definition"
      ],
