    {
      "@id": "urn:tig:concept:legal-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "legal-system",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "legal system",
          "@language": "en"
        },
        {
          "@value": "legal systems",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A system in which policies and rules are defined, and mechanisms for their enforcement and conflict resolution are (implicitly or explicitly) specified. Legal systems are not just defined by governments; they can also be defined by a governance framework.",
        "@language": "en"
      },
