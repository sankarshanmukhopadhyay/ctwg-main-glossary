    {
      "@id": "urn:tig:concept:autonomic-identity-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "autonomic-identity-system",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "autonomic identity system",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "an identity system that includes a primary root-of-trust in self-certifying identifiers that are strongly bound at issuance to a cryptographic signing (public, private) key pair. An AIS enables any entity to establish control over an AN in an independent, interoperable, and portable way.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
