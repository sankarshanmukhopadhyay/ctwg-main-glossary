    {
      "@id": "urn:tig:concept:risk-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "risk-management",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "risk management",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The process of managing risks to organizational operations (including mission, functions, image, or reputation), organizational assets, or individuals resulting from the operation of an information system, and includes: (i) the conduct of a risk assessment; (ii) the implementation of a risk mitigation strategy; and (iii) employment of techniques and procedures for the continuous monitoring of the security state of the information system.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
