    {
      "@id": "urn:tig:concept:end-verifiable",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "end-verifiable",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "end verifiable",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "When a log is _end verifiable_, it means that the log may be verified by any end user that receives a copy. No trust in intervening infrastructure is needed to verify the log and validate the content.",
        "@language": "en"
      },
