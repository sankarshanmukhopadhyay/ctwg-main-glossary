    {
      "@id": "urn:tig:concept:trusted-third-party",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "trusted-third-party",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "trusted third party",
          "@language": "en"
        },
        {
          "@value": "trusted third parties",
          "@language": "en"
        },
        {
          "@value": "trusted 3rd party",
          "@language": "en"
        },
        {
          "@value": "trusted 3rd parties",
          "@language": "en"
        },
        {
          "@value": "TTP",
          "@language": "en"
        },
        {
          "@value": "TTPs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "In cryptography, a trusted third party (TTP) is an entity which facilitates interactions between two parties who both trust the third party; the third party reviews all critical transaction communications between the parties, based on the ease of creating fraudulent digital content. In TTP models, the relying parties use this trust to secure their own interactions. TTPs are common in any number of commercial transactions and in cryptographic digital transactions as well as cryptographic protocols, for example, a certificate authority (CA) would issue a digital certificate to one of two parties. The CA then becomes the TTP to that certificate's issuance. Likewise transactions that need a third party recordation would also need a third-party repository service of some kind.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:verification",
        "urn:tig:concept:verifier",
        "urn:tig:concept:relying-party",
        "urn:tig:concept:trust-decision",
        "urn:tig:concept:governance",
