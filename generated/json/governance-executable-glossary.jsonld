    {
      "@id": "urn:tig:concept:key-management-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "key-management-system",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "key management system",
          "@language": "en"
        },
        {
          "@value": "key management systems",
          "@language": "en"
        },
        {
          "@value": "key management",
          "@language": "en"
        },
        {
          "@value": "KMS",
          "@language": "en"
        },
        {
          "@value": "KMSs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A system for the management of cryptographic keys and their metadata (e.g., generation, distribution, storage, backup, archive, recovery, use, revocation, and destruction). An automated key management system may be used to oversee, automate, and secure the key management process. A key management is often protected by implementing it within the trusted execution environment (TEE) of a device. An example is the Secure Enclave on Apple iOS devices.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:glossary",
