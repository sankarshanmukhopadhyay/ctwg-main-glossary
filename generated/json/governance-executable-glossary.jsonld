          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A use case specified in a governance document that results in specific governance requirements within that governance framework. Governed use cases may optionally be discovered via a trust registry authorized by the relevant governance framework.",
        "@language": "en"
      },
