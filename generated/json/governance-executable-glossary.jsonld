    {
      "@id": "urn:tig:concept:peer-trust-relation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "peer trust relation",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "peer-trust-relation",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A lateral trust relationship between parties that do not hold hierarchical authority over one another and that rely on an explicit trust basis such as credential exchange, policy acceptance, or third-party introduction.",
