    {
      "@id": "urn:tig:concept:uniform-resource-identifier",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "uniform-resource-identifier",
