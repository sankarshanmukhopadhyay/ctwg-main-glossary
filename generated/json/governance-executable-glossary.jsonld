    {
      "@id": "urn:tig:concept:digital-rights-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "digital-rights-management",
