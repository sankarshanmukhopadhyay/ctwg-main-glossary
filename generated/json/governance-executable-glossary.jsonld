      ],
      "altLabel": [
        {
          "@value": "dead drop",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "In cybersecurity or digital privacy scenarios, the term \"dead drop\" refers to encrypted or secure virtual spaces where information can be deposited or retrieved anonymously. In the credentials field, the presenter controls the disclosure, so you can't re-identify the data.",
        "@language": "en"
      },
