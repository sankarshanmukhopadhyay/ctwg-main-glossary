    {
      "@id": "urn:tig:concept:sybil-attack",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "sybil-attack",
