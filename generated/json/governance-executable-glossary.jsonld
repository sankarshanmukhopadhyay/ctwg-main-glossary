          "@language": "en"
        },
        {
          "@value": "hourglass models",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "An architectural model for layered systems\u2014and specifically for the protocol layers in a protocol stack\u2014in which a diversity of supporting protocols and services at the lower layers are able to support a great diversity of protocols and applications at the higher layers through the use of a single protocol in the spanning layer in the middle\u2014the \u201cneck\u201d of the hourglass.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
