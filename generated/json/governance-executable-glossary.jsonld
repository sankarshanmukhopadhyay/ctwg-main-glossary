    {
      "@id": "urn:tig:concept:verifiable-identifier",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "verifiable-identifier",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "verifiable identifier",
          "@language": "en"
        },
        {
          "@value": "verifiable identifiers",
          "@language": "en"
        },
        {
          "@value": "VID",
          "@language": "en"
        },
        {
          "@value": "VIDs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "An identifier over which the controller can provide cryptographic proof of control. Each type of VID defines a specific means for discovering the public key, network endpoints, or other metadata necessary to prove control. Decentralized identifiers (DIDs) are a W3C standard for VIDs. VIDs are the cryptographically verifiable identifiers used in the ToIP stack.",
