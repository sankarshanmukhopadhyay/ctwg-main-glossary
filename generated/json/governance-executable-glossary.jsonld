    {
      "@id": "urn:tig:concept:toip-stack",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "toip-stack",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "ToIP stack",
          "@language": "en"
        },
        {
          "@value": "ToIP stacks",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The layered architecture for decentralized digital trust infrastructure defined by the ToIP Foundation. The ToIP stack is a dual stack consisting of two halves: the ToIP Technology Stack and the ToIP Governance Stack. The four layers in the ToIP stack are ToIP Layer 1, ToIP Layer 2, ToIP Layer 3, and ToIP Layer 4.",
        "@language": "en"
      },
