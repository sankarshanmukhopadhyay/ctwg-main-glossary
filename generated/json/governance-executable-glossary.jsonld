          "@language": "en"
        },
        {
          "@value": "governance frameworks",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A collection of one or more governance documents published by the governing body of a trust community that defines the rules, roles, responsibilities, and decision rights under which that community operates.",
