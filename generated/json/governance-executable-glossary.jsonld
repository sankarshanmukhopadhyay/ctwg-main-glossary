    {
      "@id": "urn:tig:concept:foundational-identity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "foundational-identity",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "foundational identity",
          "@language": "en"
        },
        {
          "@value": "foundational identities",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A set of identity data, such as a credential, issued by an authoritative source for the legal identity of the subject. Birth certificates, passports, driving licenses, and other forms of government ID documents are considered foundational identity documents. Foundational identities are often used to provide identity binding for functional identities.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
