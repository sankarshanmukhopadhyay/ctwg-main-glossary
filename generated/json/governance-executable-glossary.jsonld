    {
      "@id": "urn:tig:concept:autonomic-namespace",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "autonomic-namespace",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "autonomic namespace",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "a namespace that is self-certifying and hence self-administrating. An AN has a self-certifying prefix that provides cryptographic verification of root control authority over its namespace. All derived AIDs in the same AN share the same root-of-trust, source-of-truth, and locus-of-control (RSL). The governance of the namespace is, therefore, unified into one entity, that is, the controller who is/holds the root authority over the namespace.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:governance",
        "urn:tig:concept:governance-framework",
