    {
      "@id": "urn:tig:concept:trust",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "trust",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "trusts",
          "@language": "en"
        },
        {
          "@value": "trusted",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A belief that an entity will behave in a predictable manner in specified circumstances. The entity may be a person, process, object or any combination of such components. The entity can be of any size from a single hardware component or software module, to a piece of equipment identified by make and model, to a site or location, to an organization, to a nation-state. Trust, while inherently a subjective determination, can be based on objective evidence and subjective elements. The objective grounds for trust can include for example, the results of information technology product testing and evaluation. Subjective belief, level of comfort, and experience may supplement (or even replace) objective evidence, or substitute for such evidence when it is unavailable. Trust is usually relative to a specific circumstance or situation (e.g., the amount of money involved in a transaction, the sensitivity or criticality of information, or whether safety is an issue with human lives at stake). Trust is generally not transitive (e.g., you trust a friend but not necessarily a friend of a friend). Finally, trust is generally earned, based on experience or measurement.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:trust-decision",
        "urn:tig:concept:transitive-trust-decision"
      ],
      "exactMatch": [],
      "closeMatch": [],
      "broadMatch": [],
      "narrowMatch": [],
      "relatedMatch": [],
      "tig:editorial": {
        "status": "stable",
        "reviewed": {
          "domain": true,
          "plain_language": false,
          "governance": true
        }
      },
      "tig:provenance": {
        "classification": "locally_defined",
        "source_corpus": "Trust Infrastructure Glossary",
        "lineage_note": "Migrated from the pre-v2 independent corpus; existing source citations are retained as provenance evidence."
      },
