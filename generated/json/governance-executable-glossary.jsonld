    {
      "@id": "urn:tig:concept:zero-trust-architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "zero-trust-architecture",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "zero-trust architecture",
          "@language": "en"
        },
        {
          "@value": "zero-trust architectures",
          "@language": "en"
        },
        {
          "@value": "ZTA",
          "@language": "en"
        },
        {
          "@value": "ZTAs",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A network security architecture based on the core design principle \u201cnever trust, always verify\u201d, so that all actors are denied access to resources pending verification.",
        "@language": "en"
      },
