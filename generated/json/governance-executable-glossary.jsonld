      "@id": "urn:tig:concept:mobile-deep-link",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "mobile-deep-link",
