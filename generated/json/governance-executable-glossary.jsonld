    {
      "@id": "urn:tig:concept:holder",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "holder",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "holders",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A role an agent performs by serving as the controller of the cryptographic keys and digital credentials in a digital wallet. The holder makes issuance requests for credentials and responds to presentation requests for credentials. A holder is usually, but not always, a subject of the credentials they are holding.",
        "@language": "en"
      },
