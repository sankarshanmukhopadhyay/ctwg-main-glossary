    {
      "@id": "urn:tig:concept:cryptographic-key",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "cryptographic-key",
