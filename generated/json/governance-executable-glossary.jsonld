    {
      "@id": "urn:tig:concept:end-to-end-encryption",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "end-to-end-encryption",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "end-to-end encryption",
          "@language": "en"
        },
        {
          "@value": "end-to-end encrypt",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "Encryption that is applied to a communication before it is transmitted from the sender\u2019s communication endpoint and cannot be decrypted until after it is received at the receiver\u2019s communication endpoint. When end-to-end encryption is used, the communication cannot be decrypted in transit no matter how many intermediaries are involved in the routing process.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:glossary",
        "urn:tig:concept:definition"
