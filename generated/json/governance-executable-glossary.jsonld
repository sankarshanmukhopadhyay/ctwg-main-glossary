      },
      "prefLabel": [
        {
          "@value": "zero-knowledge-service-provider",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "zero-knowledge service provider",
          "@language": "en"
        },
        {
          "@value": "zero-knowledge service providers",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The provider of a zero-knowledge service that hosts encrypted data on behalf of the principal but does not have access to the private keys in order to be able to decrypt it.",
        "@language": "en"
      },
