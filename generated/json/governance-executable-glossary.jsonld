    {
      "@id": "urn:tig:concept:multi-party-control",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "multi-party-control",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "multi-party control",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "A variant of multi-party computation where multiple parties must act in concert to meet a control requirement without revealing each other\u2019s data. All parties are privy to the output of the control, but no party learns anything about the others.",
        "@language": "en"
      },
