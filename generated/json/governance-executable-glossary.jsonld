    {
      "@id": "urn:tig:concept:node",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "node",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "nodes",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "In telecommunications networks, a node (Latin: nodus, \u2018knot\u2019) is either a redistribution point or a communication endpoint. The definition of a node depends on the network and protocol layer referred to. A physical network node is an electronic device that is attached to a network, and is capable of creating, receiving, or transmitting information over a communication channel.",
        "@language": "en"
      },
