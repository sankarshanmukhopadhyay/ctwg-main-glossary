    {
      "@id": "urn:tig:concept:end-to-end-principle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "urn:tig:scheme:core"
      },
      "prefLabel": [
        {
          "@value": "end-to-end-principle",
          "@language": "en"
        }
      ],
      "altLabel": [
        {
          "@value": "End-to-End Principle",
          "@language": "en"
        }
      ],
      "definition": {
        "@value": "The end-to-end principle is a design framework in computer networking. In networks designed according to this principle, guaranteeing certain application-specific features, such as reliability and security, requires that they reside in the communicating end nodes of the network. Intermediary nodes, such as gateways and routers, that exist to establish the network, may implement these to improve efficiency but cannot guarantee end-to-end correctness.",
        "@language": "en"
      },
      "broader": [],
      "narrower": [],
      "related": [
        "urn:tig:concept:policy",
        "urn:tig:concept:governance-framework",
        "urn:tig:concept:requirement"
      ],
