@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tig: <https://sankarshanmukhopadhyay.github.io/trust-infrastructure-glossary/ns#> .

<urn:tig:scheme:core> a skos:ConceptScheme ;
  skos:prefLabel "Trust Infrastructure Glossary"@en .

<urn:tig:concept:aal> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "aal"@en ;
  skos:altLabel "AAL"@en ;
  skos:definition "See: authenticator assurance level."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:abac> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "abac"@en ;
  skos:altLabel "ABAC"@en ;
  skos:definition "See: attribute-based access control."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:acceptance-network> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "acceptance-network"@en ;
  skos:altLabel "acceptance network"@en ;
  skos:definition "A trust network designed to facilitate acceptance of verifiable data for its members."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:acceptance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "acceptance"@en ;
  skos:altLabel "accept"@en ;
  skos:altLabel "accepts"@en ;
  skos:definition "The action of a party receiving any form of verifiable data and using it to make a trust decision."@en ;
  skos:related <urn:tig:concept:acceptance-network> .

<urn:tig:concept:access-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "access-control"@en ;
  skos:altLabel "access control"@en ;
  skos:altLabel "access controls"@en ;
  skos:definition "The process of granting or denying specific requests for obtaining and using information and related information processing services."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:accreditation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "accreditation"@en ;
  skos:altLabel "accredit"@en ;
  skos:altLabel "accredited"@en ;
  skos:definition "Formal declaration by an accrediting authority that an information system is approved to operate at an acceptable level of risk, based on the implementation of an approved set of technical, managerial, and procedural safeguards."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:acdc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "acdc"@en ;
  skos:altLabel "ACDC"@en ;
  skos:altLabel "ACDCs"@en ;
  skos:definition "See: Authentic Chained Data Container."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:action> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "action"@en ;
  skos:altLabel "actions"@en ;
  skos:altLabel "act"@en ;
  skos:altLabel "acts"@en ;
  skos:definition "Something that is actually done (a 'unit of work' that is executed) by a single actor (on behalf of a given party), as a single operation, in a specific context."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:actor> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "actor"@en ;
  skos:altLabel "actors"@en ;
  skos:definition "An entity that can act (do things/execute actions), e.g. people, machines, but not organizations. A digital agent can serve as an actor acting on behalf of its principal."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "address"@en ;
  skos:altLabel "addresses"@en ;
  skos:altLabel "addressing"@en ;
  skos:definition "See: network address."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:administering-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "administering-authority"@en ;
  skos:altLabel "administering authority"@en ;
  skos:altLabel "administering authorities"@en ;
  skos:definition "See: administering body."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:administering-body> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "administering-body"@en ;
  skos:altLabel "administering body"@en ;
  skos:altLabel "administering bodies"@en ;
  skos:definition "A legal entity delegated by a governing body to administer the operation of a governance framework and governed infrastructure for a digital trust ecosystem, such as one or more trust registries."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> .

<urn:tig:concept:agency> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "agency"@en ;
  skos:definition "In the context of decentralized digital trust infrastructure, the empowering of a party to act independently of its own accord, and in particular to empower the party to employ an agent to act on the party's behalf."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:agent-class> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "agent class"@en ;
  skos:altLabel "agent-class"@en ;
  skos:definition "A typed descriptor for the operating posture of an agentic actor, used to distinguish the kind of role the agent performs from the controls governing how it operates."@en ;
  skos:related <urn:tig:concept:agent> ;
  skos:related <urn:tig:concept:role> .

<urn:tig:concept:agent-mandate-envelope> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "agent mandate envelope"@en ;
  skos:altLabel "agent-mandate-envelope"@en ;
  skos:definition "A structured artifact that binds an agent to an originating principal, delegated mandate, permitted scope, conditions, expiry, revocation semantics, and evidence requirements."@en ;
  skos:related <urn:tig:concept:agent> ;
  skos:related <urn:tig:concept:authority> .

<urn:tig:concept:agent-registry> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "agent registry"@en ;
  skos:altLabel "agent-registry"@en ;
  skos:definition "A registry that publishes and manages governed information about agents, including identity, authority, delegation, recognition, lifecycle state, and supporting evidence."@en ;
  skos:related <urn:tig:concept:agent> ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:delegation> .

<urn:tig:concept:agent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "agent"@en ;
  skos:altLabel "agents"@en ;
  skos:definition "An actor that executes an action on behalf of a party (called the principal of that actor). In the context of decentralized digital trust infrastructure, the term “agent” is most frequently used to mean a digital agent."@en ;
  skos:related <urn:tig:concept:wallet> .

<urn:tig:concept:aggregation-amplification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "aggregation amplification"@en ;
  skos:altLabel "aggregation-amplification"@en ;
  skos:definition "A delegation failure mode in which individually valid and attenuated authority branches combine to produce an effect broader than the originating mandate permits."@en ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:scope> .

<urn:tig:concept:aid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "aid"@en ;
  skos:altLabel "AID"@en ;
  skos:definition "See autonomic-identifier."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:anonymous> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "anonymous"@en ;
  skos:definition "An adjective describing when the identity of a natural person or other actor is unknown."@en ;
  skos:related <urn:tig:concept:pseudonym> .

<urn:tig:concept:anycast-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "anycast-address"@en ;
  skos:altLabel "anycast address"@en ;
  skos:altLabel "anycast addresses"@en ;
  skos:definition "A network address (especially an IP address used for anycast routing of network transmissions."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:anycast> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "anycast"@en ;
  skos:definition "Anycast is a network addressing and routing methodology in which a single IP-address is shared by devices (generally servers) in multiple locations. Routers direct packets addressed to this destination to the location nearest the sender, using their normal decision-making algorithms, typically the lowest number of BGP network hops. Anycast routing is widely used by content delivery networks such as web and name servers, to bring their content closer to end users."@en ;
  skos:related <urn:tig:concept:broadcast> ;
  skos:related <urn:tig:concept:multicast> ;
  skos:related <urn:tig:concept:unicast> .

<urn:tig:concept:appraisability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "appraisability"@en ;
  skos:altLabel "appraisable"@en ;
  skos:altLabel "appraise"@en ;
  skos:definition "The ability for a communication endpoint identified with a verifiable identifier (VID) to be appraised for the set of its properties that enable a relying party or a verifier to make a trust decision about communicating with that endpoint."@en ;
  skos:related <urn:tig:concept:trust-basis> ;
  skos:related <urn:tig:concept:verifiability> .

<urn:tig:concept:appropriate-friction> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "appropriate-friction"@en ;
  skos:altLabel "appropriate friction"@en ;
  skos:definition "A user-experience design principle for information systems (such as digital wallets) specifying that the level of attention required of the holder for a particular transaction should provide a reasonable opportunity for an informed choice by the holder."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:assurance-boundary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "assurance boundary"@en ;
  skos:altLabel "assurance-boundary"@en ;
  skos:definition "The explicit limit of what an assurance claim, test result, evidence set, or implementation can reasonably support."@en ;
  skos:related <urn:tig:concept:assurance-level> ;
  skos:related <urn:tig:concept:evidence-bundle> .

<urn:tig:concept:assurance-level> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "assurance-level"@en ;
  skos:altLabel "assurance level"@en ;
  skos:altLabel "assurance levels"@en ;
  skos:definition "A level of confidence in a claim that may be relied on by others. Different types of assurance levels are defined for different types of trust assurance mechanisms. Examples include authenticator assurance level, federation assurance level, and identity assurance level."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> .

<urn:tig:concept:attention-policy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "attention policy"@en ;
  skos:altLabel "attention-policy"@en ;
  skos:definition "A policy that governs how inbound signals are admitted, deferred, summarized, rerouted, escalated, or rejected before reaching a principal or downstream decision layer."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:agent> .

<urn:tig:concept:attestation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "attestation"@en ;
  skos:altLabel "attestations"@en ;
  skos:definition "The issue of a statement, based on a decision, that fulfillment of specified requirements has been demonstrated. In the context of decentralized digital trust infrastructure, an attestation usually has a digital signature so that it is cryptographically verifiable."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:attribute-based-access-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "attribute-based-access-control"@en ;
  skos:altLabel "attribute-based access control"@en ;
  skos:altLabel "attribute-based access controls"@en ;
  skos:definition "An access control approach in which access is mediated based on attributes associated with subjects (requesters) and the objects to be accessed. Each object and subject has a set of associated attributes, such as location, time of creation, access rights, etc. Access to an object is authorized or denied depending upon whether the required (e.g., policy-defined) correlation can be made between the attributes of that object and of the requesting subject."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> .

<urn:tig:concept:attribute> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "attribute"@en ;
  skos:altLabel "attributes"@en ;
  skos:definition "An identifiable set of data that describes an entity, which is the subject of the attribute."@en ;
  skos:related <urn:tig:concept:property> .

<urn:tig:concept:attributional-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "attributional-trust"@en ;
  skos:altLabel "attributional trust"@en ;
  skos:definition "KERI offers cryptographic root-of-trust to establish attributional trust. In the real world you'd also need reputational-trust. You can't have reputation without attributional trust."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:audit-log> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "audit-log"@en ;
  skos:altLabel "audit log"@en ;
  skos:altLabel "audit logs"@en ;
  skos:definition "An audit log is a security-relevant chronological record, set of records, and/or destination and source of records that provide documentary evidence of the sequence of activities that have affected at any time a specific operation, procedure, event, or device."@en ;
  skos:related <urn:tig:concept:key-event-log> .

<urn:tig:concept:audit> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "audit"@en ;
  skos:altLabel "audits"@en ;
  skos:definition "Independent review and examination of records and activities to assess the adequacy of system controls, to ensure compliance with established policies and operational procedures."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:auditor> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "auditor"@en ;
  skos:altLabel "auditors"@en ;
  skos:definition "The party responsible for performing an audit. Typically an auditor must be accredited."@en ;
  skos:related <urn:tig:concept:human-auditable> .

<urn:tig:concept:authentic-chained-data-container> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authentic-chained-data-container"@en ;
  skos:altLabel "Authentic Chained Data Container"@en ;
  skos:definition "A digital data structure designed for both cryptographic verification and chaining of data containers. ACDC may be used for digital credentials."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:authentic-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authentic-data"@en ;
  skos:altLabel "Authentic data"@en ;
  skos:altLabel "authentic data"@en ;
  skos:definition "integrity and [[xref:toip2, provenance]]'d data."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:authentication> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authentication"@en ;
  skos:altLabel "authenticate"@en ;
  skos:altLabel "authenticates"@en ;
  skos:altLabel "authenticated"@en ;
  skos:altLabel "authenticating"@en ;
  skos:definition "Verifying the identity of a user, process, or device, often as a prerequisite to allowing access to resources in an information system."@en ;
  skos:related <urn:tig:concept:authenticator> ;
  skos:related <urn:tig:concept:verifiable-message> .

<urn:tig:concept:authenticator-assurance-level> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authenticator-assurance-level"@en ;
  skos:altLabel "authenticator assurance level"@en ;
  skos:altLabel "authenticator assurance levels"@en ;
  skos:altLabel "AAL"@en ;
  skos:altLabel "AALs"@en ;
  skos:definition "A measure of the strength of an authentication mechanism and, therefore, the confidence in it."@en ;
  skos:related <urn:tig:concept:federation-assurance-level> ;
  skos:related <urn:tig:concept:identity-assurance-level> ;
  skos:related <urn:tig:concept:identity-binding> .

<urn:tig:concept:authenticator> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authenticator"@en ;
  skos:definition "Something the claimant possesses and controls (typically a cryptographic module or password) that is used to authenticate the claimant’s identity."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> .

<urn:tig:concept:authenticity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authenticity"@en ;
  skos:altLabel "authentic"@en ;
  skos:definition "The property of being genuine and being able to be verified and trusted; confidence in the validity of a transmission, a message, or message originator."@en ;
  skos:related <urn:tig:concept:confidentiality> ;
  skos:related <urn:tig:concept:correlation-privacy> ;
  skos:related <urn:tig:concept:cryptographic-verifiability> .

<urn:tig:concept:authoritative-source> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authoritative-source"@en ;
  skos:altLabel "authoritative source"@en ;
  skos:altLabel "authoritative sources"@en ;
  skos:definition "A source of information that a relying party considers to be authoritative for that information. In ToIP architecture, the trust registry authorized by the governance framework for a trust community is typically considered an authoritative source by the members of that trust community. A system of record is an authoritative source for the data records it holds. A trust anchor is an authoritative source for the beginning of a trust chain."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:authoritative> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authoritative"@en ;
  skos:definition "Information or data that comes from an authority for that information."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:authority-boundary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authority boundary"@en ;
  skos:altLabel "authority-boundary"@en ;
  skos:definition "A machine- or human-readable constraint that identifies where authority begins and ends, including the permitted actor, scope, action, target, conditions, and lifecycle state."@en ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:scope> ;
  skos:related <urn:tig:concept:trust-boundary> .

<urn:tig:concept:authority-control-plane> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authority control plane"@en ;
  skos:altLabel "authority-control-plane"@en ;
  skos:definition "The set of governance and runtime mechanisms that determine who may act, under whose authority, within what scope, and with what lifecycle and enforcement conditions."@en ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:control-plane-shift> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authority"@en ;
  skos:altLabel "authorities"@en ;
  skos:definition "A party whose decisions, policies, rules, or recognition outcomes are accepted as governing, directive, or controlling by other parties within a defined scope."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> .

<urn:tig:concept:authorization-checkpoint> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authorization checkpoint"@en ;
  skos:altLabel "authorization-checkpoint"@en ;
  skos:definition "A runtime trust event that pauses or interrupts an interaction because required authorization, scope, evidence, or input is absent or insufficient."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:authorization-graph> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authorization-graph"@en ;
  skos:altLabel "authorization graph"@en ;
  skos:definition "A graph of the authorization relationships between different entities in a trust-community. In a digital trust ecosystem, the governing body is typically the trust root of an authorization graph. In some cases, an authorization graph can be traversed by making queries to one or more trust registries."@en ;
  skos:related <urn:tig:concept:governance-graph> ;
  skos:related <urn:tig:concept:reputation-graph> ;
  skos:related <urn:tig:concept:trust-graph> .

<urn:tig:concept:authorization> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authorization"@en ;
  skos:altLabel "authorizations"@en ;
  skos:altLabel "authorize"@en ;
  skos:altLabel "authorized"@en ;
  skos:altLabel "unauthorized"@en ;
  skos:altLabel "authorizing"@en ;
  skos:altLabel "unauthorizing"@en ;
  skos:altLabel "authorisation"@en ;
  skos:altLabel "authorisations"@en ;
  skos:altLabel "authorise"@en ;
  skos:altLabel "authorised"@en ;
  skos:altLabel "unauthorised"@en ;
  skos:altLabel "authorising"@en ;
  skos:altLabel "unauthorising"@en ;
  skos:definition "The process of determining whether a requested action or service is approved for a specific entity under applicable policies, rules, credentials, or other governing criteria."@en ;
  skos:related <urn:tig:concept:permission> .

<urn:tig:concept:authorized-organizational-representative> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "authorized-organizational-representative"@en ;
  skos:altLabel "authorized organizational representative"@en ;
  skos:definition "A person who has the authority to make claims, sign documents or otherwise commit resources on behalf of an organization."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> .

<urn:tig:concept:autonomic-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "autonomic-identifier"@en ;
  skos:altLabel "autonomic identifier"@en ;
  skos:altLabel "autonomic identifiers"@en ;
  skos:definition "The specific type of self-certifying identifier defined by the KERI specifications: [[xref:keri1, autonomic-identifier]]."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:autonomic-identity-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "autonomic-identity-system"@en ;
  skos:altLabel "autonomic identity system"@en ;
  skos:definition "an identity system that includes a primary root-of-trust in self-certifying identifiers that are strongly bound at issuance to a cryptographic signing (public, private) key pair. An AIS enables any entity to establish control over an AN in an independent, interoperable, and portable way."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:autonomic-namespace> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "autonomic-namespace"@en ;
  skos:altLabel "autonomic namespace"@en ;
  skos:definition "a namespace that is self-certifying and hence self-administrating. An AN has a self-certifying prefix that provides cryptographic verification of root control authority over its namespace. All derived AIDs in the same AN share the same root-of-trust, source-of-truth, and locus-of-control (RSL). The governance of the namespace is, therefore, unified into one entity, that is, the controller who is/holds the root authority over the namespace."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:binding> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "binding"@en ;
  skos:definition "The technique of connecting two data elements together. In the context of key-event-receipt-infrastructure it's the association of data or an identifier with another identifier or a subject (a person, organization or machine), thereby lifting the privacy of the subject through that connection, i.e. **binding**."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:biometric> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "biometric"@en ;
  skos:altLabel "biometrics"@en ;
  skos:definition "A measurable physical characteristic or personal behavioral trait used to recognize the AID, or verify the claimed identity, of an applicant. Facial images, fingerprints, and iris scan samples are all examples of biometrics."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:bitstring-status-list> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "bitstring-status-list"@en ;
  skos:altLabel "Bitstring Status List"@en ;
  skos:altLabel "BSL"@en ;
  skos:definition "A W3C status mechanism for publishing credential status information such as revocation or suspension using compressed bitstrings."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:status-record> .

<urn:tig:concept:blockchain> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "blockchain"@en ;
  skos:altLabel "blockchains"@en ;
  skos:definition "A distributed ledger of cryptographically-signed transactions that are grouped into blocks. Each block is cryptographically linked to the previous one (making it tamper evident) after validation and undergoing a consensus decision. As new blocks are added, older blocks become more difficult to modify (creating tamper resistance). New blocks are replicated across copies of the ledger within the network, and any conflicts are resolved automatically using established rules."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> .

<urn:tig:concept:bola> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "bola"@en ;
  skos:altLabel "BOLA"@en ;
  skos:definition "See broken-object-level-authorization"@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:broadcast-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "broadcast-address"@en ;
  skos:altLabel "broadcast address"@en ;
  skos:altLabel "broadcast addresses"@en ;
  skos:definition "A broadcast address is a network address used to transmit to all devices connected to a multiple-access communications network. A message sent to a broadcast address may be received by all network-attached hosts. In contrast, a multicast address is used to address a specific group of devices, and a unicast address is used to address a single device. For network layer communications, a broadcast address may be a specific IP address."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:broadcast> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "broadcast"@en ;
  skos:definition "In computer networking, telecommunication and information theory, broadcasting is a method of transferring a message to all recipients simultaneously. Broadcast delivers a message to all nodes in the network using a one-to-all association; a single datagram (or packet) from one sender is routed to all of the possibly multiple endpoints associated with the broadcast address. The network automatically replicates datagrams as needed to reach all the recipients within the scope of the broadcast, which is generally an entire network subnet."@en ;
  skos:related <urn:tig:concept:anycast> ;
  skos:related <urn:tig:concept:multicast> ;
  skos:related <urn:tig:concept:unicast> .

<urn:tig:concept:broken-object-level-authorization> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "broken-object-level-authorization"@en ;
  skos:altLabel "broken object level authorization"@en ;
  skos:definition "Refers to security flaws where users can access data they shouldn't, due to inadequate permission checks on individual (sub)objects."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:c2pa-manifest> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "c2pa-manifest"@en ;
  skos:altLabel "C2PA Manifest"@en ;
  skos:definition "A verifiable unit of C2PA provenance information that binds claims, assertions, content bindings, and signatures for an asset."@en ;
  skos:related <urn:tig:concept:c2pa> ;
  skos:related <urn:tig:concept:content-credential> ;
  skos:related <urn:tig:concept:claim-generator> ;
  skos:related <urn:tig:concept:digital-signature> ;
  skos:related <urn:tig:concept:provenance> .

<urn:tig:concept:c2pa> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "c2pa"@en ;
  skos:altLabel "C2PA"@en ;
  skos:definition "See: Coalition for Content Provenance and Authenticity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:ca> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ca"@en ;
  skos:altLabel "CA"@en ;
  skos:altLabel "CAs"@en ;
  skos:definition "See: certificate authority."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:cai> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cai"@en ;
  skos:altLabel "CAI"@en ;
  skos:definition "See: Content Authenticity Initiative."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:capability-negotiation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "capability negotiation"@en ;
  skos:altLabel "capability-negotiation"@en ;
  skos:definition "A governed process for determining whether an advertised capability is discoverable, compatible, authorized, accepted, and permitted to execute under applicable policy."@en ;
  skos:related <urn:tig:concept:capability> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:capability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "capability"@en ;
  skos:altLabel "capabilities"@en ;
  skos:definition "The ability or permission for an actor or agent to perform a specific action on behalf of a party within a defined scope and subject to applicable constraints."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> .

<urn:tig:concept:certificate-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "certificate-authority"@en ;
  skos:altLabel "certificate authority"@en ;
  skos:altLabel "certificate authorities"@en ;
  skos:definition "The entity in a public key infrastructure (PKI) that is responsible for issuing public key certificates and exacting compliance to a PKI policy."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:certificate> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "certificate"@en ;
  skos:altLabel "certificates"@en ;
  skos:definition "See: public key certificate."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:certification-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "certification-authority"@en ;
  skos:altLabel "certification authority"@en ;
  skos:altLabel "certification authorities"@en ;
  skos:definition "See: certificate authority."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:certification-body> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "certification-body"@en ;
  skos:altLabel "certification body"@en ;
  skos:altLabel "certification bodies"@en ;
  skos:definition "A legal entity that performs certification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:certification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "certification"@en ;
  skos:altLabel "certifications"@en ;
  skos:definition "A comprehensive assessment of the management, operational, and technical security controls in an information system, made in support of security accreditation, to determine the extent to which the controls are implemented correctly, operating as intended, and producing the desired outcome with respect to meeting the security requirements for the system."@en ;
  skos:related <urn:tig:concept:accreditation> .

<urn:tig:concept:chain-of-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "chain-of-trust"@en ;
  skos:altLabel "chain of trust"@en ;
  skos:altLabel "chains of trust"@en ;
  skos:definition "See: trust chain."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:chained-credentials> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "chained-credentials"@en ;
  skos:altLabel "chained credentials"@en ;
  skos:definition "Two or more credentials linked together to create a trust chain between the credentials that is cryptographically verifiable."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:chaining> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "chaining"@en ;
  skos:definition "See: trust chain."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:channel> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "channel"@en ;
  skos:altLabel "channels"@en ;
  skos:definition "See: communication channel."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:ciphertext> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ciphertext"@en ;
  skos:altLabel "ciphertexts"@en ;
  skos:definition "Encrypted (enciphered) data. The confidential form of the plaintext that is the output of the encryption function."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:claim-generator> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "claim-generator"@en ;
  skos:altLabel "C2PA claim generator"@en ;
  skos:altLabel "claim generator"@en ;
  skos:definition "A hardware or software actor that creates a C2PA claim about an asset and signs or causes the signing of the associated manifest data."@en ;
  skos:related <urn:tig:concept:c2pa-manifest> ;
  skos:related <urn:tig:concept:content-credential> ;
  skos:related <urn:tig:concept:actor> ;
  skos:related <urn:tig:concept:digital-signature> .

<urn:tig:concept:claim> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "claim"@en ;
  skos:altLabel "claims"@en ;
  skos:altLabel "claimed"@en ;
  skos:altLabel "claiming"@en ;
  skos:definition "An assertion about a subject, typically expressed as an attribute or property of the subject. It is called a “claim” because the assertion is always made by some party, called the issuer of the claim, and the validity of the claim must be judged by the verifier."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:coalition-for-content-provenance-and-authenticity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "coalition-for-content-provenance-and-authenticity"@en ;
  skos:altLabel "Coalition for Content Provenance and Authenticity"@en ;
  skos:definition "C2PA is a Joint Development Foundation project of the Linux Foundation that addresses the prevalence of misleading information online through the development of technical standards for certifying the source and history (or provenance) of media content."@en ;
  skos:related <urn:tig:concept:content-authenticity-initiative> .

<urn:tig:concept:collective-signature> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "collective-signature"@en ;
  skos:altLabel "collective signature"@en ;
  skos:definition "a group signature scheme, that (i) is shared by a set of signing groups and (ii) combined collective signature shared by several signing groups and several individual signers. The protocol of the first type is constructed and described in detail. It is possible to modify the described protocol which allows transforming the protocol of the first type into the protocol of the second type. The proposed collective signature protocols have significant merits, one of which is connected with possibility of their practical using on the base of the existing public key infrastructures."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:communication-channel> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "communication-channel"@en ;
  skos:altLabel "communication channel"@en ;
  skos:altLabel "communication channels"@en ;
  skos:definition "A communication channel refers either to a physical transmission medium such as a wire, or to a logical connection over a multiplexed medium such as a radio channel in telecommunications and computer networking. A channel is used for information transfer of, for example, a digital bit stream, from one or several senders to one or several receivers."@en ;
  skos:related <urn:tig:concept:toip-channel> .

<urn:tig:concept:communication-endpoint> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "communication-endpoint"@en ;
  skos:altLabel "communication endpoint"@en ;
  skos:altLabel "communication endpoints"@en ;
  skos:altLabel "communications endpoint"@en ;
  skos:altLabel "communications endpoints"@en ;
  skos:definition "A type of communication network node. It is an interface exposed by a communicating party or by a communication channel. An example of the latter type of a communication endpoint is a publish-subscribe topic or a group in group communication systems."@en ;
  skos:related <urn:tig:concept:toip-endpoint> .

<urn:tig:concept:communication-metadata> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "communication-metadata"@en ;
  skos:altLabel "communication metadata"@en ;
  skos:altLabel "communications metadata"@en ;
  skos:definition "Metadata that describes the sender, receiver, routing, handling, or contents of a communication. Communication metadata is often observable even if the contents of the communication are encrypted."@en ;
  skos:related <urn:tig:concept:correlation-privacy> .

<urn:tig:concept:communication-session> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "communication-session"@en ;
  skos:altLabel "communication session"@en ;
  skos:altLabel "communication sessions"@en ;
  skos:altLabel "communications session"@en ;
  skos:altLabel "communications sessions"@en ;
  skos:definition "A finite period for which a communication channel is instantiated and maintained, during which certain properties of that channel, such as authentication of the participants, are in effect. A session has a beginning, called the session initiation, and an ending, called the session termination."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:communication> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "communication"@en ;
  skos:altLabel "communications"@en ;
  skos:definition "The transmission of information."@en ;
  skos:related <urn:tig:concept:toip-communication> .

<urn:tig:concept:complex-password> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "complex-password"@en ;
  skos:altLabel "complex password"@en ;
  skos:altLabel "complex passwords"@en ;
  skos:definition "A password that meets certain security requirements, such as minimum length, inclusion of different character types, non-repetition of characters, and so on."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:compliance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "compliance"@en ;
  skos:altLabel "comply"@en ;
  skos:altLabel "complies"@en ;
  skos:altLabel "complied"@en ;
  skos:altLabel "complying"@en ;
  skos:altLabel "compliant"@en ;
  skos:definition "In the context of decentralized digital trust infrastructure, compliance is the extent to which a system, actor, or party conforms to the requirements of a regulation, governance framework, or trust framework that pertains to that particular entity."@en ;
  skos:related <urn:tig:concept:governance-risk-management-compliance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:trust-framework> .

<urn:tig:concept:concept> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "concept"@en ;
  skos:altLabel "concepts"@en ;
  skos:definition "An abstract idea that enables the classification of entities, i.e., a mental construct that enables an instance of a class of entities to be distinguished from entities that are not an instance of that class. A concept can be identified with a term."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:confidential-computing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "confidential-computing"@en ;
  skos:altLabel "confidential computing"@en ;
  skos:definition "Hardware-enabled features that isolate and process encrypted data in memory so that the data is at less risk of exposure and compromise from concurrent workloads or the underlying system and platform."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:confidentiality> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "confidentiality"@en ;
  skos:altLabel "confidential"@en ;
  skos:definition "In a communications context, a type of privacy protection in which messages use encryption or other privacy-preserving technologies so that only authorized parties have access."@en ;
  skos:related <urn:tig:concept:authenticity> ;
  skos:related <urn:tig:concept:correlation-privacy> .

<urn:tig:concept:conformance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "conformance"@en ;
  skos:definition "The degree to which an implementation, process, or artifact satisfies a defined set of requirements."@en ;
  skos:related <urn:tig:concept:compliance> ;
  skos:related <urn:tig:concept:assurance-level> .

<urn:tig:concept:connection> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "connection"@en ;
  skos:altLabel "connections"@en ;
  skos:definition "A communication channel established between two communication endpoints. A connection may be ephemeral or persistent."@en ;
  skos:related <urn:tig:concept:toip-connection> .

<urn:tig:concept:consent-management> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "consent-management"@en ;
  skos:altLabel "consent management"@en ;
  skos:definition "A system, process or set of policies under which a person agrees to share personal data for specific usages. A consent management system will typically create a record of such consent."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:content-authenticity-initiative> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "content-authenticity-initiative"@en ;
  skos:altLabel "Content Authenticity Initiative"@en ;
  skos:definition "The Content Authenticity Initiative (CAI) is an association founded in November 2019 by Adobe, the New York Times and Twitter. The CAI promotes an industry standard for provenance metadata defined by the C2PA. The CAI cites curbing disinformation as one motivation for its activities."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:content-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "content-credential"@en ;
  skos:altLabel "Content Credential"@en ;
  skos:altLabel "Content Credentials"@en ;
  skos:definition "The user-facing C2PA term for provenance information represented by C2PA manifests associated with an asset."@en ;
  skos:related <urn:tig:concept:c2pa> ;
  skos:related <urn:tig:concept:c2pa-manifest> ;
  skos:related <urn:tig:concept:provenance> ;
  skos:related <urn:tig:concept:authenticity> .

<urn:tig:concept:content-provenance-policy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "content provenance policy"@en ;
  skos:altLabel "content-provenance-policy"@en ;
  skos:definition "A governance policy that specifies what provenance, integrity, sanitization, redaction, and evidence conditions must be satisfied before content may be acted upon, stored, or forwarded."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:provenance> ;
  skos:related <urn:tig:concept:attestation> .

<urn:tig:concept:contextual-linkability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "contextual-linkability"@en ;
  skos:altLabel "contextual linkability"@en ;
  skos:definition "Refers to the condition where vendors or other data capture points provide enough context at point of capture to be able to use statistical correlation with existing data sets to link any of a person's disclosed attributes to a set of already known data points about a given person."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:control-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "control-authority"@en ;
  skos:altLabel "control authority"@en ;
  skos:definition "In identity systems, control authority is the power to determine who controls what. It is a primary factor in determining the basis for trust in those systems."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:control-mode> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "control mode"@en ;
  skos:altLabel "control-mode"@en ;
  skos:definition "A descriptor for the human-oversight shape of an agent or automated system at runtime, including whether intervention occurs in-loop, on-loop, through a sidecar, or within pre-bounded autonomy."@en ;
  skos:related <urn:tig:concept:access-control> ;
  skos:related <urn:tig:concept:agent> ;
  skos:related <urn:tig:concept:appropriate-friction> .

<urn:tig:concept:control-plane-shift> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "control-plane shift"@en ;
  skos:altLabel "control-plane-shift"@en ;
  skos:definition "A change in which actor, policy, infrastructure component, or governance mechanism can determine, constrain, or revoke system behavior."@en ;
  skos:related <urn:tig:concept:locus-of-control> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:governance> .

<urn:tig:concept:controlled-document> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "controlled-document"@en ;
  skos:altLabel "controlled document"@en ;
  skos:altLabel "controlled documents"@en ;
  skos:definition "A governance document whose authority is derived from a primary document."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:controlled-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "controlled-identifier"@en ;
  skos:altLabel "controlled identifier"@en ;
  skos:definition "An identifier whose controller can be discovered through an associated controlled identifier document containing verification material and service endpoints."@en ;
  skos:related <urn:tig:concept:decentralized-identifier> ;
  skos:related <urn:tig:concept:did-document> ;
  skos:related <urn:tig:concept:controller> ;
  skos:related <urn:tig:concept:cryptographic-key> .

<urn:tig:concept:controller> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "controller"@en ;
  skos:altLabel "controllers"@en ;
  skos:definition "In the context of digital communications, the entity in control of sending and receiving digital communications. In the context of decentralized digital trust infrastructure, the entity in control of the cryptographic keys necessary to perform cryptographically verifiable actions using a digital agent and digital wallet. In a ToIP context, the entity in control of a ToIP endpoint."@en ;
  skos:related <urn:tig:concept:device-controller> ;
  skos:related <urn:tig:concept:did-controller> ;
  skos:related <urn:tig:concept:toip-controller> .

<urn:tig:concept:correlation-privacy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "correlation-privacy"@en ;
  skos:altLabel "correlation privacy"@en ;
  skos:definition "In a communications context, a type of privacy protection in which messages use encryption, hashes, or other privacy-preserving technologies to avoid the use of identifiers or other content that unauthorized parties may use to correlate the sender and/or receiver(s)."@en ;
  skos:related <urn:tig:concept:authenticity> ;
  skos:related <urn:tig:concept:confidentiality> .

<urn:tig:concept:counterparty> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "counterparty"@en ;
  skos:altLabel "counterparties"@en ;
  skos:definition "From the perspective of one party, the other party in a transaction, such as a financial transaction."@en ;
  skos:related <urn:tig:concept:first-party> ;
  skos:related <urn:tig:concept:second-party> ;
  skos:related <urn:tig:concept:third-party> .

<urn:tig:concept:credential-family> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential-family"@en ;
  skos:altLabel "credential family"@en ;
  skos:altLabel "credential families"@en ;
  skos:definition "A set of related digital credentials defined by a governing body (typically in a governance framework) to empower transitive trust decisions among the participants in a digital trust ecosystem."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:credential-governance-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential-governance-framework"@en ;
  skos:altLabel "credential governance framework"@en ;
  skos:altLabel "credential governance frameworks"@en ;
  skos:definition "A governance framework for a credential family. A credential governance framework may be included within or referenced by an ecosystem governance framework."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:credential-offer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential-offer"@en ;
  skos:altLabel "credential offer"@en ;
  skos:altLabel "credential offers"@en ;
  skos:definition "A protocol request invoked by an issuer to offer to issue a digital credential to the  holder of a digital wallet. If the request is invoked by the holder, it is called an issuance request."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:credential-request> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential-request"@en ;
  skos:altLabel "credential request"@en ;
  skos:altLabel "credential requests"@en ;
  skos:definition "See: issuance request."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:credential-schema> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential-schema"@en ;
  skos:altLabel "credential schema"@en ;
  skos:altLabel "credential schemas"@en ;
  skos:definition "A data schema describing the structure of a digital credential. The W3C Verifiable Credentials Data Model Specification defines a set of requirements for credential schemas."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "credential"@en ;
  skos:altLabel "credentials"@en ;
  skos:definition "A container of claims describing one or more subjects. A credential is generated by the issuer of the credential and given to the holder of the credential. A credential typically includes a signature or some other means of proving its authenticity. A credential may be either a physical credential or a digital credential."@en ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:criterion> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "criterion"@en ;
  skos:definition "In the context of terminology, a written description of a concept that anyone can evaluate to determine whether or not an entity is an instance or example of that concept. Evaluation leads to a yes/no result."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:cryptographic-binding> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographic-binding"@en ;
  skos:altLabel "cryptographic binding"@en ;
  skos:altLabel "cryptographic bindings"@en ;
  skos:definition "Associating two or more related elements of information using cryptographic techniques."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:cryptographic-key> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographic-key"@en ;
  skos:altLabel "cryptographic key"@en ;
  skos:altLabel "cryptographic keys"@en ;
  skos:altLabel "cryptographic key pair"@en ;
  skos:altLabel "cryptographic key pairs"@en ;
  skos:definition "A key in cryptography is a piece of information, usually a string of numbers or letters that are stored in a file, which, when processed through a cryptographic algorithm, can encode or decode cryptographic data. Symmetric cryptography refers to the practice of the same key being used for both encryption and decryption. Asymmetric cryptography has separate keys for encrypting and decrypting. These keys are known as the public keys and private keys, respectively."@en ;
  skos:related <urn:tig:concept:controller> .

<urn:tig:concept:cryptographic-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographic-trust"@en ;
  skos:altLabel "cryptographic trust"@en ;
  skos:definition "A specialized type of technical trust that is achieved using cryptographic algorithms."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:cryptographic-verifiability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographic-verifiability"@en ;
  skos:altLabel "cryptographic verifiability"@en ;
  skos:altLabel "cryptographic verification"@en ;
  skos:definition "The property of being cryptographically verifiable."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:cryptographically-bound> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographically-bound"@en ;
  skos:altLabel "cryptographically bound"@en ;
  skos:definition "A state in which two or more elements of information have a cryptographic binding."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:cryptographically-verifiable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptographically-verifiable"@en ;
  skos:altLabel "cryptographically verifiable"@en ;
  skos:altLabel "cryptographically verified"@en ;
  skos:definition "A property of a data structure that has been digitally signed using a private key such that the digital signature can be verified using the public key. Verifiable data, verifiable messages, verifiable credentials, and verifiable data registries are all cryptographically verifiable. Cryptographic verifiability is a primary goal of the ToIP Technology Stack."@en ;
  skos:related <urn:tig:concept:tamper-evident> ;
  skos:related <urn:tig:concept:tamper-resistant> .

<urn:tig:concept:cryptography> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "cryptography"@en ;
  skos:definition "TODO"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:custodial-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "custodial-wallet"@en ;
  skos:altLabel "custodial wallet"@en ;
  skos:altLabel "custodial wallets"@en ;
  skos:definition "A digital wallet that is directly in the custody of a principal, i.e., under the principal’s direct personal or organizational control. A digital wallet that is in the custody of a third party is called a non-custodial wallet."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:custodian> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "custodian"@en ;
  skos:altLabel "custodians"@en ;
  skos:definition "A third party that has been assigned rights and duties in a custodianship arrangement for the purpose of hosting and safeguarding a principal's private keys, digital wallet and digital assets on the principal’s behalf. Depending on the custodianship arrangement, the custodian may act as an exchange and provide additional services, such as staking, lending, account recovery, or security features."@en ;
  skos:related <urn:tig:concept:custodial-wallet> .

<urn:tig:concept:custodianship-arrangement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "custodianship-arrangement"@en ;
  skos:altLabel "custodianship arrangement"@en ;
  skos:altLabel "custodianship arrangements"@en ;
  skos:definition "The informal terms or formal legal agreement under which a custodian agrees to provide service to a principal."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:dark-pattern> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dark-pattern"@en ;
  skos:altLabel "dark pattern"@en ;
  skos:altLabel "dark patterns"@en ;
  skos:definition "A design pattern, mainly in user interfaces, that has the effect of deceiving individuals into making choices that are advantageous to the designer."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:data-integrity-proof> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data-integrity-proof"@en ;
  skos:altLabel "Data Integrity proof"@en ;
  skos:altLabel "VC Data Integrity proof"@en ;
  skos:definition "A cryptographic proof mechanism used to protect the authenticity and integrity of verifiable credentials and similar constrained digital documents."@en ;
  skos:related <urn:tig:concept:digital-signature> ;
  skos:related <urn:tig:concept:cryptographic-verifiability> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:proof> .

<urn:tig:concept:data-packet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data-packet"@en ;
  skos:altLabel "data packet"@en ;
  skos:altLabel "data packets"@en ;
  skos:definition "In telecommunications and computer networking, a network packet is a formatted unit of data carried by a packet-switched network such as the Internet. A packet consists of control information and user data; the latter is also known as the payload. Control information provides data for delivering the payload (e.g., source and destination network addresses, error detection codes, or sequencing information). Typically, control information is found in packet headers and trailers."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:data-schema> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data-schema"@en ;
  skos:altLabel "data schema"@en ;
  skos:altLabel "data schemas"@en ;
  skos:definition "A description of the structure of a digital document or object, typically expressed in a machine-readable language in terms of constraints on the structure and content of documents or objects of that type. A credential schema is a particular type of data schema."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:data-subject> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data-subject"@en ;
  skos:altLabel "data subject"@en ;
  skos:altLabel "data subjects"@en ;
  skos:definition "The natural person that is described by personal data. Data subject is the term used by the EU General Data Protection Regulation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:data-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data-vault"@en ;
  skos:altLabel "data vault"@en ;
  skos:altLabel "data vaults"@en ;
  skos:definition "See: digital vault."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "data"@en ;
  skos:altLabel "datum"@en ;
  skos:definition "In the pursuit of knowledge, data is a collection of discrete values that convey information, describing quantity, quality, fact, statistics, other basic units of meaning, or simply sequences of symbols that may be further interpreted. A datum is an individual value in a collection of data."@en ;
  skos:related <urn:tig:concept:verifiable-data> .

<urn:tig:concept:datagram> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "datagram"@en ;
  skos:altLabel "datagrams"@en ;
  skos:definition "See: data packet."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:dcql> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dcql"@en ;
  skos:altLabel "Digital Credentials Query Language"@en ;
  skos:altLabel "DCQL"@en ;
  skos:definition "A query language defined by OpenID4VP for requesting credential presentations in a flexible and credential-format-aware way."@en ;
  skos:related <urn:tig:concept:openid4vp> ;
  skos:related <urn:tig:concept:presentation-request> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:credential> .

<urn:tig:concept:dead-drop> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dead-drop"@en ;
  skos:altLabel "dead drop"@en ;
  skos:definition "In cybersecurity or digital privacy scenarios, the term \"dead drop\" refers to encrypted or secure virtual spaces where information can be deposited or retrieved anonymously. In the credentials field, the presenter controls the disclosure, so you can't re-identify the data."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:decentralized-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decentralized-identifier"@en ;
  skos:altLabel "decentralized identifier"@en ;
  skos:altLabel "decentralized identifiers"@en ;
  skos:altLabel "DID"@en ;
  skos:altLabel "DIDs"@en ;
  skos:definition "A globally unique persistent identifier that does not require a centralized registration authority and is often generated and/or registered cryptographically. The generic format of a DID is defined in section 3.1 DID Syntax of the W3C Decentralized Identifiers (DIDs) 1.0 specification. A specific DID scheme is defined in a DID method specification."@en ;
  skos:related <urn:tig:concept:did-method> ;
  skos:related <urn:tig:concept:did-url> .

<urn:tig:concept:decentralized-identity-foundation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decentralized-identity-foundation"@en ;
  skos:altLabel "Decentralized Identity Foundation"@en ;
  skos:definition "A non-profit project of the Linux Foundation chartered to develop the foundational components of an open, standards-based, decentralized identity ecosystem for people, organizations, apps, and devices."@en ;
  skos:related <urn:tig:concept:openwallet-foundation> ;
  skos:related <urn:tig:concept:toip-foundation> .

<urn:tig:concept:decentralized-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decentralized-identity"@en ;
  skos:altLabel "decentralized identity"@en ;
  skos:altLabel "decentralized identities"@en ;
  skos:definition "A digital identity architecture in which a digital identity is established via the control of a set of cryptographic keys in a digital wallet so that the controller is not dependent on any external identity provider or other third party."@en ;
  skos:related <urn:tig:concept:federated-identity> ;
  skos:related <urn:tig:concept:self-sovereign-identity> .

<urn:tig:concept:decentralized-web-node> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decentralized-web-node"@en ;
  skos:altLabel "Decentralized Web Node"@en ;
  skos:altLabel "Decentralized Web Nodes"@en ;
  skos:definition "A decentralized personal and application data storage and message relay node, as defined in the DIF Decentralized Web Node specification. Users may have multiple nodes that replicate their data between them."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:deceptive-pattern> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "deceptive-pattern"@en ;
  skos:altLabel "deceptive pattern"@en ;
  skos:altLabel "deceptive patterns"@en ;
  skos:definition "See: dark pattern."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:decision-receipt> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decision receipt"@en ;
  skos:altLabel "decision-receipt"@en ;
  skos:definition "A structured, integrity-protected record of a trust or governance decision, including the decision context, authority, policy, evidence, outcome, obligations, and traceability data."@en ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:audit-log> ;
  skos:related <urn:tig:concept:attestation> .

<urn:tig:concept:decryption> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "decryption"@en ;
  skos:altLabel "decrypt"@en ;
  skos:altLabel "decrypts"@en ;
  skos:altLabel "decrypting"@en ;
  skos:altLabel "decrypted"@en ;
  skos:definition "The process of changing ciphertext into plaintext using a cryptographic algorithm and key. The opposite of encryption."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:deep-link> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "deep-link"@en ;
  skos:altLabel "deep link"@en ;
  skos:altLabel "deep links"@en ;
  skos:altLabel "deep linking"@en ;
  skos:altLabel "deep linked"@en ;
  skos:definition "In the context of the World Wide Web, deep linking is the use of a hyperlink that links to a specific, generally searchable or indexed, piece of web content on a website (e.g. \"https\\://example.com/path/page\"), rather than the website's home page (e.g., \"https\\://example.com\"). The URL contains all the information needed to point to a particular item. Deep linking is different from mobile deep linking, which refers to directly linking to in-app content using a non-HTTP URI."@en ;
  skos:related <urn:tig:concept:out-of-band-introduction> .

<urn:tig:concept:definition> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "definition"@en ;
  skos:altLabel "definitions"@en ;
  skos:definition "A textual statement defining the meaning of a term by specifying criterion that enable the concept identified by the term to be distinguished from all other concepts within the intended scope."@en ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:delegatee> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "delegatee"@en ;
  skos:altLabel "delegatees"@en ;
  skos:definition "The second party receiving a delegation from a first party (the delegator) and authorized to act only within the granted scope and applicable constraints."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:revocation> .

<urn:tig:concept:delegation-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "delegation-credential"@en ;
  skos:altLabel "delegation credential"@en ;
  skos:altLabel "delegation credentials"@en ;
  skos:definition "A credential used to perform delegation."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> .

<urn:tig:concept:delegation-lineage> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "delegation lineage"@en ;
  skos:altLabel "delegation-lineage"@en ;
  skos:definition "The ordered, verifiable path by which authority exercised by a current actor resolves through intermediate delegators to an originating principal and mandate."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:principal> .

<urn:tig:concept:delegation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "delegation"@en ;
  skos:altLabel "delegate"@en ;
  skos:altLabel "delegated"@en ;
  skos:altLabel "delegates"@en ;
  skos:definition "The act of a first party (the delegator) authorizing a second party (the delegatee) to perform a defined set of actions on behalf of the first party within an authorized scope and subject to applicable constraints."@en ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:revocation> .

<urn:tig:concept:delegator> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "delegator"@en ;
  skos:altLabel "delegators"@en ;
  skos:definition "The first party that makes a delegation to a second party (the delegatee) and remains accountable for granting authority within the permitted scope."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:dependent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dependent"@en ;
  skos:altLabel "dependents"@en ;
  skos:definition "An entity for the caring for and/or protecting/guarding/defending of which a guardianship arrangement has been established with a guardian."@en ;
  skos:related <urn:tig:concept:custodian> .

<urn:tig:concept:device-controller> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "device-controller"@en ;
  skos:altLabel "device controller"@en ;
  skos:altLabel "device controllers"@en ;
  skos:definition "The controller of a device capable of digital communications, e.g., a smartphone, tablet, laptop, IoT device, etc."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:dictionary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dictionary"@en ;
  skos:altLabel "dictionaries"@en ;
  skos:definition "A dictionary is a listing of lexemes (words or terms) from the lexicon of one or more specific languages, often arranged alphabetically, which may include information on definitions, usage, etymologies, pronunciations, translation, etc. It is a lexicographical reference that shows inter-relationships among the data. Unlike a glossary, a dictionary may provide multiple definitions of a term depending on its scope or context."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:did-controller> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did-controller"@en ;
  skos:altLabel "DID controller"@en ;
  skos:altLabel "DID controllers"@en ;
  skos:definition "An entity that has the capability to make changes to a DID document. A DID might have more than one DID controller. The DID controller(s) can be denoted by the optional `controller` property at the top level of the DID document. Note that a DID controller might be the DID subject."@en ;
  skos:related <urn:tig:concept:controller> .

<urn:tig:concept:did-document> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did-document"@en ;
  skos:altLabel "DID document"@en ;
  skos:altLabel "DID documents"@en ;
  skos:altLabel "DID doc"@en ;
  skos:altLabel "DID docs"@en ;
  skos:definition "A set of data describing the DID subject, including mechanisms, such as cryptographic public keys, that the DID subject or a DID delegate can use to authenticate itself and prove its association with the DID. A DID document might have one or more different representations as defined in section 6 of the W3C Decentralized Identifiers (DIDs) 1.0 specification."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:did-method> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did-method"@en ;
  skos:altLabel "DID method"@en ;
  skos:altLabel "DID methods"@en ;
  skos:definition "A definition of how a specific DID method scheme is implemented. A DID method is defined by a DID method specification, which specifies the precise operations by which DIDs and DID documents are created, resolved, updated, and deactivated."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:did-subject> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did-subject"@en ;
  skos:altLabel "DID subject"@en ;
  skos:altLabel "DID subjects"@en ;
  skos:definition "The entity identified by a DID and described by a DID document. Anything can be a DID subject: person, group, organization, physical thing, digital thing, logical thing, etc."@en ;
  skos:related <urn:tig:concept:subject> .

<urn:tig:concept:did-url> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did-url"@en ;
  skos:altLabel "DID URL"@en ;
  skos:altLabel "DID URLs"@en ;
  skos:definition "A DID plus any additional syntactic component that conforms to the definition in section 3.2 of the W3C Decentralized Identifiers (DIDs) 1.0 specification. This includes an optional DID path (with its leading / character), optional DID query (with its leading ? character), and optional DID fragment (with its leading # character)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:did> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "did"@en ;
  skos:altLabel "DID"@en ;
  skos:definition "See: decentralized identifier"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:digital-agent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-agent"@en ;
  skos:altLabel "digital agent"@en ;
  skos:altLabel "digital agents"@en ;
  skos:definition "In the context of ​​decentralized digital trust infrastructure, a software agent that operates in conjunction with a digital wallet or similar system component to take actions on behalf of its controller."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:digital-asset> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-asset"@en ;
  skos:altLabel "digital asset"@en ;
  skos:altLabel "digital assets"@en ;
  skos:definition "A digital asset is anything that exists only in digital form and comes with a distinct usage right. Data that do not possess that right are not considered assets."@en ;
  skos:related <urn:tig:concept:digital-credential> .

<urn:tig:concept:digital-certificate> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-certificate"@en ;
  skos:altLabel "digital certificate"@en ;
  skos:altLabel "digital certificates"@en ;
  skos:definition "See: public key certificate."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:digital-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-credential"@en ;
  skos:altLabel "digital credential"@en ;
  skos:altLabel "digital credentials"@en ;
  skos:definition "A credential in digital form that is signed with a digital signature and held in a digital wallet. A digital credential is issued to a holder by an issuer; a proof of the credential is presented by the holder to a verifier."@en ;
  skos:related <urn:tig:concept:issuance-request> ;
  skos:related <urn:tig:concept:presentation-request> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:digital-ecosystem> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-ecosystem"@en ;
  skos:altLabel "digital ecosystem"@en ;
  skos:altLabel "digital ecosystems"@en ;
  skos:definition "A digital ecosystem is a distributed, adaptive, open socio-technical system with properties of self-organization, scalability and sustainability inspired from natural ecosystems. Digital ecosystem models are informed by knowledge of natural ecosystems, especially for aspects related to competition and collaboration among diverse entities."@en ;
  skos:related <urn:tig:concept:digital-trust-ecosystem> ;
  skos:related <urn:tig:concept:trust-community> .

<urn:tig:concept:digital-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-identity"@en ;
  skos:altLabel "digital identity"@en ;
  skos:altLabel "digital identities"@en ;
  skos:altLabel "digital ID"@en ;
  skos:altLabel "digital IDs"@en ;
  skos:definition "An identity expressed in a digital form for the purpose representing the identified entity within a computer system or digital network."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:digital-rights-management> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-rights-management"@en ;
  skos:altLabel "digital rights management"@en ;
  skos:definition "Digital rights management (DRM) is the management of legal access to digital content. Various tools or technological protection measures (TPM) like access control technologies, can restrict the use of proprietary hardware and copyrighted works. DRM technologies govern the use, modification and distribution of copyrighted works (e.g. software, multimedia content) and of systems that enforce these policies within devices."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:digital-signature> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-signature"@en ;
  skos:altLabel "digital signature"@en ;
  skos:altLabel "digital signatures"@en ;
  skos:altLabel "digitally sign"@en ;
  skos:altLabel "digitally signed"@en ;
  skos:altLabel "digital signing"@en ;
  skos:altLabel "cryptographic signature"@en ;
  skos:altLabel "cryptographic signatures"@en ;
  skos:definition "A digital signature is a mathematical scheme that uses cryptography for verifying the authenticity of digital messages or documents. A valid digital signature, where the prerequisites are satisfied, gives a recipient very high confidence that the message was created by a known sender (authenticity), and that the message was not altered in transit (integrity)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:digital-trust-ecosystem> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-trust-ecosystem"@en ;
  skos:altLabel "digital trust ecosystem"@en ;
  skos:altLabel "digital trust ecosystems"@en ;
  skos:definition "A digital ecosystem in which the participants are one or more interoperating trust communities. Governance of the various roles of governed parties within a digital trust ecosystem (e.g., issuers, holders, verifiers, certification bodies, auditors) is typically managed by a governing body using a governance framework as recommended in the ToIP Governance Stack. Many digital trust ecosystems will also maintain one or more trust lists and/or trust registries."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:digital-trust-utility> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-trust-utility"@en ;
  skos:altLabel "digital trust utility"@en ;
  skos:altLabel "digital trust utilities"@en ;
  skos:definition "An information system, network, distributed database, or blockchain designed to provide one or more supporting services to higher level components of decentralized digital trust infrastructure. In the ToIP stack, digital trust utilities are at Layer 1. A verifiable data registry is one type of digital trust utility."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:digital-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-vault"@en ;
  skos:altLabel "digital vault"@en ;
  skos:altLabel "digital vaults"@en ;
  skos:definition "A secure container for data whose controller is the principal. A digital vault is most commonly used in conjunction with a digital wallet and a digital agent. A digital vault may be implemented on a local device or in the cloud; multiple digital vaults may be used by the same principal across different devices and/or the cloud; if so they may use some type of synchronization. If the capability is supported, data may flow into or out of the digital vault automatically based on subscriptions approved by the controller."@en ;
  skos:related <urn:tig:concept:enterprise-data-vault> ;
  skos:related <urn:tig:concept:personal-data-vault> ;
  skos:related <urn:tig:concept:virtual-vault> .

<urn:tig:concept:digital-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "digital-wallet"@en ;
  skos:altLabel "digital wallet"@en ;
  skos:altLabel "digital wallets"@en ;
  skos:definition "A user agent, optionally including a hardware component, capable of securely storing and processing cryptographic keys, digital credentials, digital assets and other sensitive private data that enables the controller to perform cryptographically verifiable operations. A non-custodial wallet is directly in the custody of a principal. A custodial wallet is in the custody of a third party. Personal wallets are held by individual persons; enterprise wallets are held by organizations or other legal entities."@en ;
  skos:related <urn:tig:concept:digital-agent> ;
  skos:related <urn:tig:concept:key-management-system> ;
  skos:related <urn:tig:concept:wallet-engine> .

<urn:tig:concept:discovery-governance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "discovery governance"@en ;
  skos:altLabel "discovery-governance"@en ;
  skos:definition "The policies and controls that determine how descriptors or services are discovered, who mediates discovery, what access and freshness rules apply, and how discovery failures are handled."@en ;
  skos:related <urn:tig:concept:discovery> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:discovery> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "discovery"@en ;
  skos:definition "A mechanism that helps systems or devices find each other automatically, often used in networks to identify services or resources. In decentralized identifier systems it helps to locate and verify digital identities without relying on a central authority."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:distributed-ledger> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "distributed-ledger"@en ;
  skos:altLabel "distributed ledger"@en ;
  skos:altLabel "distributed ledgers"@en ;
  skos:altLabel "DLT"@en ;
  skos:altLabel "DLTs"@en ;
  skos:definition "A distributed ledger (also called a shared ledger or distributed ledger technology or DLT) is the consensus of replicated, shared, and synchronized digital data that is geographically spread (distributed) across many sites, countries, or institutions. In contrast to a centralized database, a distributed ledger does not require a central administrator, and consequently does not have a single (central) point-of-failure. In general, a distributed ledger requires a peer-to-peer (P2P) computer network and consensus algorithms so that the ledger is reliably replicated across distributed computer nodes (servers, clients, etc.). The most common form of distributed ledger technology is the blockchain, which can either be on a public or private network."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:domain> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "domain"@en ;
  skos:altLabel "domains"@en ;
  skos:definition "See: security domain."@en ;
  skos:related <urn:tig:concept:trust-domain> .

<urn:tig:concept:dpop> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dpop"@en ;
  skos:altLabel "DPoP"@en ;
  skos:altLabel "Demonstrating Proof of Possession"@en ;
  skos:definition "An OAuth 2.0 mechanism for sender-constraining tokens by requiring a client to prove possession of a private key when using a token."@en ;
  skos:related <urn:tig:concept:proof-of-possession> ;
  skos:related <urn:tig:concept:sender-constrained-token> ;
  skos:related <urn:tig:concept:cryptographic-key> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:drm> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "drm"@en ;
  skos:altLabel "DRM"@en ;
  skos:definition "See: digital rights management."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:dwn> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dwn"@en ;
  skos:altLabel "DWN"@en ;
  skos:definition "See: Decentralized Web Node."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:dynamic-authorization> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "dynamic authorization"@en ;
  skos:altLabel "dynamic-authorization"@en ;
  skos:definition "An authorization approach in which runtime decisions are produced by evaluating contextual attributes, evidence, and policy rather than relying only on static permissions."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:ecosystem-governance-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ecosystem-governance-framework"@en ;
  skos:altLabel "ecosystem governance framework"@en ;
  skos:altLabel "ecosystem governance frameworks"@en ;
  skos:altLabel "EGF"@en ;
  skos:altLabel "EGFs"@en ;
  skos:definition "A governance framework for a digital trust ecosystem. An ecosystem governance framework may incorporate, aggregate, or reference other types of governance frameworks such as a credential governance framework or a utility governance framework."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:ecosystem> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ecosystem"@en ;
  skos:altLabel "ecosystems"@en ;
  skos:definition "See: digital ecosystem."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:eidas> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "eidas"@en ;
  skos:altLabel "eIDAS"@en ;
  skos:definition "eIDAS (electronic IDentification, Authentication and trust Services) is an EU regulation with the stated purpose of governing \"electronic identification and trust services for electronic transactions\". It passed in 2014 and its provisions came into effect between 2016-2018."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:encrypt-sender-sign-receiver> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "encrypt-sender-sign-receiver"@en ;
  skos:altLabel "encrypt sender sign receiver"@en ;
  skos:definition "An authenticated encryption approach, using PKI. It covers authenticity and confidentiality."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:encrypted-data-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "encrypted-data-vault"@en ;
  skos:altLabel "encrypted data vault"@en ;
  skos:altLabel "encrypted data vaults"@en ;
  skos:definition "See: digital vault."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:encryption> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "encryption"@en ;
  skos:altLabel "encrypt"@en ;
  skos:altLabel "encrypts"@en ;
  skos:altLabel "encrypted"@en ;
  skos:altLabel "encrypting"@en ;
  skos:definition "Cryptographic transformation of data (called plaintext) into a form (called ciphertext) that conceals the data's original meaning to prevent it from being known or used. If the transformation is reversible, the corresponding reversal process is called decryption, which is a transformation that restores encrypted data to its original state."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:end-to-end-encryption> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "end-to-end-encryption"@en ;
  skos:altLabel "end-to-end encryption"@en ;
  skos:altLabel "end-to-end encrypt"@en ;
  skos:definition "Encryption that is applied to a communication before it is transmitted from the sender’s communication endpoint and cannot be decrypted until after it is received at the receiver’s communication endpoint. When end-to-end encryption is used, the communication cannot be decrypted in transit no matter how many intermediaries are involved in the routing process."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:end-to-end-principle> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "end-to-end-principle"@en ;
  skos:altLabel "End-to-End Principle"@en ;
  skos:definition "The end-to-end principle is a design framework in computer networking. In networks designed according to this principle, guaranteeing certain application-specific features, such as reliability and security, requires that they reside in the communicating end nodes of the network. Intermediary nodes, such as gateways and routers, that exist to establish the network, may implement these to improve efficiency but cannot guarantee end-to-end correctness."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> .

<urn:tig:concept:end-verifiability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "end-verifiability"@en ;
  skos:altLabel "end verifiability"@en ;
  skos:definition "a data item or statement may be cryptographically securely attributable to its source (party at the source end) by any recipient verifier (party at the destination end) without reliance on any infrastructure not under the verifier’s ultimate control."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> .

<urn:tig:concept:end-verifiable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "end-verifiable"@en ;
  skos:altLabel "end verifiable"@en ;
  skos:definition "When a log is _end verifiable_, it means that the log may be verified by any end user that receives a copy. No trust in intervening infrastructure is needed to verify the log and validate the content."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:endpoint-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "endpoint-system"@en ;
  skos:altLabel "endpoint system"@en ;
  skos:altLabel "endpoint systems"@en ;
  skos:definition "The system that operates a communications endpoint. In the context of the ToIP stack, an endpoint system is one of three types of systems defined in the ToIP Technology Architecture Specification."@en ;
  skos:related <urn:tig:concept:intermediary-system> ;
  skos:related <urn:tig:concept:supporting-system> .

<urn:tig:concept:endpoint> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "endpoint"@en ;
  skos:altLabel "endpoints"@en ;
  skos:definition "See: communication endpoint."@en ;
  skos:related <urn:tig:concept:toip-endpoint> .

<urn:tig:concept:enterprise-data-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "enterprise-data-vault"@en ;
  skos:altLabel "enterprise data vault"@en ;
  skos:altLabel "enterprise data vaults"@en ;
  skos:definition "A digital vault whose controller is an organization."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:enterprise-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "enterprise-wallet"@en ;
  skos:altLabel "enterprise wallet"@en ;
  skos:altLabel "enterprise wallets"@en ;
  skos:definition "A digital wallet whose holder is an organization."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:entity-statement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "entity-statement"@en ;
  skos:altLabel "entity statement"@en ;
  skos:definition "A signed statement in OpenID Federation that describes metadata, authority, and trust relationships for a federation entity."@en ;
  skos:related <urn:tig:concept:openid-federation> ;
  skos:related <urn:tig:concept:federation> ;
  skos:related <urn:tig:concept:trust-chain> ;
  skos:related <urn:tig:concept:metadata> .

<urn:tig:concept:entity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "entity"@en ;
  skos:altLabel "entities"@en ;
  skos:definition "Someone or something that is known to exist."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:ephemeral-connection> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ephemeral-connection"@en ;
  skos:altLabel "ephemeral connection"@en ;
  skos:altLabel "ephemeral connections"@en ;
  skos:definition "A connection that only exists for the duration of a single communication session or transaction."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:essr> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "essr"@en ;
  skos:altLabel "ESSR"@en ;
  skos:definition "Encrypt‐Sender‐Sign‐Receiver"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:eudi-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "eudi-wallet"@en ;
  skos:altLabel "European Digital Identity Wallet"@en ;
  skos:altLabel "EUDI Wallet"@en ;
  skos:altLabel "EUDIW"@en ;
  skos:definition "A wallet ecosystem component under the European Digital Identity framework for storing and presenting person identification data, attestations, and credentials across EU contexts."@en ;
  skos:related <urn:tig:concept:digital-wallet> ;
  skos:related <urn:tig:concept:pid> ;
  skos:related <urn:tig:concept:qualified-electronic-attestation-of-attributes> ;
  skos:related <urn:tig:concept:eidas> .

<urn:tig:concept:evidence-artifact> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "evidence artifact"@en ;
  skos:altLabel "evidence-artifact"@en ;
  skos:definition "A typed, structured output produced by a system, authorized actor, or assessment process to demonstrate that a rule was checked, a behavior occurred, or a condition holds."@en ;
  skos:related <urn:tig:concept:attestation> ;
  skos:related <urn:tig:concept:controlled-document> ;
  skos:related <urn:tig:concept:audit-log> .

<urn:tig:concept:evidence-bundle> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "evidence bundle"@en ;
  skos:altLabel "evidence-bundle"@en ;
  skos:definition "A bounded collection of evidence artifacts assembled for a decision, assessment, verification, or audit purpose, with sufficient metadata to support integrity and traceability."@en ;
  skos:related <urn:tig:concept:attestation> ;
  skos:related <urn:tig:concept:c2pa-manifest> .

<urn:tig:concept:expression-language> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "expression-language"@en ;
  skos:altLabel "expression language"@en ;
  skos:altLabel "expression languages"@en ;
  skos:definition "A language for creating a computer-interpretable (machine-readable) representation of specific knowledge."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:extension-contract> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "extension contract"@en ;
  skos:altLabel "extension-contract"@en ;
  skos:definition "A protocol-neutral record of whether an optional or required extension was proposed, supported, accepted, degraded, rejected, or not attempted, including the applicable failure behavior."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:trust-framework> .

<urn:tig:concept:fal> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "fal"@en ;
  skos:altLabel "FAL"@en ;
  skos:definition "See: federation assurance level."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:federated-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "federated-identity"@en ;
  skos:altLabel "federated identity"@en ;
  skos:altLabel "federated identities"@en ;
  skos:definition "A digital identity architecture in which a digital identity established on one computer system, network, or trust domain is linked to other computer systems, networks, or trust domains for the purpose of identifying the same entity across those domains."@en ;
  skos:related <urn:tig:concept:decentralized-identity> ;
  skos:related <urn:tig:concept:self-sovereign-identity> .

<urn:tig:concept:federation-assurance-level> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "federation-assurance-level"@en ;
  skos:altLabel "federation assurance level"@en ;
  skos:altLabel "federation assurance levels"@en ;
  skos:altLabel "FAL"@en ;
  skos:altLabel "FALs"@en ;
  skos:definition "A category that describes the federation protocol used to communicate an assertion containing authentication) and attribute information (if applicable) to a relying party, as defined in NIST SP 800-63-3 in terms of three levels: FAL 1 (Some confidence), FAL 2 (High confidence), FAL 3 (Very high confidence)."@en ;
  skos:related <urn:tig:concept:authenticator-assurance-level> ;
  skos:related <urn:tig:concept:identity-assurance-level> .

<urn:tig:concept:federation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "federation"@en ;
  skos:altLabel "federate"@en ;
  skos:altLabel "federates"@en ;
  skos:altLabel "federated"@en ;
  skos:definition "A group of organizations that collaborate to establish a common trust framework or governance framework for the exchange of identity data in a federated identity system."@en ;
  skos:related <urn:tig:concept:trust-community> .

<urn:tig:concept:fiduciary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "fiduciary"@en ;
  skos:altLabel "fiduciaries"@en ;
  skos:definition "A fiduciary is a person who holds a legal or ethical relationship of trust with one or more other parties (person or group of persons). Typically, a fiduciary prudently takes care of money or other assets for another person. One party, for example, a corporate trust company or the trust department of a bank, acts in a fiduciary capacity to another party, who, for example, has entrusted funds to the fiduciary for safekeeping or investment. In a fiduciary relationship, one person, in a position of vulnerability, justifiably vests confidence, good faith, reliance, and trust in another whose aid, advice, or protection is sought in some matter."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:first-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "first-party"@en ;
  skos:altLabel "first party"@en ;
  skos:altLabel "first parties"@en ;
  skos:definition "The party who initiates a trust relationship, connection, or transaction with a second party."@en ;
  skos:related <urn:tig:concept:third-party> ;
  skos:related <urn:tig:concept:fourth-party> .

<urn:tig:concept:foundational-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "foundational-identity"@en ;
  skos:altLabel "foundational identity"@en ;
  skos:altLabel "foundational identities"@en ;
  skos:definition "A set of identity data, such as a credential, issued by an authoritative source for the legal identity of the subject. Birth certificates, passports, driving licenses, and other forms of government ID documents are considered foundational identity documents. Foundational identities are often used to provide identity binding for functional identities."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:fourth-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "fourth-party"@en ;
  skos:altLabel "fourth party"@en ;
  skos:altLabel "fourth parties"@en ;
  skos:definition "A party that is not directly involved in the trust relationship between a first party and a second party, but provides supporting services exclusively to the first party (in contrast with a third party, who in most cases provides supporting services to the second party). In its strongest form, a fourth party has a fiduciary relationship with the first party."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:functional-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "functional-identity"@en ;
  skos:altLabel "functional identity"@en ;
  skos:altLabel "functional identities"@en ;
  skos:definition "A set of identity data, such as a credential, that is issued not for the purpose of establishing a foundational identity for the subject, but for the purpose of establishing other attributes, qualifications, or capabilities of the subject. Loyalty cards, library cards, and employee IDs are all examples of functional identities. Foundational identities are often used to provide identity binding for functional identities."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:gateway> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "gateway"@en ;
  skos:altLabel "gateways"@en ;
  skos:definition "A gateway is a piece of networking hardware or software used in telecommunications networks that allows data to flow from one discrete network to another. Gateways are distinct from routers or switches in that they communicate using more than one protocol to connect multiple networks<sup>\\[1\\]\\[2\\]</sup>#cite_note-1) and can operate at any of the seven layers of the open systems interconnection model (OSI)."@en ;
  skos:related <urn:tig:concept:intermediary> .

<urn:tig:concept:gdpr> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "gdpr"@en ;
  skos:altLabel "GDPR"@en ;
  skos:definition "See: General Data Protection Regulation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:general-data-protection-regulation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "general-data-protection-regulation"@en ;
  skos:altLabel "General Data Protection Regulation"@en ;
  skos:definition "The General Data Protection Regulation (Regulation (EU) 2016/679, abbreviated GDPR) is a European Union regulation on information privacy in the European Union (EU) and the European Economic Area (EEA). The GDPR is an important component of EU privacy law and human rights law, in particular Article 8(1) of the Charter of Fundamental Rights of the European Union. It also governs the transfer of personal data outside the EU and EEA. The GDPR's goals are to enhance individuals' control and rights over their personal information and to simplify the regulations for international business."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:glossary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "glossary"@en ;
  skos:altLabel "glossaries"@en ;
  skos:definition "A glossary (from Ancient Greek: γλῶσσα, glossa; language, speech, wording), also known as a _vocabulary_ or _clavis_, is an alphabetical list of terms in a particular domain of knowledge (scope) together with the definitions for those terms. Unlike a dictionary, a glossary has only one definition for each term."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:governance-diamond> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-diamond"@en ;
  skos:altLabel "governance diamond"@en ;
  skos:altLabel "governance diamonds"@en ;
  skos:definition "A term that refers to the addition of a governing body to the standard trust triangle of issuers, holders, and verifiers of credentials. The resulting combination of four parties represents the basic structure of a digital trust ecosystem."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:governance-document> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-document"@en ;
  skos:altLabel "governance document"@en ;
  skos:altLabel "governance documents"@en ;
  skos:definition "A document with at least one identifier that specifies governance requirements for a trust community."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:governance-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-framework"@en ;
  skos:altLabel "governance framework"@en ;
  skos:altLabel "governance frameworks"@en ;
  skos:definition "A collection of one or more governance documents published by the governing body of a trust community that defines the rules, roles, responsibilities, and decision rights under which that community operates."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:governance-graph> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-graph"@en ;
  skos:altLabel "governance graph"@en ;
  skos:altLabel "governance graphs"@en ;
  skos:definition "A graph of the governance relationships between entities with a trust community. A governance graph shows which nodes are the governing bodies and which are the governed parties. In some cases, a governance graph can be traversed by making queries to one or more trust registries.Note: a party can play both roles and also be a participant in multiple governance frameworks."@en ;
  skos:related <urn:tig:concept:authorization-graph> ;
  skos:related <urn:tig:concept:reputation-graph> ;
  skos:related <urn:tig:concept:trust-graph> .

<urn:tig:concept:governance-legitimacy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance legitimacy"@en ;
  skos:altLabel "governance-legitimacy"@en ;
  skos:definition "The recognized basis on which a governing authority, rule, mandate, or decision is considered entitled to exercise power in a defined context."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:authority> .

<urn:tig:concept:governance-requirement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-requirement"@en ;
  skos:altLabel "governance requirement"@en ;
  skos:altLabel "governance requirements"@en ;
  skos:definition "A requirement such as a policy, rule, or technical specification specified in a governance document."@en ;
  skos:related <urn:tig:concept:technical-requirement> .

<urn:tig:concept:governance-risk-management-compliance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance-risk-management-compliance"@en ;
  skos:altLabel "Governance - Risk Management - Compliance"@en ;
  skos:definition "Governance, risk management, and compliance (GRC) are three related facets that aim to assure an organization reliably achieves objectives, addresses uncertainty and acts with integrity. Governance is the combination of processes established and executed by the directors (or the board of directors) that are reflected in the organization's structure and how it is managed and led toward achieving goals. Risk management is predicting and managing risks that could hinder the organization from reliably achieving its objectives under uncertainty. Compliance refers to adhering with the mandated boundaries (laws and regulations) and voluntary boundaries (company's policies, procedures, etc.)"@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:governance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governance"@en ;
  skos:definition "The act or process of governing or overseeing the realization of (the results associated with) a set of objectives by the owner of these objectives, in order to ensure they will be fit for the purposes that this owner intends to use them for."@en ;
  skos:related <urn:tig:concept:governing-body> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:governed-action> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governed action"@en ;
  skos:altLabel "governed-action"@en ;
  skos:definition "An action whose permission, scope, conditions, evidence, and accountability are determined by applicable governance and authority."@en ;
  skos:related <urn:tig:concept:action> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:governed-information> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governed-information"@en ;
  skos:altLabel "governed information"@en ;
  skos:definition "Any information published under the authority of a governing body for the purpose of governing a trust community. This includes its governance framework and any information available via an authorized trust registry."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> .

<urn:tig:concept:governed-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governed-party"@en ;
  skos:altLabel "governed party"@en ;
  skos:altLabel "governed parties"@en ;
  skos:definition "A party whose role(s) in a trust community is governed by the governance requirements in a governance framework."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:governed-use-case> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governed-use-case"@en ;
  skos:altLabel "governed use case"@en ;
  skos:altLabel "governed use cases"@en ;
  skos:definition "A use case specified in a governance document that results in specific governance requirements within that governance framework. Governed use cases may optionally be discovered via a trust registry authorized by the relevant governance framework."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> .

<urn:tig:concept:governing-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governing-authority"@en ;
  skos:altLabel "governing authority"@en ;
  skos:altLabel "governing authorities"@en ;
  skos:definition "See: governing body."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:governing-body> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "governing-body"@en ;
  skos:altLabel "governing body"@en ;
  skos:altLabel "governing bodies"@en ;
  skos:definition "The party (or set of parties) authoritative for governing a trust community, usually (but not always) by developing, publishing, maintaining, and enforcing a governance framework. A governing body may be a government, a formal legal entity of any kind, an informal group of any kind, or an individual. A governing body may also delegate operational responsibilities to an administering body."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> .

<urn:tig:concept:grc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "grc"@en ;
  skos:altLabel "GRC"@en ;
  skos:definition "See: Governance - Risk Management - Compliance."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:guardian> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "guardian"@en ;
  skos:altLabel "guardians"@en ;
  skos:definition "A party that has been assigned rights and duties in a guardianship arrangement for the purpose of caring for, protecting, guarding, and defending the entity that is the dependent in that guardianship arrangement. In the context of decentralized digital trust infrastructure, a guardian is issued guardianship credentials into their own digital wallet in order to perform such actions on behalf of the dependent as are required by this role."@en ;
  skos:related <urn:tig:concept:custodian> ;
  skos:related <urn:tig:concept:zero-knowledge-service-provider> .

<urn:tig:concept:guardianship-arrangement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "guardianship-arrangement"@en ;
  skos:altLabel "guardianship arrangement"@en ;
  skos:altLabel "guardianship arrangements"@en ;
  skos:altLabel "guardianship"@en ;
  skos:altLabel "guardianships"@en ;
  skos:definition "A guardianship arrangement is the specification, within a jurisdiction, of rights and duties between legal entities for caring for, protecting, guarding, or defending one or more dependents. At a minimum, the participating entities are the guardian and the dependent."@en ;
  skos:related <urn:tig:concept:guardian> ;
  skos:related <urn:tig:concept:dependent> ;
  skos:related <urn:tig:concept:custodianship-arrangement> ;
  skos:related <urn:tig:concept:jurisdiction> .

<urn:tig:concept:guardianship-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "guardianship-credential"@en ;
  skos:altLabel "guardianship credential"@en ;
  skos:altLabel "guardianship credentials"@en ;
  skos:definition "A digital credential issued by a governing body to a guardian to empower the guardian to undertake the rights and duties of a guardianship arrangement on behalf of a dependent."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:hardware-security-module> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "hardware-security-module"@en ;
  skos:altLabel "hardware security module"@en ;
  skos:altLabel "hardware security modules"@en ;
  skos:altLabel "HSM"@en ;
  skos:altLabel "HSMs"@en ;
  skos:definition "A physical computing device that provides tamper-evident and intrusion-resistant safeguarding and management of digital keys and other secrets, as well as crypto-processing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:hash-function> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "hash-function"@en ;
  skos:altLabel "hash function"@en ;
  skos:altLabel "hash functions"@en ;
  skos:definition "An algorithm that computes a numerical value (called the hash value) on a data file or electronic message that is used to represent that file or message, and depends on the entire contents of the file or message. A hash function can be considered to be a fingerprint of the file or message. Approved hash functions satisfy the following properties: _one-way_ (it is computationally infeasible to find any input that maps to any pre-specified output); and _collision resistant_ (it is computationally infeasible to find any two distinct inputs that map to the same output)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:hash> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "hash"@en ;
  skos:altLabel "hashes"@en ;
  skos:altLabel "hash value"@en ;
  skos:altLabel "hash output"@en ;
  skos:altLabel "hash result"@en ;
  skos:definition "The result of applying a hash function to a message."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:holder-binding> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "holder-binding"@en ;
  skos:altLabel "holder binding"@en ;
  skos:altLabel "holder bindings"@en ;
  skos:definition "The process of creating and verifying a relationship between the holder of a digital wallet and the wallet itself. Holder binding is related to but NOT the same as subject binding."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:holder> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "holder"@en ;
  skos:altLabel "holders"@en ;
  skos:definition "A role an agent performs by serving as the controller of the cryptographic keys and digital credentials in a digital wallet. The holder makes issuance requests for credentials and responds to presentation requests for credentials. A holder is usually, but not always, a subject of the credentials they are holding."@en ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:host> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "host"@en ;
  skos:altLabel "hosts"@en ;
  skos:definition "A host is any hardware device that has the capability of permitting access to a network via a user interface, specialized software, network address, protocol stack, or any other means. Some examples include, but are not limited to, computers, personal electronic devices, thin clients, and multi-functional devices."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:hourglass-model> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "hourglass-model"@en ;
  skos:altLabel "hourglass model"@en ;
  skos:altLabel "hourglass models"@en ;
  skos:definition "An architectural model for layered systems—and specifically for the protocol layers in a protocol stack—in which a diversity of supporting protocols and services at the lower layers are able to support a great diversity of protocols and applications at the higher layers through the use of a single protocol in the spanning layer in the middle—the “neck” of the hourglass."@en ;
  skos:related <urn:tig:concept:trust-spanning-protocol> .

<urn:tig:concept:hsm> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "hsm"@en ;
  skos:altLabel "HSM"@en ;
  skos:definition "See: hardware security module."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:human-auditable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "human-auditable"@en ;
  skos:altLabel "human auditable"@en ;
  skos:altLabel "human auditability"@en ;
  skos:definition "A process or procedure whose compliance with the policies in a trust framework or governance framework can only be verified by a human performing an audit. Human auditability is a primary goal of the ToIP Governance Stack."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:governance> .

<urn:tig:concept:human-experience> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "human-experience"@en ;
  skos:altLabel "human experience"@en ;
  skos:definition "The processes, patterns and rituals of acquiring knowledge or skill from doing, seeing, or feeling things as a natural person. In the context of decentralized digital trust infrastructure, the direct experience of a natural person using trust applications to make trust decisions within one or more digital trust ecosystems."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:human-harm> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "human harm"@en ;
  skos:altLabel "human-harm"@en ;
  skos:definition "A negative effect on a person or community, including effects on safety, rights, autonomy, dignity, privacy, access, livelihood, or ability to obtain remedy."@en ;
  skos:related <urn:tig:concept:risk> ;
  skos:related <urn:tig:concept:risk-assessment> .

<urn:tig:concept:human-readable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "human-readable"@en ;
  skos:altLabel "human-readability"@en ;
  skos:definition "Information that can be processed by a human but that is not intended to be machine-readable."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:human-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "human-trust"@en ;
  skos:altLabel "human trust"@en ;
  skos:definition "A level of assurance in a trust relationship or a trust decision that can be achieved only via human evaluation of applicable trust factors."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:ial> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ial"@en ;
  skos:altLabel "IAL"@en ;
  skos:definition "See: identity assurance level."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:identification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identification"@en ;
  skos:altLabel "identify"@en ;
  skos:altLabel "identified"@en ;
  skos:altLabel "identifies"@en ;
  skos:altLabel "identifying"@en ;
  skos:definition "The action of a party obtaining the set of identity data necessary to serve as that party’s identity for a specific entity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identifier"@en ;
  skos:altLabel "identifiers"@en ;
  skos:definition "A single attribute—typically a character string—that uniquely identifies an entity within a specific context (which may be a global context). Examples include the name of a party, the URL of an organization, or a serial number for a man-made thing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:decentralized-identifier> ;
  skos:related <urn:tig:concept:verifiable-identifier> .

<urn:tig:concept:identity-assurance-level> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-assurance-level"@en ;
  skos:altLabel "identity assurance level"@en ;
  skos:altLabel "identity assurance levels"@en ;
  skos:altLabel "IAL"@en ;
  skos:altLabel "IALs"@en ;
  skos:definition "A category that conveys the degree of confidence that a person’s claimed identity is their real identity, for example as defined in NIST SP 800-63-3 in terms of three levels: IAL 1 (Some confidence), IAL 2 (High confidence), IAL 3 (Very high confidence)."@en ;
  skos:related <urn:tig:concept:authenticator-assurance-level> ;
  skos:related <urn:tig:concept:federation-assurance-level> .

<urn:tig:concept:identity-assurance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-assurance"@en ;
  skos:altLabel "identity assurance"@en ;
  skos:definition "The heavy-lifting to be done by a trusted (middle-man) party to establish - and then offer reputational trust. An example of such a party is [[xref:keri1, GLEIF]]. Instead, KERI is for attributional-trust. In the real world you need both."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:identity-binding> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-binding"@en ;
  skos:altLabel "identity binding"@en ;
  skos:altLabel "identity bindings"@en ;
  skos:definition "The process of associating a set of identity data, such as a credential, with its subject, such as a natural person. The strength of an identity binding is one factor in determining an authenticator assurance level."@en ;
  skos:related <urn:tig:concept:identity-assurance-level> ;
  skos:related <urn:tig:concept:identity-proofing> .

<urn:tig:concept:identity-controller> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-controller"@en ;
  skos:altLabel "identity controller"@en ;
  skos:definition "The controller (e.g., a natural person or organization) of an identity, especially a digital identity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:identity-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-data"@en ;
  skos:altLabel "identity data"@en ;
  skos:definition "The set of data held by a party in order to provide an identity for a specific entity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:identity-document> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-document"@en ;
  skos:altLabel "identity document"@en ;
  skos:altLabel "identity documents"@en ;
  skos:definition "A physical or digital document containing identity data. A credential is a specialized form of identity document. Birth certificates, bank statements, and utility bills can all be considered identity documents."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:identity-proofing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-proofing"@en ;
  skos:altLabel "identity proofing"@en ;
  skos:altLabel "identity proof"@en ;
  skos:altLabel "identity proofs"@en ;
  skos:definition "The process of a party gathering sufficient identity data to establish an identity for a particular subject at a particular identity assurance level."@en ;
  skos:related <urn:tig:concept:identity-binding> .

<urn:tig:concept:identity-provider> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity-provider"@en ;
  skos:altLabel "identity provider"@en ;
  skos:altLabel "identity providers"@en ;
  skos:altLabel "IdP"@en ;
  skos:altLabel "IdPs"@en ;
  skos:definition "An identity provider (abbreviated IdP or IDP) is a system entity that creates, maintains, and manages identity information for principals and also provides authentication services to relying applications within a federation or distributed network."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> .

<urn:tig:concept:identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "identity"@en ;
  skos:altLabel "identities"@en ;
  skos:definition "A collection of attributes or other identity data that describe an entity and enable it to be distinguished from all other entities within a specific scope of identification. Identity attributes may include one or more identifiers for an entity, however it is possible to establish an identity without using identifiers."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:idp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "idp"@en ;
  skos:altLabel "IDP"@en ;
  skos:definition "See: identity provider."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:impersonation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "impersonation"@en ;
  skos:altLabel "impersonate"@en ;
  skos:altLabel "impersonates"@en ;
  skos:altLabel "impersonated"@en ;
  skos:definition "In the context of cybersecurity, impersonation is when an attacker pretends to be another person in order to commit fraud or some other digital crime."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:information-theoretic-security> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "information-theoretic-security"@en ;
  skos:altLabel "information-theoretic security"@en ;
  skos:definition "the highest level of cryptographic security concerning a cryptographic secret (seed, salt, or private key)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:integrity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "integrity"@en ;
  skos:definition "- General IT: [[xref:toip2, integrity]] and KERI specific: [[xref:keri1, integrity]]"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:interaction-context> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "interaction context"@en ;
  skos:altLabel "interaction-context"@en ;
  skos:definition "A session-level governance envelope that groups related tasks, messages, authority, evidence, and trust decisions across a sequence of interactions."@en ;
  skos:related <urn:tig:concept:trust-context> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:interaction-task> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "interaction task"@en ;
  skos:altLabel "interaction-task"@en ;
  skos:definition "A durable work unit with governance-significant state transitions, artifact accumulation, continuation or cancellation semantics, and evidence obligations."@en ;
  skos:related <urn:tig:concept:trust-task> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:intermediary-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "intermediary-system"@en ;
  skos:altLabel "intermediary system"@en ;
  skos:altLabel "intermediary systems"@en ;
  skos:altLabel "intermediary"@en ;
  skos:altLabel "intermediaries"@en ;
  skos:definition "An intermediary system routes messages between endpoint systems but is not otherwise involved in the processing of those messages. In the context of end-to-end encryption, intermediary systems cannot decrypt the messages sent between the endpoint systems. In the ToIP stack, intermediary systems operate at ToIP Layer 2, the trust spanning layer. An intermediary system is one of three types of systems defined in the ToIP Technology Architecture Specification; the other two are endpoint systems and supporting systems."@en ;
  skos:related <urn:tig:concept:endpoint-system> ;
  skos:related <urn:tig:concept:supporting-system> .

<urn:tig:concept:internet-protocol-suite> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "internet-protocol-suite"@en ;
  skos:altLabel "Internet protocol suite"@en ;
  skos:definition "The Internet protocol suite, commonly known as TCP/IP, is a framework for organizing the set of communication protocols used in the Internet and similar computer networks according to functional criteria. The foundational protocols in the suite are the Transmission Control Protocol (TCP), the User Datagram Protocol (UDP), and the Internet Protocol (IP)."@en ;
  skos:related <urn:tig:concept:protocol-stack> .

<urn:tig:concept:internet-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "internet-protocol"@en ;
  skos:altLabel "Internet Protocol"@en ;
  skos:definition "The Internet Protocol (IP) is the network layer communications protocol in the Internet protocol suite (also known as the TCP/IP suite) for relaying datagrams across network boundaries. Its routing function enables internetworking, and essentially establishes the Internet. IP has the task of delivering packets from the source host to the destination host solely based on the IP addresses in the packet headers. For this purpose, IP defines packet structures that encapsulate the data to be delivered. It also defines addressing methods that are used to label the datagram with source and destination information."@en ;
  skos:related <urn:tig:concept:tcp-ip> ;
  skos:related <urn:tig:concept:user-datagram-protocol> ;
  skos:related <urn:tig:concept:ip-address> ;
  skos:related <urn:tig:concept:internet-protocol-suite> .

<urn:tig:concept:interoperability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "interoperability"@en ;
  skos:definition "The ability of independently developed systems or components to work together correctly within an explicitly defined scope."@en ;
  skos:related <urn:tig:concept:trust-registry-protocol> ;
  skos:related <urn:tig:concept:conformance> .

<urn:tig:concept:ip-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ip-address"@en ;
  skos:altLabel "IP address"@en ;
  skos:altLabel "IP addresses"@en ;
  skos:definition "An Internet Protocol address (IP address) is a numerical label such as 192.0.2.1 that is connected to a computer network that uses the Internet Protocol for communication. An IP address serves two main functions: network interface identification, and location addressing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:ip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ip"@en ;
  skos:altLabel "IP"@en ;
  skos:definition "See: Internet Protocol."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:issuance-request> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "issuance-request"@en ;
  skos:altLabel "issuance request"@en ;
  skos:altLabel "issuance requests"@en ;
  skos:definition "A protocol request invoked by the holder of a digital wallet to obtain a digital credential from an issuer."@en ;
  skos:related <urn:tig:concept:presentation-request> .

<urn:tig:concept:issuance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "issuance"@en ;
  skos:altLabel "issue"@en ;
  skos:altLabel "issues"@en ;
  skos:altLabel "issued"@en ;
  skos:altLabel "issuing"@en ;
  skos:definition "The action of an issuer producing and transmitting a digital credential to a holder. A holder may request issuance by submitting an issuance request."@en ;
  skos:related <urn:tig:concept:presentation> ;
  skos:related <urn:tig:concept:revocation> .

<urn:tig:concept:issuer-concealment> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "issuer concealment"@en ;
  skos:altLabel "issuer-concealment"@en ;
  skos:definition "A privacy property in which a proof or presentation does not disclose the identity of the issuer to the verifier, subject to the requirements and trust model of the applicable profile."@en ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:privacy-policy> ;
  skos:related <urn:tig:concept:zero-knowledge-proof> .

<urn:tig:concept:issuer-metadata> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "issuer-metadata"@en ;
  skos:altLabel "credential issuer metadata"@en ;
  skos:altLabel "issuer metadata"@en ;
  skos:definition "Metadata published by a credential issuer describing issuer capabilities, credential configurations, endpoints, and supported formats."@en ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:openid4vci> ;
  skos:related <urn:tig:concept:credential-schema> ;
  skos:related <urn:tig:concept:digital-wallet> .

<urn:tig:concept:issuer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "issuer"@en ;
  skos:altLabel "issuers"@en ;
  skos:definition "A role an agent performs to assert a set of claims, package and digitally sign them, typically in the form of a digital credential, and transmit them to a holder under applicable policy and governance constraints."@en ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:holder> .

<urn:tig:concept:itps> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "itps"@en ;
  skos:altLabel "ITPS"@en ;
  skos:definition "information-theoretic-security"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:jurisdiction> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "jurisdiction"@en ;
  skos:altLabel "jurisdictions"@en ;
  skos:definition "The composition of: a) a legal system (legislation, enforcement thereof, and conflict resolution), b) a party that governs that legal system, c) a scope within which that legal system is operational, and d) one or more objectives for the purpose of which the legal system is operated."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:kate> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "kate"@en ;
  skos:altLabel "KATE"@en ;
  skos:definition "See: keys-at-the-edge."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:keri> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "keri"@en ;
  skos:altLabel "KERI"@en ;
  skos:definition "See: Key Event Receipt Infrastructure."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key-binding-jwt> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-binding-jwt"@en ;
  skos:altLabel "KB-JWT"@en ;
  skos:altLabel "Key Binding JWT"@en ;
  skos:definition "A JWT used to demonstrate holder control of a key associated with an SD-JWT or SD-JWT VC presentation."@en ;
  skos:related <urn:tig:concept:holder-binding> ;
  skos:related <urn:tig:concept:sd-jwt-vc> ;
  skos:related <urn:tig:concept:proof-of-possession> ;
  skos:related <urn:tig:concept:cryptographic-key> .

<urn:tig:concept:key-establishment> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-establishment"@en ;
  skos:altLabel "key establishment"@en ;
  skos:definition "A process that results in the sharing of a key between two or more entities, either by transporting a key from one entity to another (key transport) or generating a key from information shared by the entities (key agreement)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key-event-log> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-event-log"@en ;
  skos:altLabel "key event log"@en ;
  skos:altLabel "key event logs"@en ;
  skos:definition "An ordered sequence of records of key events."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key-event-receipt-infrastructure> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-event-receipt-infrastructure"@en ;
  skos:altLabel "Key Event Receipt Infrastructure"@en ;
  skos:definition "A decentralized permissionless key management architecture."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key-event> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-event"@en ;
  skos:altLabel "key event"@en ;
  skos:altLabel "key events"@en ;
  skos:definition "An event in the history of the usage of a cryptographic key pair. There are multiple types of key events. The inception event is when the key pair is first generated. A rotation event is when the key pair is changed to a new key pair. In some key management systems (such as KERI), key events are tracked in a key event log."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key-management-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key-management-system"@en ;
  skos:altLabel "key management system"@en ;
  skos:altLabel "key management systems"@en ;
  skos:altLabel "key management"@en ;
  skos:altLabel "KMS"@en ;
  skos:altLabel "KMSs"@en ;
  skos:definition "A system for the management of cryptographic keys and their metadata (e.g., generation, distribution, storage, backup, archive, recovery, use, revocation, and destruction). An automated key management system may be used to oversee, automate, and secure the key management process. A key management is often protected by implementing it within the trusted execution environment (TEE) of a device. An example is the Secure Enclave on Apple iOS devices."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:key> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "key"@en ;
  skos:altLabel "keys"@en ;
  skos:altLabel "key pair"@en ;
  skos:altLabel "key pairs"@en ;
  skos:definition "See: cryptographic key."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:keys-at-the-edge> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "keys-at-the-edge"@en ;
  skos:definition "A key management architecture in which keys are stored on a user’s local edge devices, such as a smartphone, tablet, or laptop, and then used in conjunction with a secure protocol to unlock a key management system (KMS) and/or a digital vault in the cloud. This approach can enable the storage and sharing of large data structures that are not feasible on edge devices. This architecture can also be used in conjunction with confidential computing to enable cloud-based digital agents to safely carry out “user not present” operations."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:kms> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "kms"@en ;
  skos:altLabel "KMS"@en ;
  skos:definition "See: key management system."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:knowledge> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "knowledge"@en ;
  skos:definition "The (intangible) sum of what is known by a specific party, as well as the familiarity, awareness or understanding of someone or something by that party."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:laws-of-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "laws-of-identity"@en ;
  skos:altLabel "Laws of Identity"@en ;
  skos:definition "A set of seven “laws” written by Kim Cameron, former Chief Identity Architect of Microsoft (1941-2021), to describe the dynamics that cause digital identity systems to succeed or fail in various contexts. His goal was to define the requirements for a unifying identity metasystem that can offer the Internet the identity layer it needs."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:layer-1> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "layer-1"@en ;
  skos:altLabel "Layer 1"@en ;
  skos:definition "See: ToIP Layer 1."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:layer-2> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "layer-2"@en ;
  skos:altLabel "Layer 2"@en ;
  skos:definition "See: ToIP Layer 2."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:layer-3> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "layer-3"@en ;
  skos:altLabel "Layer 3"@en ;
  skos:definition "See: ToIP Layer 3."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:layer-4> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "layer-4"@en ;
  skos:altLabel "Layer 4"@en ;
  skos:definition "See: ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:legal-entity-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legal-entity-identifier"@en ;
  skos:altLabel "Legal Entity Identifier"@en ;
  skos:altLabel "Legal Entity Identifiers"@en ;
  skos:altLabel "LEI"@en ;
  skos:altLabel "LEIs"@en ;
  skos:definition "The Legal Entity Identifier (LEI) is a unique global identifier for legal entities participating in financial transactions. Also known as an LEI code or LEI number, its purpose is to help identify legal entities on a globally accessible database. Legal entities are organisations such as companies or government entities that participate in financial transactions."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:legal-entity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legal-entity"@en ;
  skos:altLabel "legal entity"@en ;
  skos:altLabel "legal entities"@en ;
  skos:definition "An entity that is not a natural person but is recognized as having legal rights and responsibilities. Examples include corporations, partnerships, sole proprietorships, non-profit organizations, associations, and governments. (In some cases even natural systems such as rivers are treated as legal entities.)"@en ;
  skos:related <urn:tig:concept:legal-entity-identifier> ;
  skos:related <urn:tig:concept:legal-person> ;
  skos:related <urn:tig:concept:organization> .

<urn:tig:concept:legal-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legal-identity"@en ;
  skos:altLabel "legal identity"@en ;
  skos:altLabel "legal identities"@en ;
  skos:definition "A set of identity data considered authoritative to identify a party for purposes of legal accountability under one or more jurisdictions."@en ;
  skos:related <urn:tig:concept:foundational-identity> ;
  skos:related <urn:tig:concept:functional-identity> .

<urn:tig:concept:legal-person> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legal-person"@en ;
  skos:altLabel "legal person"@en ;
  skos:altLabel "legal persons"@en ;
  skos:definition "In law, a legal person is any person or 'thing' that can do the things a human person is usually able to do in law – such as enter into contracts, sue and be sued, own property, and so on.<sup>\\[3\\]\\[4\\]\\[5\\]</sup> The reason for the term \"legal person\" is that some legal persons are not people: companies and corporations are \"persons\" legally speaking (they can legally do most of the things an ordinary person can do), but they are not people in a literal sense (human beings)."@en ;
  skos:related <urn:tig:concept:legal-entity> ;
  skos:related <urn:tig:concept:organization> .

<urn:tig:concept:legal-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legal-system"@en ;
  skos:altLabel "legal system"@en ;
  skos:altLabel "legal systems"@en ;
  skos:definition "A system in which policies and rules are defined, and mechanisms for their enforcement and conflict resolution are (implicitly or explicitly) specified. Legal systems are not just defined by governments; they can also be defined by a governance framework."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:legitimacy-gap> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legitimacy gap"@en ;
  skos:altLabel "legitimacy-gap"@en ;
  skos:definition "A mismatch between an action or decision that a system can technically execute and the authority, recognition, consent, or governance basis required for that action to be legitimate."@en ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:governance> .

<urn:tig:concept:legitimized-human-meaningful-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "legitimized-human-meaningful-identifier"@en ;
  skos:altLabel "legitimized human-meaningful identifier"@en ;
  skos:definition "An AID and its associated self-certifying trust basis gives rise to a trust domain for associated cryptographically verifiable non-repudiable statements. Every other type of identifier including human meaningful identifiers may then be secured in this resultant trust domain via an end-verifiable authorization. This authorization legitimizes that human meaningful identifier as an LID through its association with an AID. The result is a secured trust domain specific identifier couplet of aid|lid."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:lei> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "lei"@en ;
  skos:altLabel "LEI"@en ;
  skos:definition "See: Legal Entity Identifier."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:level-of-assurance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "level-of-assurance"@en ;
  skos:altLabel "level of assurance"@en ;
  skos:altLabel "levels of assurance"@en ;
  skos:altLabel "LOA"@en ;
  skos:altLabel "LOAs"@en ;
  skos:definition "See: assurance level."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:lid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "lid"@en ;
  skos:altLabel "LID"@en ;
  skos:definition "legitimized-human-meaningful-identifier"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:liveness-detection> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "liveness-detection"@en ;
  skos:altLabel "liveness detection"@en ;
  skos:definition "Any technique used to detect a presentation attack by determining whether the source of a biometric sample is a live human being or a fake representation. This is typically accomplished using algorithms that analyze biometric sensor data to detect whether the source is live or reproduced."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:locus-of-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "locus-of-control"@en ;
  skos:altLabel "locus of control"@en ;
  skos:definition "The set of computing systems under a party’s direct control, where messages and data do not cross trust boundaries."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:machine-readable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "machine-readable"@en ;
  skos:altLabel "machine-readability"@en ;
  skos:definition "Information written in a computer language or expression language so that it can be read and processed by a computing device."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:man-made-thing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "man-made-thing"@en ;
  skos:altLabel "man-made thing"@en ;
  skos:altLabel "man-made things"@en ;
  skos:definition "Athing generated by human activity of some kind. Man-made things include both active things, such as cars or drones, and passive things, such as chairs or trousers."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:mandatory> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "mandatory"@en ;
  skos:definition "A requirement that must be implemented in order for an implementer to be in compliance. In ToIP governance frameworks, a mandatory requirement is expressed using a MUST or REQUIRED keyword as defined in IETF RFC 2119."@en ;
  skos:related <urn:tig:concept:recommended> ;
  skos:related <urn:tig:concept:optional> .

<urn:tig:concept:manifest-consumer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "manifest-consumer"@en ;
  skos:altLabel "C2PA manifest consumer"@en ;
  skos:altLabel "manifest consumer"@en ;
  skos:definition "An actor that consumes an asset with an associated C2PA manifest to obtain and evaluate provenance data."@en ;
  skos:related <urn:tig:concept:c2pa-manifest> ;
  skos:related <urn:tig:concept:content-credential> ;
  skos:related <urn:tig:concept:validation> ;
  skos:related <urn:tig:concept:provenance> .

<urn:tig:concept:message> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "message"@en ;
  skos:altLabel "messages"@en ;
  skos:definition "A discrete unit of communication intended by the source for consumption by some recipient or group of recipients."@en ;
  skos:related <urn:tig:concept:toip-message> ;
  skos:related <urn:tig:concept:verifiable-message> .

<urn:tig:concept:metadata> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "metadata"@en ;
  skos:definition "Information describing the characteristics of data including, for example, structural metadata describing data structures (e.g., data format, syntax, and semantics) and descriptive metadata describing data contents (e.g., information security labels)."@en ;
  skos:related <urn:tig:concept:communication-metadata> .

<urn:tig:concept:mobile-deep-link> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "mobile-deep-link"@en ;
  skos:altLabel "mobile deep link"@en ;
  skos:altLabel "mobile deep links"@en ;
  skos:altLabel "mobile deep linking"@en ;
  skos:definition "In the context of mobile apps, deep linking consists of using a uniform resource identifier (URI) that links to a specific location within a mobile app rather than simply launching the app. Deferred deep linking allows users to deep link to content even if the app is not already installed. Depending on the mobile device platform, the URI required to trigger the app may be different."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:monotonic-attenuation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "monotonic attenuation"@en ;
  skos:altLabel "monotonic-attenuation"@en ;
  skos:definition "The delegation invariant that authority may remain unchanged or become narrower at each delegation hop but must never expand beyond the parent grant."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:scope> .

<urn:tig:concept:mpc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "mpc"@en ;
  skos:altLabel "MPC"@en ;
  skos:definition "See: multi-party computation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:multi-party-computation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "multi-party-computation"@en ;
  skos:altLabel "multi-party computation"@en ;
  skos:definition "Secure multi-party computation (also known as secure computation, multi-party computation (MPC) or privacy-preserving computation) is a subfield of cryptography with the goal of creating methods for parties to jointly compute a function over their inputs while keeping those inputs private. Unlike traditional cryptographic tasks, where cryptography assures security and integrity of communication or storage and the adversary is outside the system of participants (an eavesdropper on the sender and receiver), the cryptography in this model protects participants' privacy from each other."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:multi-party-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "multi-party-control"@en ;
  skos:altLabel "multi-party control"@en ;
  skos:definition "A variant of multi-party computation where multiple parties must act in concert to meet a control requirement without revealing each other’s data. All parties are privy to the output of the control, but no party learns anything about the others."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:multi-signature> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "multi-signature"@en ;
  skos:altLabel "multi-sig"@en ;
  skos:definition "A cryptographic signature scheme where the process of signing information (e.g., a transaction) is distributed among multiple private keys."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:multicast-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "multicast-address"@en ;
  skos:altLabel "multicast address"@en ;
  skos:altLabel "multicast addresses"@en ;
  skos:definition "A multicast address is a logical identifier for a group of hosts in a computer network that are available to process datagrams or frames intended to be multicast for a designated network service."@en ;
  skos:related <urn:tig:concept:broadcast-address> ;
  skos:related <urn:tig:concept:unicast-address> .

<urn:tig:concept:multicast> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "multicast"@en ;
  skos:definition "In computer networking, multicast is group communication where data transmission is addressed (using a multicast address) to a group of destination computers simultaneously. Multicast can be one-to-many or many-to-many distribution. Multicast should not be confused with physical layer point-to-multipoint communication."@en ;
  skos:related <urn:tig:concept:anycast> ;
  skos:related <urn:tig:concept:broadcast> ;
  skos:related <urn:tig:concept:unicast> .

<urn:tig:concept:natural-person> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "natural-person"@en ;
  skos:altLabel "natural person"@en ;
  skos:altLabel "natural persons"@en ;
  skos:definition "A person (in legal meaning, one who has its own legal personality) that is an individual human being, as distinguished from the broader category of a legal person, which may refer to either a natural person or an organization of any kind."@en ;
  skos:related <urn:tig:concept:legal-entity> ;
  skos:related <urn:tig:concept:party> .

<urn:tig:concept:natural-thing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "natural-thing"@en ;
  skos:altLabel "natural thing"@en ;
  skos:altLabel "natural things"@en ;
  skos:definition "A thing that exists in the natural world independently of humans. Although natural things may form part of a man-made thing, natural things are mutually exclusive with man-made things."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:network-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "network-address"@en ;
  skos:altLabel "network address"@en ;
  skos:altLabel "network addresses"@en ;
  skos:definition "A network address is an identifier for a node or host on a telecommunications network. Network addresses are designed to be unique identifiers across the network, although some networks allow for local, private addresses, or locally administered addresses that may not be unique. Special network addresses are allocated as broadcast or multicast addresses. A network address designed to address a single device is called a unicast address."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:nist-csrc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "nist-csrc"@en ;
  skos:altLabel "NIST-CSRC"@en ;
  skos:definition "Abbreviation for the NIST Computer Security Resource Center Glossary."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:node> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "node"@en ;
  skos:altLabel "nodes"@en ;
  skos:definition "In telecommunications networks, a node (Latin: nodus, ‘knot’) is either a redistribution point or a communication endpoint. The definition of a node depends on the network and protocol layer referred to. A physical network node is an electronic device that is attached to a network, and is capable of creating, receiving, or transmitting information over a communication channel."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:non-custodial-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "non-custodial-wallet"@en ;
  skos:altLabel "non-custodial wallet"@en ;
  skos:altLabel "non-custodial wallets"@en ;
  skos:definition "A digital wallet that is directly in the control of the holder, usually because the holder is the device controller of the device hosting the digital wallet (smartcard, smartphone, tablet, laptop, desktop, car, etc.) A digital wallet that is in the custody of a third party is called a custodial wallet."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:non-repudiable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "non-repudiable"@en ;
  skos:altLabel "non repudiable"@en ;
  skos:definition "Non-repudiation refers to a situation where a statement's author **cannot successfully dispute** its authorship or the validity of an associated contract, signature or commitment."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:non-transferable-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "non-transferable-identifier"@en ;
  skos:definition "Controlling keys over this identifier cannot be rotated and therefore this identifier is non-transferable to other control."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:non-transferable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "non-transferable"@en ;
  skos:altLabel "non transferable"@en ;
  skos:definition "No transferable (the control over) a certain digital asset in an unobstructed or loss-less manner. As opposed to transferable."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:nullifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "nullifier"@en ;
  skos:definition "A cryptographically derived value used to detect prohibited reuse or duplication within a defined scope without revealing the underlying secret or necessarily enabling correlation across other scopes."@en ;
  skos:related <urn:tig:concept:zero-knowledge-proof> ;
  skos:related <urn:tig:concept:correlation-privacy> .

<urn:tig:concept:objective> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "objective"@en ;
  skos:altLabel "objectives"@en ;
  skos:definition "Something toward which a party (its owner) directs effort (an aim, goal, or end of action)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:observability-mode> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "observability mode"@en ;
  skos:altLabel "observability-mode"@en ;
  skos:definition "A descriptor for what can be known and evidenced about delivery, timing, progress, and user awareness for an interaction channel or execution path."@en ;
  skos:related <urn:tig:concept:audit-log> ;
  skos:related <urn:tig:concept:human-auditable> ;
  skos:related <urn:tig:concept:communication-channel> .

<urn:tig:concept:oobi> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "oobi"@en ;
  skos:altLabel "OOBI"@en ;
  skos:altLabel "OOBIs"@en ;
  skos:definition "See: out-of-band introduction."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:opacity-boundary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "opacity boundary"@en ;
  skos:altLabel "opacity-boundary"@en ;
  skos:definition "A declared limit on what can be observed about an agent or system and the resulting constraints on trust, evidence, assurance, and permitted reliance."@en ;
  skos:related <urn:tig:concept:trust-boundary> ;
  skos:related <urn:tig:concept:trust-assurance> .

<urn:tig:concept:openid-federation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "openid-federation"@en ;
  skos:altLabel "OpenID Federation"@en ;
  skos:definition "A federation framework for establishing trust among OpenID participants using entity statements, trust chains, and federation metadata."@en ;
  skos:related <urn:tig:concept:federation> ;
  skos:related <urn:tig:concept:trust-chain> ;
  skos:related <urn:tig:concept:entity-statement> ;
  skos:related <urn:tig:concept:trust-anchor> .

<urn:tig:concept:openid4vci> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "openid4vci"@en ;
  skos:altLabel "OpenID4VCI"@en ;
  skos:altLabel "OID4VCI"@en ;
  skos:definition "An OpenID Foundation protocol that defines OAuth 2.0-based mechanisms for issuing verifiable credentials from credential issuers to wallets."@en ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:credential-offer> ;
  skos:related <urn:tig:concept:credential-request> ;
  skos:related <urn:tig:concept:digital-wallet> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:openid4vp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "openid4vp"@en ;
  skos:altLabel "OpenID4VP"@en ;
  skos:altLabel "OID4VP"@en ;
  skos:definition "An OpenID Foundation protocol that defines mechanisms for requesting and presenting credentials between wallets and verifiers."@en ;
  skos:related <urn:tig:concept:presentation> ;
  skos:related <urn:tig:concept:presentation-request> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:vp-token> ;
  skos:related <urn:tig:concept:digital-wallet> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:openwallet-foundation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "openwallet-foundation"@en ;
  skos:altLabel "OpenWallet Foundation"@en ;
  skos:definition "A non-profit project of the Linux Foundation chartered to build a world-class open source wallet engine."@en ;
  skos:related <urn:tig:concept:decentralized-identity-foundation> ;
  skos:related <urn:tig:concept:toip-foundation> .

<urn:tig:concept:operational-circumstances> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "operational-circumstances"@en ;
  skos:altLabel "operational circumstances"@en ;
  skos:definition "In the context of privacy protection, this term denotes the context in which privacy trade-off decisions are made. It includes the regulatory environment and other non-technical factors that bear on what reasonable privacy expectations might be."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:optional> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "optional"@en ;
  skos:definition "A requirement that is not mandatory or recommended to implement in order for an implementer to be in compliance, but which is left to the implementer’s choice. In ToIP governance frameworks, an optional requirement is expressed using a MAY or OPTIONAL keyword as defined in IETF RFC 2119."@en ;
  skos:related <urn:tig:concept:mandatory> ;
  skos:related <urn:tig:concept:recommended> .

<urn:tig:concept:organization> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "organization"@en ;
  skos:altLabel "organizations"@en ;
  skos:altLabel "organisation"@en ;
  skos:altLabel "organisations"@en ;
  skos:definition "A party that consists of a group of parties who agree to be organized into a specific form in order to better achieve a common set of objectives. Examples include corporations, partnerships, sole proprietorships, non-profit organizations, associations, and governments."@en ;
  skos:related <urn:tig:concept:legal-entity> ;
  skos:related <urn:tig:concept:legal-person> .

<urn:tig:concept:organizational-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "organizational-authority"@en ;
  skos:altLabel "organizational authority"@en ;
  skos:altLabel "organisational authority"@en ;
  skos:definition "A type of authority where the party asserting its right is an organization."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:out-of-band-introduction> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "out-of-band-introduction"@en ;
  skos:altLabel "out-of-band introduction"@en ;
  skos:altLabel "out-of-band introductions"@en ;
  skos:altLabel "OOBI"@en ;
  skos:altLabel "OOBIs"@en ;
  skos:definition "A process by which two or more entities exchange VIDs in order to form a cryptographically verifiable connection (e.g., a ToIP connection), such as by scanning a QR code (in person or remotely) or clicking a deep link."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:owner> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "owner"@en ;
  skos:altLabel "owners"@en ;
  skos:definition "The role that a party performs when it is exercising its legal, rightful or natural title to control a specific entity."@en ;
  skos:related <urn:tig:concept:controller> .

<urn:tig:concept:p2p> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "p2p"@en ;
  skos:altLabel "P2P"@en ;
  skos:definition "See: peer-to-peer."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:packet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "packet"@en ;
  skos:altLabel "packets"@en ;
  skos:definition "The logical unit of network communications produced by the transport layer."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "party"@en ;
  skos:altLabel "parties"@en ;
  skos:definition "An entity that sets its objectives, maintains its knowledge, and uses that knowledge to pursue its objectives in an autonomous (sovereign) manner. Natural persons and organizations are the typical examples."@en ;
  skos:related <urn:tig:concept:first-party> ;
  skos:related <urn:tig:concept:second-party> ;
  skos:related <urn:tig:concept:third-party> .

<urn:tig:concept:password> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "password"@en ;
  skos:altLabel "passwords"@en ;
  skos:definition "A string of characters (letters, numbers and other symbols) that are used to authenticate an identity, verify access authorization or derive cryptographic keys."@en ;
  skos:related <urn:tig:concept:complex-password> .

<urn:tig:concept:peer-to-peer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "peer-to-peer"@en ;
  skos:definition "Peer-to-peer (P2P) computing or networking is a distributed application architecture that partitions tasks or workloads between peers. Peers are equally privileged, equipotent participants in the network. This forms a peer-to-peer network of nodes."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:peer-trust-relation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "peer trust relation"@en ;
  skos:altLabel "peer-trust-relation"@en ;
  skos:definition "A lateral trust relationship between parties that do not hold hierarchical authority over one another and that rely on an explicit trust basis such as credential exchange, policy acceptance, or third-party introduction."@en ;
  skos:related <urn:tig:concept:trust-relationship> ;
  skos:related <urn:tig:concept:counterparty> ;
  skos:related <urn:tig:concept:delegation> .

<urn:tig:concept:peer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "peer"@en ;
  skos:altLabel "peers"@en ;
  skos:definition "In the context of digital networks, an actor on the network that has the same status, privileges, and communications options as the other actors on the network."@en ;
  skos:related <urn:tig:concept:peer-to-peer> .

<urn:tig:concept:permission> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "permission"@en ;
  skos:altLabel "permissions"@en ;
  skos:definition "Authorization to perform some action on a system."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> ;
  skos:related <urn:tig:concept:access-control> ;
  skos:related <urn:tig:concept:revocation> .

<urn:tig:concept:persistent-connection> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "persistent-connection"@en ;
  skos:altLabel "persistent connection"@en ;
  skos:altLabel "persistent connections"@en ;
  skos:definition "A connection that is able to persist across multiple communication sessions. In a ToIP context, a persistent connection is established when two ToIP endpoints exchange verifiable identifiers (VIDs) that they can use to re-establish the connection with each other whenever it is needed."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:persistent-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "persistent-identifier"@en ;
  skos:altLabel "persistent identifier"@en ;
  skos:definition "transferable-identifier"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:person> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "person"@en ;
  skos:altLabel "persons"@en ;
  skos:definition "See natural person."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:personal-data-store> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personal-data-store"@en ;
  skos:altLabel "personal data store"@en ;
  skos:altLabel "personal data stores"@en ;
  skos:altLabel "PDS"@en ;
  skos:altLabel "PDSs"@en ;
  skos:definition "See: personal data vault."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:personal-data-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personal-data-vault"@en ;
  skos:altLabel "personal data vault"@en ;
  skos:altLabel "personal data vaults"@en ;
  skos:definition "A digital vault whose controller is a natural person."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:personal-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personal-data"@en ;
  skos:altLabel "personal data"@en ;
  skos:definition "Any information relating to an identified or identifiable natural person (called a data subject under GDPR)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:personal-wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personal-wallet"@en ;
  skos:altLabel "personal wallet"@en ;
  skos:altLabel "personal wallets"@en ;
  skos:definition "A digital wallet whose holder is a natural person."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:personally-identifiable-information> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personally-identifiable-information"@en ;
  skos:altLabel "personally identifiable information"@en ;
  skos:altLabel "PII"@en ;
  skos:definition "Information (any form of data) that can be used to directly or indirectly identify or re-identify an individual person either singly or in combination within a single record or in correlation with other records. This information can be one or more attributes/fields/properties in a record (e.g., date-of-birth) or one or more records (e.g., medical records)."@en ;
  skos:related <urn:tig:concept:personal-data> ;
  skos:related <urn:tig:concept:sensitive-data> .

<urn:tig:concept:personhood> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "personhood"@en ;
  skos:definition "The status or quality of being treated as a person for a defined social, legal, governance, or technical purpose; it is not equivalent to civil identity or the possession of an identifier."@en ;
  skos:related <urn:tig:concept:proof-of-personhood> ;
  skos:related <urn:tig:concept:identity> ;
  skos:related <urn:tig:concept:natural-person> .

<urn:tig:concept:physical-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "physical-credential"@en ;
  skos:altLabel "physical credential"@en ;
  skos:altLabel "physical credentials"@en ;
  skos:definition "A credential in a physical form such as paper, plastic, or metal."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:pid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pid"@en ;
  skos:altLabel "Person Identification Data"@en ;
  skos:altLabel "PID"@en ;
  skos:definition "A set of identity attributes used in the EUDI Wallet ecosystem to identify a natural or legal person under the applicable legal and governance framework."@en ;
  skos:related <urn:tig:concept:eudi-wallet> ;
  skos:related <urn:tig:concept:identity-data> ;
  skos:related <urn:tig:concept:natural-person> ;
  skos:related <urn:tig:concept:legal-person> .

<urn:tig:concept:pii> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pii"@en ;
  skos:altLabel "PII"@en ;
  skos:definition "See: personally identifiable information."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:pki> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pki"@en ;
  skos:altLabel "PKI"@en ;
  skos:definition "See: public key infrastructure."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:plaintext> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "plaintext"@en ;
  skos:altLabel "plaintexts"@en ;
  skos:definition "Unencrypted information that may be input to an encryption operation. Once encrypted, it becomes ciphertext."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:policy-enforcement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "policy enforcement"@en ;
  skos:altLabel "policy-enforcement"@en ;
  skos:definition "The application of an applicable policy at a decision or execution point so that required, allowed, deferred, or prohibited outcomes are actually carried out."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:access-control> .

<urn:tig:concept:policy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "policy"@en ;
  skos:altLabel "policies"@en ;
  skos:definition "Statements, rules, or assertions that specify required, permitted, prohibited, or expected behavior of an entity within a defined scope. Policies may be human-readable, machine-readable, or both, and may be interpreted, enforced, or audited by people, software, or both."@en ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governance-requirement> ;
  skos:related <urn:tig:concept:rule> .

<urn:tig:concept:pop> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pop"@en ;
  skos:altLabel "PoP"@en ;
  skos:definition "See: proof of personhood."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:portable-assurance-pattern> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "portable assurance pattern"@en ;
  skos:altLabel "portable-assurance-pattern"@en ;
  skos:definition "A reusable, implementation-neutral description of an assurance concern, control, test, evidence expectation, or review pattern that can be applied across different deployments."@en ;
  skos:related <urn:tig:concept:assurance-level> ;
  skos:related <urn:tig:concept:evidence-bundle> .

<urn:tig:concept:predicate-proof> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "predicate proof"@en ;
  skos:altLabel "predicate-proof"@en ;
  skos:definition "A proof that establishes whether a defined condition about one or more attributes is satisfied without necessarily disclosing the underlying attribute values."@en ;
  skos:related <urn:tig:concept:zero-knowledge-proof> ;
  skos:related <urn:tig:concept:selective-disclosure> ;
  skos:related <urn:tig:concept:claim> .

<urn:tig:concept:presentation-attack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "presentation-attack"@en ;
  skos:altLabel "presentation attack"@en ;
  skos:altLabel "presentation attacks"@en ;
  skos:definition "A type of cybersecurity attack in which the attacker attempts to defeat a biometric liveness detection system by providing false inputs."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:presentation-request> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "presentation-request"@en ;
  skos:altLabel "presentation request"@en ;
  skos:altLabel "presentation requests"@en ;
  skos:definition "A protocol request sent by the verifier to the holder of a digital wallet to request a presentation."@en ;
  skos:related <urn:tig:concept:issuance-request> .

<urn:tig:concept:presentation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "presentation"@en ;
  skos:altLabel "presentations"@en ;
  skos:altLabel "present"@en ;
  skos:altLabel "presents"@en ;
  skos:altLabel "presenting"@en ;
  skos:altLabel "presented"@en ;
  skos:definition "A verifiable message that a holder may send to a verifier containing proofs of one or more claims derived from one or more digital credentials from one or more issuers as a response to a specific presentation request from a  verifier."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:pressure-test> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pressure test"@en ;
  skos:altLabel "pressure-test"@en ;
  skos:definition "A structured review that challenges a specification, policy, design, or system with adverse scenarios to identify risks, harms, control gaps, and weak assumptions."@en ;
  skos:related <urn:tig:concept:risk-assessment> ;
  skos:related <urn:tig:concept:assurance-level> .

<urn:tig:concept:primary-document> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "primary-document"@en ;
  skos:altLabel "primary document"@en ;
  skos:altLabel "primary documents"@en ;
  skos:definition "The governance document at the root of a governance framework. The primary document specifies the other controlled documents in the governance framework."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:principal> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "principal"@en ;
  skos:altLabel "principals"@en ;
  skos:definition "The party for whom, or on behalf of whom, an actor is executing an action (this actor is then called an agent of that party)."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:principles-of-ssi> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "principles-of-ssi"@en ;
  skos:altLabel "Principles of SSI"@en ;
  skos:definition "A set of principles for self-sovereign identity systems originally defined by the Sovrin Foundation and republished by the ToIP Foundation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:privacy-policy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "privacy-policy"@en ;
  skos:altLabel "privacy policy"@en ;
  skos:altLabel "privacy policies"@en ;
  skos:definition "A statement or legal document (in privacy law) that discloses some or all of the ways a party gathers, uses, discloses, and manages a customer or client's data."@en ;
  skos:related <urn:tig:concept:security-policy> .

<urn:tig:concept:privacy-washing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "privacy-washing"@en ;
  skos:altLabel "privacy washing"@en ;
  skos:definition "De-identification so that it provides a personal data safe harbour and could be legally acceptable forwarded."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:private-key> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "private-key"@en ;
  skos:altLabel "private key"@en ;
  skos:altLabel "private keys"@en ;
  skos:definition "In public key cryptography, the cryptographic key which must be kept secret by the controller in order to maintain security."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:proof-carrying-commitment-receipt> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof-carrying commitment receipt"@en ;
  skos:altLabel "proof-carrying-commitment-receipt"@en ;
  skos:definition "A receipt that records a commitment together with cryptographic or verifiable evidence sufficient to evaluate who was authorized, what was committed, under which conditions, and with what lifecycle status."@en ;
  skos:related <urn:tig:concept:claim> ;
  skos:related <urn:tig:concept:proof> .

<urn:tig:concept:proof-of-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof-of-control"@en ;
  skos:altLabel "proof of control"@en ;
  skos:definition "See: proof of possession."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:proof-of-personhood> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof-of-personhood"@en ;
  skos:altLabel "proof of personhood"@en ;
  skos:definition "Proof of personhood (PoP) is a means of resisting malicious attacks on peer-to-peer networks, particularly, attacks that utilize multiple fake identities, otherwise known as a Sybil attack. Decentralized online platforms are particularly vulnerable to such attacks by their very nature, as notionally democratic and responsive to large voting blocks. In PoP, each unique human participant obtains one equal unit of voting power, and any associated rewards."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:proof-of-possession> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof-of-possession"@en ;
  skos:altLabel "proof of possession"@en ;
  skos:definition "A verification process whereby a level of assurance is obtained that the owner of a key pair actually controls the private key associated with the public key."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:proof-of-presence> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof-of-presence"@en ;
  skos:altLabel "proof of presence"@en ;
  skos:definition "See: liveness detection."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:proof> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "proof"@en ;
  skos:altLabel "proofs"@en ;
  skos:definition "A digital object that enables cryptographic verification of either: a) the claims from one or more digital credentials, or b) facts about claims that do not reveal the data  itself (e.g., proof of the subject being over/under a specific age without revealing a birthdate)."@en ;
  skos:related <urn:tig:concept:zero-knowledge-proof> .

<urn:tig:concept:property> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "property"@en ;
  skos:altLabel "properties"@en ;
  skos:definition "In the context of digital communication, an attribute of a digital object or data structure, such as a DID document or a schema."@en ;
  skos:related <urn:tig:concept:attribute> ;
  skos:related <urn:tig:concept:claim> .

<urn:tig:concept:protected-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "protected-data"@en ;
  skos:altLabel "protected data"@en ;
  skos:definition "Data that is not publicly available but requires some type of access control to gain access."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:protocol-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "protocol-layer"@en ;
  skos:altLabel "protocol layer"@en ;
  skos:altLabel "protocol layers"@en ;
  skos:definition "In modern protocol design, protocols are layered to form a protocol stack. Layering is a design principle that divides the protocol design task into smaller steps, each of which accomplishes a specific part, interacting with the other parts of the protocol only in a small number of well-defined ways. Layering allows the parts of a protocol to be designed and tested without a combinatorial explosion of cases, keeping each design relatively simple."@en ;
  skos:related <urn:tig:concept:hourglass-model> ;
  skos:related <urn:tig:concept:toip-stack> .

<urn:tig:concept:protocol-stack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "protocol-stack"@en ;
  skos:altLabel "protocol stack"@en ;
  skos:altLabel "protocol stacks"@en ;
  skos:definition "The protocol stack or network stack is an implementation of a computer networking protocol suite or protocol family. Some of these terms are used interchangeably but strictly speaking, the _suite_ is the definition of the communication protocols, and the _stack_ is the software implementation of them."@en ;
  skos:related <urn:tig:concept:protocol-layer> .

<urn:tig:concept:provenance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "provenance"@en ;
  skos:definition "Information about the origin, history, custody, transformation, or source lineage of data, content, credentials, or governed artifacts."@en ;
  skos:related <urn:tig:concept:c2pa-manifest> ;
  skos:related <urn:tig:concept:content-credential> ;
  skos:related <urn:tig:concept:audit-log> ;
  skos:related <urn:tig:concept:authenticity> .

<urn:tig:concept:pseudonym> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "pseudonym"@en ;
  skos:altLabel "pseudonyms"@en ;
  skos:altLabel "pseudonymous"@en ;
  skos:altLabel "pseudonymity"@en ;
  skos:definition "A pseudonym is a fictitious name that a person assumes for a particular purpose, which differs from their original or true name (orthonym). This also differs from a new name that entirely or legally replaces an individual's own. Many pseudonym holders use pseudonyms because they wish to remain anonymous, but anonymity is difficult to achieve and often fraught with legal issues."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> .

<urn:tig:concept:public-key-certificate> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "public-key-certificate"@en ;
  skos:altLabel "public key certificate"@en ;
  skos:altLabel "public key certificates"@en ;
  skos:altLabel "PKC"@en ;
  skos:altLabel "PKCs"@en ;
  skos:definition "A set of data that uniquely identifies a public key (which has a corresponding private key) and an owner that is authorized to use the key pair. The certificate contains the owner’s public key and possibly other information and is digitally signed by a certification authority (i.e., a trusted party), thereby binding the public key to the owner."@en ;
  skos:related <urn:tig:concept:public-key-infrastructure> .

<urn:tig:concept:public-key-cryptography> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "public-key-cryptography"@en ;
  skos:altLabel "public key cryptography"@en ;
  skos:definition "Public key cryptography, or asymmetric cryptography, is the field of cryptographic systems that use pairs of related keys. Each key pair consists of a public key and a corresponding private key. Key pairs are generated with cryptographic algorithms based on mathematical problems termed one-way functions. Security of public key cryptography depends on keeping the private key secret; the public key can be openly distributed without compromising security."@en ;
  skos:related <urn:tig:concept:public-key-infrastructure> .

<urn:tig:concept:public-key-infrastructure> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "public-key-infrastructure"@en ;
  skos:altLabel "public key infrastructure"@en ;
  skos:altLabel "public key infrastructures"@en ;
  skos:altLabel "PKI"@en ;
  skos:altLabel "PKIs"@en ;
  skos:definition "A set of policies, processes, server platforms, software and workstations used for the purpose of administering certificates and public-private key pairs, including the ability to issue, maintain, and revoke public key certificates. The PKI includes the hierarchy of certificate authorities that allow for the deployment of digital certificates that support encryption, digital signature and authentication to meet business and security requirements."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:role-based-access-control> ;
  skos:related <urn:tig:concept:attribute-based-access-control> .

<urn:tig:concept:public-key> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "public-key"@en ;
  skos:altLabel "public key"@en ;
  skos:altLabel "public keys"@en ;
  skos:definition "In public key cryptography, the cryptographic key that can be freely shared with anyone by the controller without compromising security. A party's public key must be verified as authoritative in order to verify their digital signature."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:qr-code> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "qr-code"@en ;
  skos:altLabel "QR code"@en ;
  skos:altLabel "QR codes"@en ;
  skos:definition "A QR code (short for \"quick-response code\") is a type of two-dimensional matrix barcode—a machine-readable optical image that contains information specific to the identified item. In practice, QR codes contain data for a locator, an identifier, and web tracking."@en ;
  skos:related <urn:tig:concept:out-of-band-introduction> .

<urn:tig:concept:qualified-electronic-attestation-of-attributes> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "qualified-electronic-attestation-of-attributes"@en ;
  skos:altLabel "QEAA"@en ;
  skos:altLabel "qualified attribute attestation"@en ;
  skos:definition "An attestation of attributes issued under qualified trust service rules in the European digital identity framework."@en ;
  skos:related <urn:tig:concept:attestation> ;
  skos:related <urn:tig:concept:eudi-wallet> ;
  skos:related <urn:tig:concept:trust-service-provider> ;
  skos:related <urn:tig:concept:credential> .

<urn:tig:concept:rbac> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "rbac"@en ;
  skos:altLabel "RBAC"@en ;
  skos:definition "See: role-based access control."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:real-world-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "real-world-identity"@en ;
  skos:altLabel "real world identity"@en ;
  skos:altLabel "real world identities"@en ;
  skos:definition "A term used to describe the opposite of digital identity, i.e., an identity (typically for a person) in the physical instead of the digital world."@en ;
  skos:related <urn:tig:concept:legal-identity> .

<urn:tig:concept:recognition> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "recognition"@en ;
  skos:definition "A governed decision to accept another party, authority, status, credential, assurance result, or rule as valid for a defined purpose and scope."@en ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:trust-decision> .

<urn:tig:concept:recommended> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "recommended"@en ;
  skos:definition "A requirement that is not mandatory to implement in order for an implementer to be in compliance, but which should be implemented unless the implementer has a good reason. In ToIP governance frameworks, a recommendation is expressed using a SHOULD or RECOMMENDED keyword as defined in IETF RFC 2119."@en ;
  skos:related <urn:tig:concept:mandatory> ;
  skos:related <urn:tig:concept:optional> .

<urn:tig:concept:record> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "record"@en ;
  skos:altLabel "records"@en ;
  skos:definition "A uniquely identifiable entry or listing in a database or registry."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:redress> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "redress"@en ;
  skos:definition "A governed path through which an affected party can challenge an outcome, seek correction or remedy, and obtain an accountable response."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:decision-receipt> .

<urn:tig:concept:registrant> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "registrant"@en ;
  skos:altLabel "registrants"@en ;
  skos:definition "The party submitting a registration record to a registry."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:registrar> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "registrar"@en ;
  skos:altLabel "registrars"@en ;
  skos:definition "The party who performs registration on behalf of a registrant."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:registration-agent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "registration-agent"@en ;
  skos:altLabel "registration agent"@en ;
  skos:definition "A party responsible for accepting registration requests and authenticating the registrant. The term may also apply to a party accepting issuance requests for digital credentials."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> .

<urn:tig:concept:registration> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "registration"@en ;
  skos:altLabel "registrations"@en ;
  skos:definition "The process by which a registrant submits a record to a registry."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:revocation> .

<urn:tig:concept:registry> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "registry"@en ;
  skos:altLabel "registries"@en ;
  skos:definition "A specialized database of records that serves as an authoritative source of information about entities."@en ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:relationship-context> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "relationship-context"@en ;
  skos:altLabel "relationship context"@en ;
  skos:altLabel "relationship contexts"@en ;
  skos:definition "A context established within the boundary of a trust relationship."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:relationship> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "relationship"@en ;
  skos:definition "See ToIP relationship."@en ;
  skos:related <urn:tig:concept:trust-relationship> .

<urn:tig:concept:relying-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "relying-party"@en ;
  skos:altLabel "relying party"@en ;
  skos:altLabel "relying parties"@en ;
  skos:definition "A party who accepts claims, credentials, trust graphs, or any other form of verifiable data from other parties (such as issuers, holders, trust registries, or other authoritative sources) in order to make a trust decision."@en ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:reputation-graph> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "reputation-graph"@en ;
  skos:altLabel "reputation graph"@en ;
  skos:altLabel "reputation graphs"@en ;
  skos:definition "A graph of the reputation relationships between different entities in a trust community. In a digital trust ecosystem, the governing body may be one trust anchor of a reputation graph. In some cases, a reputation graph can be traversed by making queries to one or more trust registries."@en ;
  skos:related <urn:tig:concept:authorization-graph> ;
  skos:related <urn:tig:concept:governance-graph> ;
  skos:related <urn:tig:concept:trust-graph> .

<urn:tig:concept:reputation-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "reputation-system"@en ;
  skos:altLabel "reputation system"@en ;
  skos:altLabel "reputation systems"@en ;
  skos:definition "Reputation systems are programs or algorithms that allow users to rate each other in online communities in order to build trust through reputation. Some common uses of these systems can be found on e-commerce websites such as eBay, Amazon.com, and Etsy as well as online advice communities such as Stack Exchange."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:reputation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "reputation"@en ;
  skos:altLabel "reputations"@en ;
  skos:definition "The beliefs or opinions that are generally held about an entity, typically developed as a result of social evaluation on a set of criteria, such as behavior, performance, or trustworthiness."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:reputational-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "reputational-trust"@en ;
  skos:altLabel "reputational trust"@en ;
  skos:definition "Established by a trusted party offering identity-assurance."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:requirement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "requirement"@en ;
  skos:altLabel "requirements"@en ;
  skos:definition "A specified condition or behavior to which a system needs to comply. Technical requirements are defined in technical specifications and implemented in computer systems to be executed by software actors. Governance requirements are defined in governance documents that specify policies and procedures to be executed by human actors. In ToIP specifications, requirements are expressed using the keywords defined in Internet RFC 2119."@en ;
  skos:related <urn:tig:concept:mandatory> ;
  skos:related <urn:tig:concept:recommended> ;
  skos:related <urn:tig:concept:optional> .

<urn:tig:concept:resolver> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "resolver"@en ;
  skos:definition "An entity or component that provides discovery for identifiers. A Resolver is the Controller of its own self-referential identifier which may not be the same as the identifier to which it is a Resolver."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:revocation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "revocation"@en ;
  skos:altLabel "revocations"@en ;
  skos:altLabel "revoke"@en ;
  skos:altLabel "revokes"@en ;
  skos:altLabel "revoked"@en ;
  skos:altLabel "revoking"@en ;
  skos:definition "In the context of digital credentials, revocation is an event or status change signifying that the issuer no longer attests to the validity of a credential it has issued. In the context of cryptographic keys, revocation is an event or status change signifying that the controller no longer attests to the validity of a public/private key pair for which the controller is authoritative."@en ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:presentation> .

<urn:tig:concept:risk-assessment> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "risk-assessment"@en ;
  skos:altLabel "risk assessment"@en ;
  skos:altLabel "risk assessments"@en ;
  skos:definition "The process of identifying risks to organizational operations (including mission, functions, image, reputation), organizational assets, individuals, other organizations, and the overall ecosystem, resulting from the operation of an information system. Risk assessment is part of risk management, incorporates threat and vulnerability analyses, and considers risk mitigations provided by security controls planned or in place."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:risk-decision> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "risk-decision"@en ;
  skos:altLabel "risk decision"@en ;
  skos:altLabel "risk decisions"@en ;
  skos:definition "See: trust decision."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:risk-management> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "risk-management"@en ;
  skos:altLabel "risk management"@en ;
  skos:definition "The process of managing risks to organizational operations (including mission, functions, image, or reputation), organizational assets, or individuals resulting from the operation of an information system, and includes: (i) the conduct of a risk assessment; (ii) the implementation of a risk mitigation strategy; and (iii) employment of techniques and procedures for the continuous monitoring of the security state of the information system."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:risk-mitigation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "risk-mitigation"@en ;
  skos:altLabel "risk mitigation"@en ;
  skos:altLabel "risk mitigations"@en ;
  skos:definition "Prioritizing, evaluating, and implementing the appropriate risk-reducing controls/countermeasures recommended from the risk management process."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:risk> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "risk"@en ;
  skos:altLabel "risks"@en ;
  skos:definition "The effects that uncertainty (i.e. a lack of information, understanding or knowledge of events, their consequences or likelihoods) can have on the intended realization of an objective of a party."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:role-based-access-control> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "role-based-access-control"@en ;
  skos:altLabel "role-based access control"@en ;
  skos:altLabel "role-based access controls"@en ;
  skos:definition "Access control based on user roles (i.e., a collection of access authorizations a user receives based on an explicit or implicit assumption of a given role). Role permissions may be inherited through a role hierarchy and typically reflect the permissions needed to perform defined functions within an organization. A given role may apply to a single individual or to several individuals."@en ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:permission> ;
  skos:related <urn:tig:concept:attribute-based-access-control> ;
  skos:related <urn:tig:concept:access-control> .

<urn:tig:concept:role-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "role-credential"@en ;
  skos:altLabel "role credential"@en ;
  skos:altLabel "role credentials"@en ;
  skos:definition "A credential claiming that the subject has a specific role."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:role> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "role"@en ;
  skos:altLabel "roles"@en ;
  skos:definition "A defined set of characteristics that an entity has in some context, such as responsibilities it may have, actions (behaviors) it may execute, or pieces of knowledge that it is expected to have in that context, which are referenced by a specific role name."@en ;
  skos:related <urn:tig:concept:role-credential> .

<urn:tig:concept:rotation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "rotation"@en ;
  skos:altLabel "rotation-event"@en ;
  skos:altLabel "key-rotation"@en ;
  skos:altLabel "rotation event"@en ;
  skos:altLabel "key rotation"@en ;
  skos:definition "a change of the key state, including a change to the set of authoritative key pairs for an identifier AID."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:router> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "router"@en ;
  skos:altLabel "routers"@en ;
  skos:definition "A router is a networking device that forwards data packets between computer networks. Routers perform the traffic directing functions between networks and on the global Internet. Data sent through a network, such as a web page or email, is in the form of data packets. A packet is typically forwarded from one router to another router through the networks that constitute an internetwork (e.g. the Internet) until it reaches its destination node. This process is called routing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:routing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "routing"@en ;
  skos:altLabel "routes"@en ;
  skos:altLabel "routed"@en ;
  skos:definition "Routing is the process of selecting a path for traffic in a network or between or across multiple networks. Broadly, routing is performed in many types of networks, including circuit-switched networks, such as the public switched telephone network (PSTN), and computer networks, such as the Internet. A router is a computing device that specializes in performing routing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:rule> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "rule"@en ;
  skos:altLabel "rules"@en ;
  skos:definition "A prescribed guide for conduct, process or action to achieve a defined result or objective. Rules may be human-readable or machine-readable or both."@en ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:runtime-authority-envelope> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "runtime authority envelope"@en ;
  skos:altLabel "runtime-authority-envelope"@en ;
  skos:definition "A runtime artifact that carries the currently valid authority, scope, constraints, delegation lineage, and status required before an action may be executed."@en ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:runtime-governance-envelope> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "runtime governance envelope"@en ;
  skos:altLabel "runtime-governance-envelope"@en ;
  skos:definition "A structured envelope that binds the authority, policy, evidence, constraints, obligations, and lifecycle state applicable to a runtime interaction or task."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:rwi> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "rwi"@en ;
  skos:altLabel "RWI"@en ;
  skos:definition "See: real world identity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:schema> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "schema"@en ;
  skos:altLabel "schemas"@en ;
  skos:definition "A framework, pattern, or set of rules for enforcing a specific structure on a digital object or a set of digital data. There are many types of schemas, e.g., data schema, credential verification schema, database schema."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:scid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "scid"@en ;
  skos:altLabel "SCID"@en ;
  skos:altLabel "SCIDs"@en ;
  skos:definition "See: self-certifying identifier."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:scope> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "scope"@en ;
  skos:altLabel "scopes"@en ;
  skos:definition "In the context of terminology, scope refers to the set of possible concepts within which: a) a specific term is intended to uniquely identify a concept, or b) a specific glossary is intended to identify a set of concepts. In the context of identification, scope refers to the set of possible entities within which a specific entity must be uniquely identified. In the context of specifications, scope refers to the set of problems (the problem space) within which the specification is intended to specify solutions."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:sd-jwt-vc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sd-jwt-vc"@en ;
  skos:altLabel "SD-JWT VC"@en ;
  skos:altLabel "SD-JWT-based Verifiable Credential"@en ;
  skos:definition "A verifiable credential encoded using Selective Disclosure JWT mechanisms, enabling selected claims to be disclosed while preserving cryptographic verification."@en ;
  skos:related <urn:tig:concept:selective-disclosure> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:secured-verifiable-credential> ;
  skos:related <urn:tig:concept:key-binding-jwt> .

<urn:tig:concept:second-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "second-party"@en ;
  skos:altLabel "second party"@en ;
  skos:altLabel "second parties"@en ;
  skos:definition "The party with whom a first party engages to form a trust relationship, establish a connection, make a delegation, or execute a transaction."@en ;
  skos:related <urn:tig:concept:third-party> .

<urn:tig:concept:secure-attribution> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "secure-attribution"@en ;
  skos:altLabel "secure attribution"@en ;
  skos:definition "Secure attribution is strongly related to _making and proving statements_. A controller makes statements to the a validator or verifier, who in turn validates the statements issued. A controller \"_owns_\" the statement: content and attribution via digital signatures. Secure attribution is \"whodunit?!\" in cyberspace."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> .

<urn:tig:concept:secure-enclave> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "secure-enclave"@en ;
  skos:altLabel "Secure Enclave"@en ;
  skos:altLabel "Secure Enclaves"@en ;
  skos:definition "A coprocessor on Apple iOS devices that serves as a trusted execution environment."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:secure-multi-party-computation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "secure-multi-party-computation"@en ;
  skos:altLabel "secure multi-party computation"@en ;
  skos:definition "See: multi-party computation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:secured-verifiable-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "secured-verifiable-credential"@en ;
  skos:altLabel "secured VC"@en ;
  skos:altLabel "secured credential"@en ;
  skos:definition "A verifiable credential protected by a securing mechanism such as Data Integrity proofs, JOSE, COSE, or SD-JWT so that authenticity and integrity can be verified."@en ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:data-integrity-proof> ;
  skos:related <urn:tig:concept:sd-jwt-vc> ;
  skos:related <urn:tig:concept:cryptographic-verifiability> .

<urn:tig:concept:security-domain> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "security-domain"@en ;
  skos:altLabel "security domain"@en ;
  skos:altLabel "security domains"@en ;
  skos:definition "An environment or context that includes a set of system resources and a set of system entities that have the right to access the resources as defined by a common security policy, security model, or security architecture."@en ;
  skos:related <urn:tig:concept:trust-domain> .

<urn:tig:concept:security-policy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "security-policy"@en ;
  skos:altLabel "security policy"@en ;
  skos:altLabel "security policies"@en ;
  skos:definition "A set of policies and rules that governs all aspects of security-relevant system and system element behavior."@en ;
  skos:related <urn:tig:concept:privacy-policy> .

<urn:tig:concept:selective-disclosure> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "selective-disclosure"@en ;
  skos:altLabel "selective disclosure"@en ;
  skos:definition "A privacy-preserving presentation capability that allows a holder to disclose only selected claims or attributes from a credential while preserving verifiability."@en ;
  skos:related <urn:tig:concept:sd-jwt-vc> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:zero-knowledge-proof> ;
  skos:related <urn:tig:concept:correlation-privacy> .

<urn:tig:concept:self-asserted> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "self-asserted"@en ;
  skos:definition "A term used to describe a claim or a credential whose subject is also the issuer."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:self-certified> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "self-certified"@en ;
  skos:definition "When a party provides its own certification that it is compliant with a set of requirements, such as a governance framework. The term is also applied to data structures that are cryptographically verifiable such as self-certifying identifiers."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:self-certifying-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "self-certifying-identifier"@en ;
  skos:altLabel "self-certifying identifier"@en ;
  skos:altLabel "self-certifying identifiers"@en ;
  skos:altLabel "SCID"@en ;
  skos:altLabel "SCIDs"@en ;
  skos:definition "A subclass of verifiable identifier (VID) that is cryptographically verifiable without the need to rely on any third party for verification because the identifier is cryptographically bound to the cryptographic keys from which it was generated."@en ;
  skos:related <urn:tig:concept:autonomic-identifier> ;
  skos:related <urn:tig:concept:verifiable-identifier> ;
  skos:related <urn:tig:concept:cryptographic-key> .

<urn:tig:concept:self-sovereign-identity> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "self-sovereign-identity"@en ;
  skos:altLabel "self-sovereign identity"@en ;
  skos:altLabel "SSI"@en ;
  skos:definition "Self-sovereign identity is a decentralized identity architecture that implements the Principles of SSI — principally that it puts the identity controller (e.g., a natural person or organization) directly in control of the identifiers and credentials they use to assert their digital identity."@en ;
  skos:related <urn:tig:concept:federated-identity> .

<urn:tig:concept:sender-constrained-token> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sender-constrained-token"@en ;
  skos:altLabel "sender constrained token"@en ;
  skos:definition "A token whose use is cryptographically constrained to a specific sender or key holder, reducing replay risk if the token is copied."@en ;
  skos:related <urn:tig:concept:dpop> ;
  skos:related <urn:tig:concept:proof-of-possession> ;
  skos:related <urn:tig:concept:authorization> ;
  skos:related <urn:tig:concept:access-control> .

<urn:tig:concept:sensitive-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sensitive-data"@en ;
  skos:altLabel "sensitive data"@en ;
  skos:definition "Personal data that a reasonable person would view from a privacy protection standpoint as requiring special care above and beyond other personal data."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:service-descriptor> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "service descriptor"@en ;
  skos:altLabel "service-descriptor"@en ;
  skos:definition "A policy-governed disclosure artifact through which an agent, service, or system states what it is, what it can do, how it can be reached, and under what visibility conditions."@en ;
  skos:related <urn:tig:concept:trust-service-provider> ;
  skos:related <urn:tig:concept:capability> .

<urn:tig:concept:session> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "session"@en ;
  skos:altLabel "sessions"@en ;
  skos:definition "See: communication session."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:single-signature-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "single-signature-identifier"@en ;
  skos:altLabel "single-signature identifier"@en ;
  skos:definition "or single sig identifier; is an identifier controlled by a one-of-one signing key-pair"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:skill-contract> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "skill contract"@en ;
  skos:altLabel "skill-contract"@en ;
  skos:definition "An operational contract for a discrete capability that defines permitted inputs, outputs, authorization scope, policy conditions, and evidence obligations."@en ;
  skos:related <urn:tig:concept:capability> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:sociotechnical-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sociotechnical-system"@en ;
  skos:altLabel "sociotechnical system"@en ;
  skos:altLabel "sociotechnical systems"@en ;
  skos:altLabel "sociotechnical"@en ;
  skos:definition "An approach to complex organizational work design that recognizes the interaction between people and technology in workplaces. The term also refers to coherent systems of human relations, technical objects, and cybernetic processes that inhere to large, complex infrastructures. Social society, and its constituent substructures, qualify as complex sociotechnical systems."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:software-agent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "software-agent"@en ;
  skos:altLabel "software agent"@en ;
  skos:altLabel "software agents"@en ;
  skos:definition "In computer science, a software agent is a computer program that acts for a user or other program in a relationship of agency, which derives from the Latin *agere* (to do): an agreement to act on one's behalf. A user agent is a specific type of software agent that is used directly by an end-user as the principal."@en ;
  skos:related <urn:tig:concept:digital-agent> .

<urn:tig:concept:sovrin-foundation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sovrin-foundation"@en ;
  skos:altLabel "Sovrin Foundation"@en ;
  skos:definition "A 501 (c)(4) nonprofit organization established to administer the governance framework governing the Sovrin Network, a public service utility enabling self-sovereign identity on the internet. The Sovrin Foundation is an independent organization that is responsible for ensuring the Sovrin identity system is public and globally accessible."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:spanning-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "spanning-layer"@en ;
  skos:altLabel "spanning layer"@en ;
  skos:definition "A specific layer within a protocol stack that consists of a single protocol explicitly designed to provide interoperability between the protocol layers above it and below it."@en ;
  skos:related <urn:tig:concept:hourglass-model> ;
  skos:related <urn:tig:concept:trust-spanning-layer> .

<urn:tig:concept:specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "specification"@en ;
  skos:altLabel "specifications"@en ;
  skos:definition "See: technical specification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:ssi> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ssi"@en ;
  skos:altLabel "SSI"@en ;
  skos:definition "See: self-sovereign identity."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:status-provider> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "status-provider"@en ;
  skos:altLabel "credential status provider"@en ;
  skos:altLabel "status provider"@en ;
  skos:definition "An entity that provides status information such as suspension or revocation for a credential."@en ;
  skos:related <urn:tig:concept:bitstring-status-list> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:status-record> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:status-record> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "status-record"@en ;
  skos:altLabel "status record"@en ;
  skos:definition "An inspectable record that represents the validity, suspension, revocation, or lifecycle status of a credential, authorization, registration, or governed object."@en ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:bitstring-status-list> ;
  skos:related <urn:tig:concept:audit-log> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:stream> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "stream"@en ;
  skos:altLabel "streams"@en ;
  skos:definition "In the context of digital communications, and in particular streaming media, a flow of data delivered in a continuous manner from a server to a client rather than in discrete messages."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:streaming-media> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "streaming-media"@en ;
  skos:altLabel "streaming media"@en ;
  skos:definition "Streaming media is multimedia for playback using an offline or online media player. Technically, the stream is delivered and consumed in a continuous manner from a client, with little or no intermediate storage in network elements. Streaming refers to the delivery method of content, rather than the content itself."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:subject> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "subject"@en ;
  skos:altLabel "subjects"@en ;
  skos:definition "The entity described by one or more claims, particularly in the context of credentials."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:subscription> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "subscription"@en ;
  skos:altLabel "subscriptions"@en ;
  skos:definition "In the context of decentralized digital trust infrastructure, a subscription is an agreement between a first digital agent—the *publisher*—to automatically send a second digital agent—the *subscriber*—a message when a specific type of event happens in the wallet or vault managed by the first digital agent."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:supporting-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "supporting-system"@en ;
  skos:altLabel "supporting system"@en ;
  skos:altLabel "supporting systems"@en ;
  skos:definition "A system that operates at ToIP Layer 1, the trust support layer of the ToIP stack. A supporting system is one of three types of systems defined in the ToIP Technology Architecture Specification."@en ;
  skos:related <urn:tig:concept:endpoint-system> ;
  skos:related <urn:tig:concept:intermediary-system> .

<urn:tig:concept:sybil-attack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "sybil-attack"@en ;
  skos:altLabel "Sybil attack"@en ;
  skos:altLabel "Sybil attacks"@en ;
  skos:definition "A Sybil attack is a type of attack on a computer network service in which an attacker subverts the service's reputation system by creating a large number of pseudonymous identities and uses them to gain a disproportionately large influence. It is named after the subject of the book _Sybil_, a case study of a woman diagnosed with dissociative identity disorder."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:system-of-record> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "system-of-record"@en ;
  skos:altLabel "system of record"@en ;
  skos:altLabel "systems of record"@en ;
  skos:definition "A system of record (SOR) or source system of record (SSoR) is a data management term for an information storage system (commonly implemented on a computer system running a database management system) that is the authoritative source for a given data element or piece of information."@en ;
  skos:related <urn:tig:concept:authoritative-source> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:verifiable-data-registry> .

<urn:tig:concept:tamper-evident> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tamper-evident"@en ;
  skos:altLabel "tamper evident"@en ;
  skos:definition "A process which makes alterations to the data easily detectable. Form digital data objects, this is typically achieved via cryptographic verification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:tamper-resistant> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tamper-resistant"@en ;
  skos:altLabel "tamper resistant"@en ;
  skos:altLabel "tamper resistance"@en ;
  skos:altLabel "tamper-resistance"@en ;
  skos:definition "A process which makes alterations to data difficult (hard to perform), costly (expensive to perform), or both. For digital data objects, this is typically achieved via cryptographic verification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:task-evidence-lifecycle> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "task evidence lifecycle"@en ;
  skos:altLabel "task-evidence-lifecycle"@en ;
  skos:definition "The sequence of evidence, receipts, artifacts, and review triggers associated with governance-significant task state transitions from initiation through completion, cancellation, or failure."@en ;
  skos:related <urn:tig:concept:trust-task> ;
  skos:related <urn:tig:concept:audit-log> ;
  skos:related <urn:tig:concept:attestation> .

<urn:tig:concept:tcp-ip-stack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tcp-ip-stack"@en ;
  skos:altLabel "TCP/IP stack"@en ;
  skos:altLabel "TCP/IP protocol stack"@en ;
  skos:definition "The protocol stack implementing the TCP/IP suite."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:tcp-ip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tcp-ip"@en ;
  skos:altLabel "TCP/IP"@en ;
  skos:definition "See: Internet Protocol Suite."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:technical-requirement> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "technical-requirement"@en ;
  skos:altLabel "technical requirement"@en ;
  skos:altLabel "technical requirements"@en ;
  skos:definition "A requirement for a hardware or software component or system. In the context of decentralized digital trust infrastructure, technical requirements are a subset of governance requirements. Technical requirements are often specified in a technical specification."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:technical-specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "technical-specification"@en ;
  skos:altLabel "technical specification"@en ;
  skos:altLabel "technical specifications"@en ;
  skos:definition "A document that specifies, in a complete, precise, verifiable manner, the requirements, design, behavior, or other characteristics of a system or component and often the procedures for determining whether these provisions have been satisfied."@en ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governance-requirement> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:rule> .

<urn:tig:concept:technical-trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "technical-trust"@en ;
  skos:altLabel "technical trust"@en ;
  skos:definition "A level of assurance in a trust relationship that can be achieved only via technical means such as hardware, software, network protocols, and cryptography.Cryptographic trust is a specialized type of technical trust."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:tee> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tee"@en ;
  skos:altLabel "TEE"@en ;
  skos:definition "See: trusted execution environment."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:term> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "term"@en ;
  skos:altLabel "terms"@en ;
  skos:definition "A unit of text (i.e., a word or phrase) that is used in a particular context or scope to refer to a concept (or a relation between concepts, or a property of a concept)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:terminology> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "terminology"@en ;
  skos:altLabel "terminologies"@en ;
  skos:definition "Terminology is a group of specialized words and respective meanings in a particular field, and also the study of such terms and their use; the latter meaning is also known as *terminology science*. A term is a word, compound word, or multi-word expressions that in specific contexts is given specific meanings—meaning which may deviate from the meanings the same words have in other contexts and in everyday language. Terminology is a discipline that studies, among other things, the development of such terms and their interrelationships within a specialized domain. Terminology differs from *lexicography*, as the former involves the study of concepts, conceptual systems and their labels (terms), whereas lexicography studies words and their meanings."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:terms-community> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "terms-community"@en ;
  skos:altLabel "terms community"@en ;
  skos:altLabel "terms communities"@en ;
  skos:definition "A group of parties who share the need for a common terminology."@en ;
  skos:related <urn:tig:concept:trust-community> .

<urn:tig:concept:terms-wiki> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "terms-wiki"@en ;
  skos:altLabel "terms wiki"@en ;
  skos:altLabel "terms wikis"@en ;
  skos:definition "A wiki website used by a terms community to input, maintain, and publish its terminology. The Concepts and Terminology Working Group at the ToIP Foundation has created a simple template for GitHub-based terms wikis."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:thing> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "thing"@en ;
  skos:altLabel "things"@en ;
  skos:definition "An entity that is neither a natural person nor an organization and thus cannot be a party. A thing may be a natural thing or a man-made thing."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:third-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "third-party"@en ;
  skos:altLabel "third party"@en ;
  skos:altLabel "third parties"@en ;
  skos:definition "A party that is not directly involved in the trust relationship between a first party and a second party, but provides supporting services to either or both of them."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:three-party-model> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "three-party-model"@en ;
  skos:altLabel "three party model"@en ;
  skos:definition "The issuer—holder—verifier model used by all types of physical credentials and digital credentials to enable transitive trust decisions."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:timestamp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "timestamp"@en ;
  skos:altLabel "timestamps"@en ;
  skos:definition "A token or packet of information that is used to provide assurance of timeliness; the timestamp contains timestamped data, including a time, and a signature generated by a trusted timestamp authority (TTA)."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:tls> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tls"@en ;
  skos:altLabel "TLS"@en ;
  skos:definition "See: Transport Layer Security."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-application> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-application"@en ;
  skos:altLabel "ToIP application"@en ;
  skos:altLabel "ToIP applications"@en ;
  skos:definition "A trust application that runs at ToIP Layer 4, the trust application layer."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-channel> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-channel"@en ;
  skos:altLabel "ToIP channel"@en ;
  skos:altLabel "ToIP channels"@en ;
  skos:definition "See: ToiP relationship."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-communication> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-communication"@en ;
  skos:altLabel "ToIP communication"@en ;
  skos:altLabel "ToIP communications"@en ;
  skos:definition "Communication that uses the ToIP stack to deliver ToIP messages between ToIP endpoints, optionally using ToIP intermediaries to provide authenticity, confidentiality, and correlation privacy."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-connection> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-connection"@en ;
  skos:altLabel "ToIP connection"@en ;
  skos:altLabel "ToIP connections"@en ;
  skos:definition "See: ToIP relationship."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-controller> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-controller"@en ;
  skos:altLabel "ToIP controller"@en ;
  skos:altLabel "ToIP controllers"@en ;
  skos:definition "The controller of a verifiable identifier (VID) used with the ToIP stack."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-endpoint> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-endpoint"@en ;
  skos:altLabel "ToIP endpoint"@en ;
  skos:altLabel "ToIP endpoints"@en ;
  skos:definition "An endpoint that communicates via the ToIP Trust Spanning Protocol (TSP) as described in the ToIP Technology Architecture Specification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-foundation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-foundation"@en ;
  skos:altLabel "ToIP Foundation"@en ;
  skos:definition "A non-profit project of the Linux Foundation chartered to define an overall architecture for decentralized digital trust infrastructure known as the ToIP stack."@en ;
  skos:related <urn:tig:concept:decentralized-identity-foundation> ;
  skos:related <urn:tig:concept:openwallet-foundation> .

<urn:tig:concept:toip-governance-architecture-specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-governance-architecture-specification"@en ;
  skos:altLabel "ToIP Governance Architecture Specification"@en ;
  skos:definition "The specification defining the requirements for the ToIP Governance Stack published by the ToIP Foundation."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:toip-governance-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-governance-framework"@en ;
  skos:altLabel "ToIP governance framework"@en ;
  skos:altLabel "ToIP governance frameworks"@en ;
  skos:definition "A governance framework that conforms to the requirements of the ToIP Governance Architecture Specification."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:toip-governance-metamodel> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-governance-metamodel"@en ;
  skos:altLabel "ToIP Governance Metamodel"@en ;
  skos:definition "A structural model for governance frameworks that specifies the recommended governance documents that should be included depending on the objectives of the trust community."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:toip-governance-stack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-governance-stack"@en ;
  skos:altLabel "ToIP Governance Stack"@en ;
  skos:definition "The governance half of the four layer ToIP stack as defined by the ToIP Governance Architecture Specification."@en ;
  skos:related <urn:tig:concept:toip-technology-stack> .

<urn:tig:concept:toip-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-identifier"@en ;
  skos:altLabel "ToIP identifier"@en ;
  skos:altLabel "ToIP identifiers"@en ;
  skos:definition "A verifiable identifier (VID) for an entity that is addressable using the ToIP stack."@en ;
  skos:related <urn:tig:concept:autonomic-identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> ;
  skos:related <urn:tig:concept:self-certifying-identifier> .

<urn:tig:concept:toip-intermediary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-intermediary"@en ;
  skos:altLabel "ToIP intermediary"@en ;
  skos:altLabel "ToIP intermediaries"@en ;
  skos:definition "See: intermediary system."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-layer-1> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-layer-1"@en ;
  skos:altLabel "ToIP Layer 1"@en ;
  skos:definition "The trust support layer of the ToIP stack, responsible for supporting the trust spanning protocol at ToIP Layer 2."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-layer-2> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-layer-2"@en ;
  skos:altLabel "ToIP Layer 2"@en ;
  skos:definition "The trust spanning layer of the ToIP stack, responsible for enabling trust task protocols at ToIP Layer 3."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-layer-3> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-layer-3"@en ;
  skos:altLabel "ToIP Layer 3"@en ;
  skos:definition "The trust task layer of the ToIP stack, responsible for enabling trust applications at ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-layer-4> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-layer-4"@en ;
  skos:altLabel "ToIP Layer 4"@en ;
  skos:definition "The trust application layer of the ToIP stack, where end-users have the direct human experience of using applications that call trust task protocols to engage in trust relationships and make trust decisions using ToIP decentralized digital trust infrastructure."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-layer"@en ;
  skos:altLabel "ToIP layer"@en ;
  skos:altLabel "ToIP layers"@en ;
  skos:definition "One of four protocol layers in the ToIP stack. The four layers are ToIP Layer 1, ToIP Layer 2, ToIP Layer 3, and ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-message> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-message"@en ;
  skos:altLabel "ToIP message"@en ;
  skos:altLabel "ToIP messages"@en ;
  skos:definition "A message communicated between ToIP endpoints using the ToIP stack. ToIP messages are transmitted over the ToIP Trust Spanning Protocol (TSP) at Layer 2 of the ToIP stack."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-relationship> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-relationship"@en ;
  skos:altLabel "ToIP relationship"@en ;
  skos:definition "A VID-to-VID relationship formed between two entities over the ToIP Trust Spanning Protocol."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-specification"@en ;
  skos:altLabel "ToIP specification"@en ;
  skos:altLabel "ToIP specifications"@en ;
  skos:definition "A specification published by the ToIP Foundation. ToIP specifications may be in one of three states: *Draft Deliverable*, *Working Group Approved Deliverable*, or *ToIP Approved Deliverable*."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-stack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-stack"@en ;
  skos:altLabel "ToIP stack"@en ;
  skos:altLabel "ToIP stacks"@en ;
  skos:definition "The layered architecture for decentralized digital trust infrastructure defined by the ToIP Foundation. The ToIP stack is a dual stack consisting of two halves: the ToIP Technology Stack and the ToIP Governance Stack. The four layers in the ToIP stack are ToIP Layer 1, ToIP Layer 2, ToIP Layer 3, and ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:toip-system> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-system"@en ;
  skos:altLabel "ToIP system"@en ;
  skos:altLabel "ToIP systems"@en ;
  skos:definition "A computing system that participates in the ToIP Technology Stack. There are three types of ToIP systems: endpoint systems, intermediary systems, and supporting systems."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-technology-architecture-specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-technology-architecture-specification"@en ;
  skos:altLabel "ToIP Technology Architecture Specification"@en ;
  skos:definition "The technical specification defining the requirements for the ToIP Technology Stack published by the ToIP Foundation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:toip-technology-stack> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-technology-stack"@en ;
  skos:altLabel "ToIP Technology Stack"@en ;
  skos:definition "The technology half of the four layer ToIP stack as defined by the ToIP Technology Architecture Specification."@en ;
  skos:related <urn:tig:concept:toip-governance-stack> ;
  skos:related <urn:tig:concept:toip-layer> .

<urn:tig:concept:toip-trust-community> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-trust-community"@en ;
  skos:altLabel "ToIP trust community"@en ;
  skos:definition "A trust community governed by a ToIP governance framework."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:toip-trust-network> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-trust-network"@en ;
  skos:altLabel "ToIP trust network"@en ;
  skos:altLabel "ToIP trust networks"@en ;
  skos:definition "A trust network implemented using the ToIP stack."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:toip-trust-registry-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-trust-registry-protocol"@en ;
  skos:altLabel "ToIP Trust Registry Protocol"@en ;
  skos:definition "The open standard trust task protocol defined by the ToIP Foundation to perform the trust task of querying a trust registry. The ToIP Trust Registry Protocol operates at Layer 3 of the ToIP stack."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:toip-trust-spanning-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip-trust-spanning-protocol"@en ;
  skos:altLabel "ToIP Trust Spanning Protocol"@en ;
  skos:altLabel "TSP"@en ;
  skos:definition "The ToIP Trust Spanning Protocol (TSP) is the ToIP Layer 2 protocol for verifiable messaging that implements the trust spanning layer of the ToIP stack.  The TSP enables actors in different digital trust domains to interact in a similar way to how the Internet Protocol (IP) enables devices on different local area networks to exchange data."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:toip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "toip"@en ;
  skos:altLabel "ToIP"@en ;
  skos:definition "See: Trust Over IP"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:transaction> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transaction"@en ;
  skos:altLabel "transactions"@en ;
  skos:definition "A discrete event between a user and a system that supports a business or programmatic purpose. A digital system may have multiple categories or types of transactions, which may require separate analysis within the overall digital identity risk assessment."@en ;
  skos:related <urn:tig:concept:connection> .

<urn:tig:concept:transferable-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transferable-identifier"@en ;
  skos:altLabel "transferable identifier"@en ;
  skos:definition "Control over the identifier transferable by [[xref: keri1, rotation]]."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:transferable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transferable"@en ;
  skos:definition "Capable of being transferred or conveyed from one place or person to another. Place can be its and bits."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:transitive-trust-decision> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transitive-trust-decision"@en ;
  skos:altLabel "transitive trust decision"@en ;
  skos:altLabel "transitive trust decisions"@en ;
  skos:definition "A trust decision made by a first party about a second party or another entity based on information about the second party or the other entity that is obtained from one or more third parties."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:transport-layer-security> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transport-layer-security"@en ;
  skos:altLabel "Transport Layer Security"@en ;
  skos:definition "Transport Layer Security (TLS) is a cryptographic protocol designed to provide communications security over a computer network. The protocol is widely used in applications such as email, instant messaging, and Voice over IP, but its use in securing HTTPS remains the most publicly visible. The TLS protocol aims primarily to provide security, including privacy (confidentiality), integrity, and authenticity through the use of cryptography, such as the use of certificates, between two or more communicating computer applications."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:transport-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "transport-layer"@en ;
  skos:altLabel "transport layer"@en ;
  skos:definition "Layer of the TCP/IP protocol stack that is responsible for reliable connection-oriented or connectionless end-to-end communications."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:tribal-knowledge> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tribal-knowledge"@en ;
  skos:altLabel "tribal knowledge"@en ;
  skos:definition "Knowledge that is known within an “in-group” of people but unknown outside of it. A tribe, in this sense, is a group of people that share such a common knowledge."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:trust-anchor> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-anchor"@en ;
  skos:altLabel "trust anchor"@en ;
  skos:altLabel "trust anchors"@en ;
  skos:definition "The authoritative source that serves as the origin of a trust chain."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> .

<urn:tig:concept:trust-application-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-application-layer"@en ;
  skos:altLabel "trust application layer"@en ;
  skos:definition "In the context of the ToIP stack, the trust application layer is ToIP Layer 4. Applications running at this layer call trust task protocols at ToIP Layer 3."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-application> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-application"@en ;
  skos:altLabel "trust application"@en ;
  skos:altLabel "trust applications"@en ;
  skos:definition "An application that runs at ToIP Layer 4 in order to perform trust tasks or engage in other verifiable messaging using the ToIP stack."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-assurance> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-assurance"@en ;
  skos:altLabel "trust assurance"@en ;
  skos:altLabel "trust assurances"@en ;
  skos:definition "A process that provides a level of assurance sufficient to make a particular trust decision."@en ;
  skos:related <urn:tig:concept:audit> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-basis> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-basis"@en ;
  skos:altLabel "trust basis"@en ;
  skos:definition "The properties of a verifiable identifier (VID) or a ToIP system that enable a party to appraise it to determine a trust limit."@en ;
  skos:related <urn:tig:concept:appraisability> .

<urn:tig:concept:trust-boundary> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-boundary"@en ;
  skos:altLabel "trust boundary"@en ;
  skos:altLabel "trust boundaries"@en ;
  skos:definition "The border of a trust domain."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-chain> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-chain"@en ;
  skos:altLabel "trust chain"@en ;
  skos:altLabel "trust chains"@en ;
  skos:definition "A sequence of cryptographically verifiable links, statements, or governance-recognized relationships used to establish whether a participant, key, credential, or federation entity should be trusted for a relying decision."@en ;
  skos:related <urn:tig:concept:openid-federation> ;
  skos:related <urn:tig:concept:entity-statement> ;
  skos:related <urn:tig:concept:trust-anchor> ;
  skos:related <urn:tig:concept:chain-of-trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-community> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-community"@en ;
  skos:altLabel "trust community"@en ;
  skos:altLabel "trust communities"@en ;
  skos:definition "A set of parties who collaborate to achieve a mutual set of trust objectives."@en ;
  skos:related <urn:tig:concept:digital-trust-ecosystem> ;
  skos:related <urn:tig:concept:toip-trust-community> .

<urn:tig:concept:trust-context> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-context"@en ;
  skos:altLabel "trust context"@en ;
  skos:altLabel "trust contexts"@en ;
  skos:definition "The context in which a specific party makes a specific trust decision. Many different factors may be involved in establishing a trust context, such as: the relevant interaction or transaction; the presence or absence of existing trust relationships; the applicability of one or more governance frameworks; and the location, time, network, and/or devices involved. A trust context may be implicit or explicit; if explicit, it may be identified using an identifier. A ToIP governance framework is an example of an explicit trust context identified by a verifiable identifier (VID)."@en ;
  skos:related <urn:tig:concept:trust-domain> .

<urn:tig:concept:trust-decision> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-decision"@en ;
  skos:altLabel "trust decision"@en ;
  skos:altLabel "trust decisions"@en ;
  skos:definition "A decision that a party needs to make about whether to engage in a specific interaction or transaction with another entity that involves real or perceived risks."@en ;
  skos:related <urn:tig:concept:transitive-trust-decision> .

<urn:tig:concept:trust-domain> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-domain"@en ;
  skos:altLabel "trust domain"@en ;
  skos:altLabel "trust domains"@en ;
  skos:definition "A security domain defined by a computer hardware or software architecture, a security policy, or a trust community, typically via a trust framework or governance framework."@en ;
  skos:related <urn:tig:concept:trust-context> ;
  skos:related <urn:tig:concept:digital-trust-ecosystem> ;
  skos:related <urn:tig:concept:security-domain> ;
  skos:related <urn:tig:concept:trust-framework> .

<urn:tig:concept:trust-ecosystem> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-ecosystem"@en ;
  skos:altLabel "trust ecosystem"@en ;
  skos:altLabel "trust ecosystems"@en ;
  skos:definition "See digital trust ecosystem."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-establishment> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-establishment"@en ;
  skos:altLabel "trust establishment"@en ;
  skos:definition "The process two or more parties go through to establish a trust relationship. In the context of decentralized digital trust infrastructure, trust establishment takes place at two levels. At the technical trust level, it includes some form of key establishment. At the human trust level, it may be accomplished via an out-of-band introduction, the exchange of digital credentials, queries to one or more trust registries, or evaluation of some combination of human-readable and machine-readable governance frameworks."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:trust-factor> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-factor"@en ;
  skos:altLabel "trust factor"@en ;
  skos:altLabel "trust factors"@en ;
  skos:definition "A property, relationship, or other signal that can contribute to a party making a trust decision."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-framework"@en ;
  skos:altLabel "trust framework"@en ;
  skos:altLabel "trust frameworks"@en ;
  skos:definition "A term (most frequently used in the digital identity industry) to describe a governance framework for a digital identity system, especially a federation."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:trust-graph> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-graph"@en ;
  skos:altLabel "trust graph"@en ;
  skos:altLabel "trust graphs"@en ;
  skos:definition "A data structure describing the trust relationship between two or more entities. A simple trust graph may be expressed as a trust list. More complex trust graphs can be recorded or registered in and queried from a trust registry. Trust graphs can also be expressed using trust chains and chained credentials. Trust graphs can enable verifiers and relying parties to make transitive trust decisions."@en ;
  skos:related <urn:tig:concept:authorization-graph> ;
  skos:related <urn:tig:concept:governance-graph> ;
  skos:related <urn:tig:concept:reputation-graph> .

<urn:tig:concept:trust-limit> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-limit"@en ;
  skos:altLabel "trust limit"@en ;
  skos:altLabel "trust limits"@en ;
  skos:definition "A limit to the degree a party is willing to trust an entity in a specific trust relationship within a specific trust context."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-list> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-list"@en ;
  skos:altLabel "trust list"@en ;
  skos:altLabel "trust lists"@en ;
  skos:definition "A one-dimensional trust graph in which an authoritative source publishes a list of entities that are trusted in a specific trust context. A trust list can be considered a simplified form of a trust registry."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governance> .

<urn:tig:concept:trust-network> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-network"@en ;
  skos:altLabel "trust network"@en ;
  skos:altLabel "trust networks"@en ;
  skos:definition "A network of parties who are connected via trust relationships (such as via a membership agreement) conforming to requirements defined in a legal regulation, trust framework or governance framework. A trust network is more formal than a digital trust ecosystem; the latter may connect parties more loosely via transitive trust relationships and/or across multiple trust networks."@en ;
  skos:related <urn:tig:concept:toip-trust-network> .

<urn:tig:concept:trust-objective> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-objective"@en ;
  skos:altLabel "trust objective"@en ;
  skos:altLabel "trust objectives"@en ;
  skos:definition "An objective shared by the parties in a trust community to establish and maintain trust relationships."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-over-ip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-over-ip"@en ;
  skos:altLabel "Trust over IP"@en ;
  skos:definition "A term coined by John Jordan to describe the decentralized digital trust infrastructure made possible by the ToIP stack. A play on the term *Voice over IP* (abbreviated *VoIP*). The term was adopted as the name for the Trust over IP Foundation aka ToIP Foundation."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-registry-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-registry-protocol"@en ;
  skos:altLabel "trust registry protocol"@en ;
  skos:definition "See: ToIP Trust Registry Protocol."@en ;
  skos:related <urn:tig:concept:registry> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:registration> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:trust-registry> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-registry"@en ;
  skos:altLabel "trust registry"@en ;
  skos:altLabel "trust registries"@en ;
  skos:definition "A registry that serves as an authoritative source for trust graphs or other governed information describing one or more trust communities. A trust registry is typically authorized by a governance framework."@en ;
  skos:related <urn:tig:concept:trust-list> ;
  skos:related <urn:tig:concept:verifiable-data-registry> .

<urn:tig:concept:trust-relationship> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-relationship"@en ;
  skos:altLabel "trust relationship"@en ;
  skos:altLabel "trust relationships"@en ;
  skos:definition "A relationship between a party and an entity in which the party has decided to trust the entity in one or more trust contexts up to a trust limit."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-root> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-root"@en ;
  skos:altLabel "trust root"@en ;
  skos:altLabel "trust roots"@en ;
  skos:definition "See: trust anchor"@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-service-provider> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-service-provider"@en ;
  skos:altLabel "trust service provider"@en ;
  skos:altLabel "trust service providers"@en ;
  skos:definition "In the context of specific digital trust ecosystems, such as the European Union’s eIDAS regulations, a trust service provider is a legal entity that provides specific trust support services as required by legal regulations, trust frameworks, or governance frameworks. In the larger context of ToIP infrastructure, a trust service provider is a provider of services based on the ToIP stack. Most generally, a trust service provider is to the trust layer for the Internet what an Internet service provider (ISP) is to the Internet layer."@en ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:requirement> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governing-authority> .

<urn:tig:concept:trust-spanning-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-spanning-layer"@en ;
  skos:altLabel "trust spanning layer"@en ;
  skos:definition "A spanning layer designed to span between different digital trust domains. In the ToIP stack, the trust spanning layer is ToIP Layer 2."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-spanning-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-spanning-protocol"@en ;
  skos:altLabel "trust spanning protocol"@en ;
  skos:definition "See: ToIP Trust Spanning Protocol."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-support-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-support-layer"@en ;
  skos:altLabel "trust support layer"@en ;
  skos:definition "In the context of the ToIP stack, the trust support layer is ToIP Layer 1. It supports the operations of the ToIP Trust Spanning Protocol at ToIP Layer 2."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-support> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-support"@en ;
  skos:altLabel "trust support"@en ;
  skos:altLabel "trust supports"@en ;
  skos:definition "A system, protocol, or other infrastructure whose function is to facilitate the establishment and maintenance of trust relationships at higher protocol layers. In the ToIP stack, the trust support layer is Layer 1."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-task-execution-receipt> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust task execution receipt"@en ;
  skos:altLabel "trust-task-execution-receipt"@en ;
  skos:definition "A structured receipt that records how a trust-relevant task was authorized, executed, evidenced, and completed or terminated."@en ;
  skos:related <urn:tig:concept:trust-task> ;
  skos:related <urn:tig:concept:authority> ;
  skos:related <urn:tig:concept:policy> .

<urn:tig:concept:trust-task-layer> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-task-layer"@en ;
  skos:altLabel "trust task layer"@en ;
  skos:definition "In the context of the ToIP stack, the trust task layer is ToIP Layer 3. It supports trust applications operating at ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-task-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-task-protocol"@en ;
  skos:altLabel "trust task protocol"@en ;
  skos:altLabel "trust task protocols"@en ;
  skos:definition "A ToIP Layer 3 protocol that implements a specific trust task on behalf of a trust application operating at ToIP Layer 4."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-task> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-task"@en ;
  skos:altLabel "trust task"@en ;
  skos:altLabel "trust tasks"@en ;
  skos:definition "A specific task that involves establishing, verifying, or maintaining trust relationships or exchanging verifiable messages or verifiable data that can be performed on behalf of a trust application by a trust task protocol at Layer 3 of the ToIP stack."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust-triangle> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust-triangle"@en ;
  skos:altLabel "trust triangle"@en ;
  skos:altLabel "trust triangles"@en ;
  skos:definition "See: three-party model."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trust> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trust"@en ;
  skos:altLabel "trusts"@en ;
  skos:altLabel "trusted"@en ;
  skos:definition "A belief that an entity will behave in a predictable manner in specified circumstances. The entity may be a person, process, object or any combination of such components. The entity can be of any size from a single hardware component or software module, to a piece of equipment identified by make and model, to a site or location, to an organization, to a nation-state. Trust, while inherently a subjective determination, can be based on objective evidence and subjective elements. The objective grounds for trust can include for example, the results of information technology product testing and evaluation. Subjective belief, level of comfort, and experience may supplement (or even replace) objective evidence, or substitute for such evidence when it is unavailable. Trust is usually relative to a specific circumstance or situation (e.g., the amount of money involved in a transaction, the sensitivity or criticality of information, or whether safety is an issue with human lives at stake). Trust is generally not transitive (e.g., you trust a friend but not necessarily a friend of a friend). Finally, trust is generally earned, based on experience or measurement."@en ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:transitive-trust-decision> .

<urn:tig:concept:trusted-execution-environment> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trusted-execution-environment"@en ;
  skos:altLabel "trusted execution environment"@en ;
  skos:altLabel "trusted execution environments"@en ;
  skos:altLabel "TEE"@en ;
  skos:altLabel "TEEs"@en ;
  skos:definition "A trusted execution environment (TEE) is a secure area of a main processor. It helps code and data loaded inside it to be protected with respect to confidentiality and integrity. Data integrity prevents unauthorized entities from outside the TEE from altering data, while code integrity prevents code in the TEE from being replaced or modified by unauthorized entities, which may also be the computer owner itself as in certain DRM schemes."@en ;
  skos:related <urn:tig:concept:secure-enclave> .

<urn:tig:concept:trusted-role> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trusted-role"@en ;
  skos:altLabel "trusted role"@en ;
  skos:altLabel "trusted roles"@en ;
  skos:definition "A role that performs restricted activities for an organization after meeting competence, security and background verification requirements for that role."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trusted-third-party> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trusted-third-party"@en ;
  skos:altLabel "trusted third party"@en ;
  skos:altLabel "trusted third parties"@en ;
  skos:altLabel "trusted 3rd party"@en ;
  skos:altLabel "trusted 3rd parties"@en ;
  skos:altLabel "TTP"@en ;
  skos:altLabel "TTPs"@en ;
  skos:definition "In cryptography, a trusted third party (TTP) is an entity which facilitates interactions between two parties who both trust the third party; the third party reviews all critical transaction communications between the parties, based on the ease of creating fraudulent digital content. In TTP models, the relying parties use this trust to secure their own interactions. TTPs are common in any number of commercial transactions and in cryptographic digital transactions as well as cryptographic protocols, for example, a certificate authority (CA) would issue a digital certificate to one of two parties. The CA then becomes the TTP to that certificate's issuance. Likewise transactions that need a third party recordation would also need a third-party repository service of some kind."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:trusted-timestamp-authority> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trusted-timestamp-authority"@en ;
  skos:altLabel "trusted timestamp authority"@en ;
  skos:altLabel "trusted timestamp authorities"@en ;
  skos:altLabel "TTA"@en ;
  skos:altLabel "TTAs"@en ;
  skos:definition "An authority that is trusted to provide accurate time information in the form of a timestamp."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:trustworthiness> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trustworthiness"@en ;
  skos:definition "An attribute of an entity, such as a person or organization, that provides confidence to others of the qualifications, capabilities, and reliability of that entity to perform specific tasks and fulfill assigned responsibilities. Trustworthiness is also a characteristic of information technology products and systems. The attribute of trustworthiness, whether applied to people, processes, or technologies, can be measured, at least in relative terms if not quantitatively. The determination of trustworthiness plays a key role in establishing trust relationships among persons and organizations. The trust relationships are key factors in risk decisions made by senior leaders/executives."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:trustworthy> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "trustworthy"@en ;
  skos:definition "A property of an entity that has the attribute of trustworthiness."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:tsp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tsp"@en ;
  skos:altLabel "TSP"@en ;
  skos:definition "See: ToIP Trust Spanning Protocol."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:tta> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "tta"@en ;
  skos:altLabel "TTA"@en ;
  skos:definition "See: trusted timestamp authority."@en ;
  skos:related <urn:tig:concept:governance> ;
  skos:related <urn:tig:concept:governance-framework> ;
  skos:related <urn:tig:concept:governing-authority> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:revocation> ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:ttp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "ttp"@en ;
  skos:altLabel "TTP"@en ;
  skos:definition "See: trusted third party."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:udp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "udp"@en ;
  skos:altLabel "UDP"@en ;
  skos:definition "See: User Datagram Protocol."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:unicast-address> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "unicast-address"@en ;
  skos:altLabel "unicast address"@en ;
  skos:altLabel "unicast addresses"@en ;
  skos:definition "A network address used for a unicast."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:unicast> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "unicast"@en ;
  skos:definition "In computer networking, unicast is a one-to-one transmission from one point in the network to another point; that is, one sender and one receiver, each identified by a network address (a unicast address). Unicast is in contrast to multicast and broadcast which are one-to-many transmissions. Internet Protocol unicast delivery methods such as Transmission Control Protocol (TCP) and User Datagram Protocol (UDP) are typically used."@en ;
  skos:related <urn:tig:concept:anycast> .

<urn:tig:concept:uniform-resource-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "uniform-resource-identifier"@en ;
  skos:altLabel "Uniform Resource Identifier"@en ;
  skos:altLabel "Uniform Resource Identifiers"@en ;
  skos:altLabel "URI"@en ;
  skos:altLabel "URIs"@en ;
  skos:definition "A Uniform Resource Identifier (URI) is the generic standard for all types of identifiers used to link resources in the World Wide Web. The most common type of a URI is a URL (Uniform Resource Locator). The URI standard is defined by IETF RFC 3986. URNs (Uniform Resource Names) are another type of URIs intended for persistent identifiers."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:identifier> ;
  skos:related <urn:tig:concept:decentralized-identifier> .

<urn:tig:concept:uniform-resource-locator> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "uniform-resource-locator"@en ;
  skos:altLabel "Uniform Resource Locator"@en ;
  skos:altLabel "Uniform Resource Locators"@en ;
  skos:altLabel "URL"@en ;
  skos:altLabel "URLs"@en ;
  skos:definition "A Uniform Resource Locator (URL) is the standard form of a Web address used to link resources in browsers and other Internet applications. Technically, it is a specific type of Uniform Resource Identifier (URI)."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:uniform-resource-name> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "uniform-resource-name"@en ;
  skos:altLabel "Uniform Resource Name"@en ;
  skos:altLabel "Uniform Resource Names"@en ;
  skos:altLabel "URN"@en ;
  skos:altLabel "URNs"@en ;
  skos:definition "A Uniform Resource Name (URN) is a type of URI (Uniform Resource Identifier) designed for persistent identifiers that are intended to be assigned once to a resource and never changed to identify a different resource. In some cases a URN is also intended to serve as a persistent way to locate the identified resource over time even as it moves locations on the network. The URN standard is defined by IETF RFC 8141."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:unlinkability> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "unlinkability"@en ;
  skos:definition "A privacy property under which two or more transactions, proofs, identifiers, or observations cannot reasonably be determined to concern the same party beyond the permitted correlation scope."@en ;
  skos:related <urn:tig:concept:correlation-privacy> ;
  skos:related <urn:tig:concept:selective-disclosure> ;
  skos:related <urn:tig:concept:zero-knowledge-proof> .

<urn:tig:concept:uri> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "uri"@en ;
  skos:altLabel "URI"@en ;
  skos:definition "See: Uniform Resource Identifier."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:url> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "url"@en ;
  skos:altLabel "URL"@en ;
  skos:definition "See: Uniform Resource Locator."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:urn> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "urn"@en ;
  skos:altLabel "URN"@en ;
  skos:definition "See: Uniform Resource Name."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:user-agent> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "user-agent"@en ;
  skos:altLabel "user agent"@en ;
  skos:altLabel "user agents"@en ;
  skos:definition "A software agent that is used directly by the end-user as the principal. Browsers, email clients, and digital wallets are all examples of user agents."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:user-datagram-protocol> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "user-datagram-protocol"@en ;
  skos:altLabel "User Datagram Protocol"@en ;
  skos:definition "In computer networking, the User Datagram Protocol (UDP) is one of the core communication protocols of the Internet protocol suite used to send messages (transported as datagrams in packets) to other hosts on an Internet Protocol (IP) network. Within an IP network, UDP does not require prior communication to set up communication channels or data paths."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:utility-governance-framework> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "utility-governance-framework"@en ;
  skos:altLabel "utility governance framework"@en ;
  skos:altLabel "utility governance frameworks"@en ;
  skos:definition "A governance framework for a digital trust utility. A utility governance framework may be a component of or referenced by an ecosystem governance framework or a credential governance framework."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:policy> ;
  skos:related <urn:tig:concept:governance-framework> .

<urn:tig:concept:validation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "validation"@en ;
  skos:altLabel "validity"@en ;
  skos:definition "An action an agent (of a principal) performs to determine whether a digital object or set of data meets the requirements of a specific party."@en ;
  skos:related <urn:tig:concept:verification> .

<urn:tig:concept:vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vault"@en ;
  skos:altLabel "vaults"@en ;
  skos:definition "See: digital vault."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:vc> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vc"@en ;
  skos:altLabel "VC"@en ;
  skos:definition "See: verifiable credential."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:verifiable-credential-data-model-2-0> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-credential-data-model-2-0"@en ;
  skos:altLabel "VC Data Model 2.0"@en ;
  skos:altLabel "VCDM 2.0"@en ;
  skos:definition "The W3C data model for expressing verifiable credentials and verifiable presentations using common roles, properties, lifecycle semantics, and securing mechanisms."@en ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:data-integrity-proof> ;
  skos:related <urn:tig:concept:secured-verifiable-credential> ;
  skos:related <urn:tig:concept:bitstring-status-list> .

<urn:tig:concept:verifiable-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-credential"@en ;
  skos:altLabel "verifiable credential"@en ;
  skos:altLabel "verifiable credentials"@en ;
  skos:altLabel "VC"@en ;
  skos:altLabel "VCs"@en ;
  skos:definition "A cryptographically secured credential whose authenticity and integrity can be verified, including credentials represented using the W3C Verifiable Credentials Data Model, ISO mdoc, or SD-JWT VC profiles depending on the ecosystem profile."@en ;
  skos:related <urn:tig:concept:digital-credential> ;
  skos:related <urn:tig:concept:verifiable-credential-data-model-2-0> ;
  skos:related <urn:tig:concept:secured-verifiable-credential> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:bitstring-status-list> ;
  skos:related <urn:tig:concept:openid4vci> ;
  skos:related <urn:tig:concept:openid4vp> ;
  skos:related <urn:tig:concept:sd-jwt-vc> .

<urn:tig:concept:verifiable-data-registry> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-data-registry"@en ;
  skos:altLabel "verifiable data registry"@en ;
  skos:altLabel "verifiable data registries"@en ;
  skos:altLabel "VDR"@en ;
  skos:altLabel "VDRs"@en ;
  skos:definition "A registry that facilitates the creation, verification, updating, and/or deactivation of decentralized identifiers and DID documents. A verifiable data registry may also be used for other cryptographically-verifiable data structures such as verifiable credentials."@en ;
  skos:related <urn:tig:concept:authoritative-source> ;
  skos:related <urn:tig:concept:trust-registry> ;
  skos:related <urn:tig:concept:system-of-record> .

<urn:tig:concept:verifiable-data> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-data"@en ;
  skos:altLabel "verifiable data"@en ;
  skos:definition "Any digital data or object that is digitally signed in such a manner that it can be cryptographically verified."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:verifiable-identifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-identifier"@en ;
  skos:altLabel "verifiable identifier"@en ;
  skos:altLabel "verifiable identifiers"@en ;
  skos:altLabel "VID"@en ;
  skos:altLabel "VIDs"@en ;
  skos:definition "An identifier over which the controller can provide cryptographic proof of control. Each type of VID defines a specific means for discovering the public key, network endpoints, or other metadata necessary to prove control. Decentralized identifiers (DIDs) are a W3C standard for VIDs. VIDs are the cryptographically verifiable identifiers used in the ToIP stack."@en ;
  skos:related <urn:tig:concept:decentralized-identifier> ;
  skos:related <urn:tig:concept:autonomic-identifier> .

<urn:tig:concept:verifiable-message> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-message"@en ;
  skos:altLabel "verifiable message"@en ;
  skos:altLabel "verifiable messages"@en ;
  skos:altLabel "verifiable messaging"@en ;
  skos:definition "A message communicated as verifiable data by virtue of being digitally signed."@en ;
  skos:related <urn:tig:concept:toip-messages> .

<urn:tig:concept:verifiable-presentation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable-presentation"@en ;
  skos:altLabel "verifiable presentation"@en ;
  skos:altLabel "verifiable presentations"@en ;
  skos:altLabel "VP"@en ;
  skos:altLabel "VPs"@en ;
  skos:definition "A presentation with cryptographic proof or securing material that enables a verifier to check integrity, holder binding, or other presentation-specific verification requirements."@en ;
  skos:related <urn:tig:concept:presentation> ;
  skos:related <urn:tig:concept:vp-token> ;
  skos:related <urn:tig:concept:openid4vp> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:holder-binding> .

<urn:tig:concept:verifiable> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifiable"@en ;
  skos:altLabel "verifiability"@en ;
  skos:definition "In the context of digital communications infrastructure, the ability to determine the authenticity of a communication (e.g., sender, contents, claims, metadata, provenance), or the underlying sociotechnical infrastructure (e.g., governance, roles, policies, authorizations, certifications)."@en ;
  skos:related <urn:tig:concept:appraisable> ;
  skos:related <urn:tig:concept:digital-signature> .

<urn:tig:concept:verification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verification"@en ;
  skos:altLabel "verify"@en ;
  skos:altLabel "verifies"@en ;
  skos:altLabel "verified"@en ;
  skos:altLabel "verifying"@en ;
  skos:definition "An action an agent (of a principal) performs to determine the authenticity of a claim or other data object. Cryptographic verification uses cryptographic keys."@en ;
  skos:related <urn:tig:concept:validation> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:proof> ;
  skos:related <urn:tig:concept:cryptographic-verifiability> .

<urn:tig:concept:verifier> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "verifier"@en ;
  skos:altLabel "verifiers"@en ;
  skos:definition "A role an agent performs to verify one or more proofs of the claims in a digital credential or other verifiable data, and to evaluate whether the presented material satisfies applicable verification and policy criteria."@en ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:holder> ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:openid4vp> .

<urn:tig:concept:vid-relationship> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vid-relationship"@en ;
  skos:altLabel "VID relationship"@en ;
  skos:altLabel "VID relationships"@en ;
  skos:definition "The communications relationship formed between two VIDs using the ToIP Trust Spanning Protocol. A particular feature of this protocol is its ability to establish as many VID relationships as needed to establish different relationship contexts between the communicating entities."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:vid-to-vid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vid-to-vid"@en ;
  skos:altLabel "VID-to-VID"@en ;
  skos:altLabel "V2V"@en ;
  skos:definition "The specialized type of peer-to-peer communications enabled by the ToIP Trust Spanning Protocol. Each pair of VIDs creates a unique VID relationship."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:vid> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vid"@en ;
  skos:altLabel "VID"@en ;
  skos:definition "See ​​verifiable identifier."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:virtual-credential> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "virtual-credential"@en ;
  skos:altLabel "virtual credential"@en ;
  skos:definition "Digital representations of claims or identity attributes, often used in online environments."@en ;
  skos:related <urn:tig:concept:credential> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:issuance> ;
  skos:related <urn:tig:concept:verifiable-credential> .

<urn:tig:concept:virtual-vault> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "virtual-vault"@en ;
  skos:altLabel "virtual vault"@en ;
  skos:altLabel "virtual vaults"@en ;
  skos:definition "A digital vault enclosed inside another digital vault by virtue of having its own verifiable identifier (VID) and its own set of encryption keys that are separate from those used to unlock the enclosing vault."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:voice-over-ip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "voice-over-ip"@en ;
  skos:altLabel "Voice over IP"@en ;
  skos:altLabel "VoIP"@en ;
  skos:definition "Voice over Internet Protocol (VoIP), also called IP telephony, is a method and group of technologies for voice calls for the delivery of voice communication sessions over Internet Protocol (IP) networks, such as the Internet."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:voip> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "voip"@en ;
  skos:altLabel "VoIP"@en ;
  skos:definition "See: Voice over IP."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:vp-token> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "vp-token"@en ;
  skos:altLabel "VP Token"@en ;
  skos:altLabel "vp_token"@en ;
  skos:definition "An OpenID4VP response artifact containing one or more presentations returned to a verifier in response to an authorization request."@en ;
  skos:related <urn:tig:concept:openid4vp> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:presentation> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:w3c-verifiable-credentials-data-model-specification> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "w3c-verifiable-credentials-data-model-specification"@en ;
  skos:altLabel "W3C Verifiable Credentials Data Model Specification"@en ;
  skos:definition "A W3C Recommendation defining the standard Verifiable Credentials Data Model. The current standards-linked anchor for new work is Verifiable Credentials Data Model v2.0."@en ;
  skos:related <urn:tig:concept:verifiable-credential-data-model-2-0> ;
  skos:related <urn:tig:concept:verifiable-credential> ;
  skos:related <urn:tig:concept:verifiable-presentation> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:holder> ;
  skos:related <urn:tig:concept:verifier> .

<urn:tig:concept:wallet-attestation> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "wallet-attestation"@en ;
  skos:altLabel "wallet attestation"@en ;
  skos:definition "Evidence about a wallet instance, wallet provider, or wallet capability that can be used by issuers, verifiers, or governance frameworks to make reliance decisions."@en ;
  skos:related <urn:tig:concept:digital-wallet> ;
  skos:related <urn:tig:concept:attestation> ;
  skos:related <urn:tig:concept:issuer> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:assurance-level> .

<urn:tig:concept:wallet-engine> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "wallet-engine"@en ;
  skos:altLabel "wallet engine"@en ;
  skos:altLabel "wallet engines"@en ;
  skos:definition "The set of software components that form the core of a digital wallet, but which by themselves are not sufficient to deliver a fully functional wallet for use by a digital agent (of a principal). A wallet engine is to a digital wallet what a browser engine is to a web browser."@en ;
  skos:related <urn:tig:concept:delegation> ;
  skos:related <urn:tig:concept:delegator> ;
  skos:related <urn:tig:concept:delegatee> ;
  skos:related <urn:tig:concept:authorization> .

<urn:tig:concept:wallet> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "wallet"@en ;
  skos:altLabel "wallets"@en ;
  skos:definition "See: digital wallet."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:witness> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "witness"@en ;
  skos:altLabel "witnesses"@en ;
  skos:definition "A computer system that receives, verifies, and stores proofs of key events for a verifiable identifier (especially an autonomic identifier). Each witness controls its own verifiable identifier used to sign key event messages stored by the witness. A witness may use any suitable computer system or database architecture, including a file, centralized database, distributed database, distributed ledger, or blockchain."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:zero-knowledge-proof> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "zero-knowledge-proof"@en ;
  skos:altLabel "zero-knowledge proof"@en ;
  skos:altLabel "zero-knowledge proofs"@en ;
  skos:altLabel "ZKP"@en ;
  skos:altLabel "ZKPs"@en ;
  skos:definition "A specific kind of cryptographic proof that proves facts about data to a verifier without revealing the underlying data itself. A common example is proving that a person is over or under a specific age without revealing the person’s exact birthdate."@en ;
  skos:related <urn:tig:concept:verification> ;
  skos:related <urn:tig:concept:verifier> ;
  skos:related <urn:tig:concept:relying-party> ;
  skos:related <urn:tig:concept:trust-decision> .

<urn:tig:concept:zero-knowledge-service-provider> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "zero-knowledge-service-provider"@en ;
  skos:altLabel "zero-knowledge service provider"@en ;
  skos:altLabel "zero-knowledge service providers"@en ;
  skos:definition "The provider of a zero-knowledge service that hosts encrypted data on behalf of the principal but does not have access to the private keys in order to be able to decrypt it."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:zero-knowledge-service> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "zero-knowledge-service"@en ;
  skos:altLabel "zero-knowledge service"@en ;
  skos:altLabel "zero-knowledge services"@en ;
  skos:definition "In cloud computing, the term “zero-knowledge” refers to an online service that stores, transfers or manipulates data in a way that maintains a high level of confidentiality, where the data is only accessible to the data's owner (the client), and not to the service provider. This is achieved by encrypting the raw data at the client's side or end-to-end (in case there is more than one client), without disclosing the password to the service provider. This means that neither the service provider, nor any third party that might intercept the data, can decrypt and access the data without prior permission, allowing the client a higher degree of privacy than would otherwise be possible. In addition, zero-knowledge services often strive to hold as little metadata as possible, holding only that data that is functionally needed by the service."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .

<urn:tig:concept:zero-trust-architecture> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "zero-trust-architecture"@en ;
  skos:altLabel "zero-trust architecture"@en ;
  skos:altLabel "zero-trust architectures"@en ;
  skos:altLabel "ZTA"@en ;
  skos:altLabel "ZTAs"@en ;
  skos:definition "A network security architecture based on the core design principle “never trust, always verify”, so that all actors are denied access to resources pending verification."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> ;
  skos:related <urn:tig:concept:trust> ;
  skos:related <urn:tig:concept:trust-registry> .

<urn:tig:concept:zkp> a skos:Concept ;
  skos:inScheme <urn:tig:scheme:core> ;
  skos:prefLabel "zkp"@en ;
  skos:altLabel "ZKP"@en ;
  skos:definition "See: zero-knowledge proof."@en ;
  skos:related <urn:tig:concept:glossary> ;
  skos:related <urn:tig:concept:definition> .
